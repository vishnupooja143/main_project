def _pcm_to_wav(pcm, sr: int) -> bytes:
    import io, wave
    buf = io.BytesIO()
    with wave.open(buf, "wb") as w:
        w.setnchannels(1); w.setsampwidth(2); w.setframerate(sr)
        w.writeframes(np.asarray(pcm, dtype=np.int16).tobytes())
    return buf.getvalue()


async def detect_audio_language(pcm, sr: int):
    """(language_code, probability or None) for one final's audio, or (None, None)."""
    try:
        form = aiohttp.FormData()
        form.add_field("file", _pcm_to_wav(pcm, sr), filename="utt.wav", content_type="audio/wav")
        form.add_field("model", "saaras:v3")
        form.add_field("mode", "transcribe")
        form.add_field("language_code", "unknown")
        http = await get_http_session()
        async with http.post(
                _LANG_CHECK_URL, data=form, headers={"api-subscription-key": SARVAM_API_KEY},
                timeout=aiohttp.ClientTimeout(total=LANG_CHECK_WAIT_S + 1.0)) as r:
            if r.status != 200:
                log.debug("lang check HTTP %s", r.status)
                return None, None
            j = await r.json()
        prob = j.get("language_probability")
        return j.get("language_code"), (float(prob) if prob is not None else None)
    except Exception as e:
        log.debug("lang check failed: %s", e)
        return None, None
