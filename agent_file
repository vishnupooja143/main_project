def strip_ai_mention(reply: str) -> str:
    """Drop sentences where Avni calls herself an AI / bot. Returns the reply
    unchanged if nothing (or too little) would be left."""
    if not reply or not _AI_SELF_RE.search(reply):
        return reply
    sents = [s for s in _SENTENCE_SPLIT_RE.split(reply.strip()) if s.strip()]
    kept = [s for s in sents if not _AI_SELF_RE.search(s)]
