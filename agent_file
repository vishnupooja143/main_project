def _number_to_words(n: int) -> str:
    ones = ["", "one", "two", "three", "four", "five", "six", "seven",
            "eight", "nine", "ten", "eleven", "twelve", "thirteen",
            "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen"]
    tens = ["", "", "twenty", "thirty", "forty", "fifty",
            "sixty", "seventy", "eighty", "ninety"]
    if n < 20:
        return ones[n]
    if n < 100:
        return tens[n // 10] + (" " + ones[n % 10] if n % 10 else "")
    if n < 1000:
        return ones[n // 100] + " hundred" + (
            " " + _number_to_words(n % 100) if n % 100 else "")
    if n < 100000:
        return _number_to_words(n // 1000) + " thousand" + (
            " " + _number_to_words(n % 1000) if n % 1000 else "")
    if n < 10000000:
        return _number_to_words(n // 100000) + " lakh" + (
            " " + _number_to_words(n % 100000) if n % 100000 else "")
    return str(n)


def _replace_loanwords(text: str, lang_code: str) -> str:
    loanwords = PHONETIC_LOANWORDS.get(lang_code, {})
    for eng in sorted(loanwords, key=len, reverse=True):
        text = re.compile(r"\b" + re.escape(eng) + r"\b", re.IGNORECASE).sub(
            loanwords[eng], text
        )
    return text


def normalize_for_tts(text: str, lang_code: str) -> str:
    if not text or not text.strip():
        return text
    # Strip digit separators
    text = re.sub(r"(?<=\d),(?=\d)", "", text)
    # Percent
    pw = _PERCENT_WORD.get(lang_code, "percent")
    text = re.sub(r"(\d+)\s*%", lambda m: f"{_number_to_words(int(m.group(1)))} {pw}", text)
    # Plain numbers
    text = re.sub(r"\b(\d+)\b",
                  lambda m: _number_to_words(int(m.group(1))) if int(m.group(1)) <= 10_000_000 else m.group(0),
                  text)
    if lang_code != "en-IN":
        text = _replace_loanwords(text, lang_code)
    for sym, word in _SYMBOL_WORDS.get(lang_code, _SYMBOL_WORDS["en-IN"]).items():
        text = text.replace(sym, word)
    return re.sub(r"\s+", " ", text).strip()


# Markdown / emoji sanitizer — Sarvam reads them aloud otherwise
_TTS_EMOJI_RE = re.compile(
    r"[\U0001F300-\U0001FAFF\U00002600-\U000027BF\U0001F1E6-\U0001F1FF"
    r"←-⇿⬀-⯿]+"
)
_TTS_STRIP_RE = re.compile(r"[*#`_~^<>\[\]\{\}|\\]")

# Strips a leaked private instruction at the START of a reply — a bracketed note
# like "[Your goal for this reply: …]" or a label like "FOCUS:" / "GOAL:".
_LEADING_NOISE_RE = re.compile(
    r"^\s*(?:\[[^\]]*\]\s*|(?:focus|goal|your goal[^:]*|internal note|note)\s*:\s*)+",
    re.IGNORECASE,
)


# Gendered honorifics to strip — the bot doesn't know the caller's gender.
# Covers English + the 6 supported languages. "जी" alone is kept (it's a neutral
# polite particle); only sir/madam-style titles are removed.
_HONORIFIC_RE = re.compile(
    r"(?i)\b(?:sir|madam|ma'?am|mam)\b"
    r"|सर\s*जी|जी\s*सर|\bसर\b|\bमैडम\b|\bमैम\b|\bसाहब\b|\bसाहिबा\b"
    r"|ಸರ್|ಮೇಡಂ|సర్|మేడం|சார்|மேடம்|സാർ|മാഡം"
)


def strip_honorifics(text: str) -> str:
    if not text:
        return text
    out = _HONORIFIC_RE.sub("", text)
    # Clean up the comma/space debris a removed "..., sir." leaves behind.
    out = re.sub(r"\s*,\s*,", ",", out)
    out = re.sub(r"\s+([,.?!।॥])", r"\1", out)
    out = re.sub(r"^[\s,]+", "", out)
    return re.sub(r"\s{2,}", " ", out).strip()


# Over-casual interjections a Tally rep should never use on a customer call.
# "अरे नहीं" → "नहीं", "Oh wow, ..." → "...", "yaar"/"oye" dropped. Matches the
# word only at the start of a clause so real words aren't harmed.
_INFORMAL_RE = re.compile(
    r"(?i)(?:^|(?<=[,.!?।]))\s*"
    r"(?:o+h+\s*[,]?\s*wow+|wow+|o+h+|arre+|arey+|are+\s|yaar+|yar+|oye+|boss|"
    r"अरे+|अरे\s*यार|यार|ओए|ओ+ह+|वाओ+|वाह+|अच्छा\s*वाह)"
    r"[\s,]*",
)


def strip_informal(text: str) -> str:
    """Drop casual interjections (arre, oh wow, yaar, oye) — keep it professional."""
    if not text:
        return text
    out = _INFORMAL_RE.sub(" ", text)
    out = re.sub(r"\s+([,.?!।॥])", r"\1", out)
    out = re.sub(r"^[\s,]+", "", out)
    out = re.sub(r"\s{2,}", " ", out).strip()
    # Recapitalise if we stripped a leading interjection from an English sentence.
    return re.sub(r"^([a-z])", lambda m: m.group(1).upper(), out)


def sanitize_for_speech(text: str) -> str:
    if not text:
        return text
    text = strip_honorifics(text)
    text = strip_informal(text)
    text = _TTS_EMOJI_RE.sub("", text)
    text = _TTS_STRIP_RE.sub("", text)
    text = text.replace("—", ", ").replace("–", ", ").replace("--", ", ")
    text = re.sub(r"\.{2,}", ",", text)
    text = re.sub(r"\s+([,.?!])", r"\1", text)
    return re.sub(r"\s{2,}", " ", text).strip()


