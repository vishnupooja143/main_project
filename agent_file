def is_reply_to_bot(text: str) -> bool:
    """True for a short utterance that is only a reply aimed at the bot: did not
    understand / say again / what? / yes / no / okay / transfer me."""
    t = (text or "").strip()
    if not t or len(t.split()) > BOT_REPLY_MAX_WORDS or not _BOT_REPLY_RE.search(t):
        return False
    rest = _BOT_REPLY_RE.sub(" ", t)
    toks = [x for x in _TOKEN_SPLIT_RE.split(rest.lower()) if x]
    return sum(1 for x in toks if x not in _BOT_REPLY_FILLER) <= 1


