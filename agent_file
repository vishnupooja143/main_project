def reply_script_is_compliant(text: str, lang_code: str) -> bool:
    if lang_code == "en-IN" and text:
        # Any Indic script in an English reply (…41765 answered in Gujarati).
        indic = sum(1 for ch in text if 0x0900 <= ord(ch) <= 0x0DFF)
        return indic <= 3
    rng = _SCRIPT_RANGES.get(lang_code)
    if not rng or not text:
        return True
    native = sum(1 for ch in text if rng[0] <= ord(ch) <= rng[1])
    latin  = sum(1 for ch in text if ch.isascii() and ch.isalpha())
    if native == 0 and latin > 8:
        return False
    return native >= latin * 0.4


def normalize_stt_lang(code: Optional[str]) -> Optional[str]:
    if not code:
        return None
    code = code.strip()
    if code in ALLOWED_LANGUAGE_CODES:
        return code
    prefix = code.split("-")[0].lower()
    for allowed in ALLOWED_LANGUAGES:
        if allowed.split("-")[0].lower() == prefix:
            return allowed
    return None


