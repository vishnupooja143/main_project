_FLUSH_RE = re.compile(r"[.!?।॥,;:]+[\s\"')\]]*")
# After the first chunk, flush only on sentence ends: sending every comma-clause
# as its own TTS request resets intonation each time and sounds robotic (worst in
# kn/te/ta/ml/en). The first chunk still breaks at a comma to keep latency low.
_SENT_FLUSH_RE = re.compile(r"[.!?।॥]+[\s\"')\]]*")


