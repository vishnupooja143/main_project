def detect_north_indian_bridge(text: str, stt_code: Optional[str]) -> Optional[str]:
    """Hindi name of a North-Indian language the caller is speaking or naming
    (Punjabi, Marathi, Gujarati, Urdu, …), else None."""
    # 1) STT-reported language code
    if stt_code:
        prefix = stt_code.strip().split("-")[0].lower()
        if prefix in _NORTH_INDIAN_HINDI_NAME:
            return _NORTH_INDIAN_HINDI_NAME[prefix]
    # 2) native script actually present in the transcript
    for code, (lo, hi) in _NI_SCRIPT_RANGES.items():
        if any(lo <= ord(ch) <= hi for ch in (text or "")):
            return _NORTH_INDIAN_HINDI_NAME.get(code)
    # 3) language named in the text
    t = (text or "").lower()
    for code, kws in _NI_NAME_KEYWORDS.items():
        if any(k.lower() in t for k in kws):
            return _NORTH_INDIAN_HINDI_NAME.get(code)
    return None


def detect_named_language(text: str) -> Optional[str]:
    t = text.lower()
    for code, aliases in _LANG_ALIAS_MAP.items():
        if any(a in t for a in aliases):
            return code
    return None


# English negations come BEFORE the word ("not English", "cannot understand English").
_ENG_NEG = {"not", "no", "cannot", "cant", "can't", "cn't", "dont", "don't", "doesn't",
            "won't", "never", "neither",
            # [LANG FIX 12-Oct] the same words written in Devanagari by a Hindi-locked STT
            "डोंट", "डॉन्ट", "डोन्ट", "नॉट", "नो", "कांट", "कान्ट", "कैंट", "कैन्ट",
            "नेवर", "डजंट", "डज़ंट", "कैननॉट", "वोंट"}
# The same, as hi-IN STT writes them ("आई डोंट नो हिंदी … स्पीक इन इंग्लिश").
# Matched on the token minus punctuation: [^\w] would strip the vowel signs.
_ENG_NEG_DEVA = {"नॉट", "नोट", "डोंट", "डॉन्ट", "कांट", "कैंट", "कैन्ट", "नेवर", "डजंट", "वोंट"}
_TOK_PUNCT = ".,!?।;:\"'()"
# Indian negations come AFTER the word ("Hindi nahi", "हिंदी नहीं", "English beda").
_POST_NEG = ("nahi", "nahin", "नहीं", "mat", "मत", "beda", "ಬೇಡ", "vaddu",
             "venda", "வேண்டாம்", "illa", "इल्ला", "नको")


def _tok_lang(tok_lower: str, tok_raw: str, weak: bool = False) -> Optional[str]:
    """Language code if this token contains a language name, else None.
    weak=True also matches _WEAK_LANG_ALIASES (caller must then need a cue)."""
    for code, aliases in _LANG_ALIAS_MAP.items():
        for a in aliases:
            if (a in tok_lower) if a.isascii() else (a in tok_raw):
                return code
    if weak:
        for code, pats in _WEAK_LANG_ALIASES.items():
            if any(re.search(p, tok_raw, re.I) for p in pats):
                return code
    return None


def detect_explicit_language_switch(text: str) -> Optional[str]:
    """Language the caller wants to switch TO — negation-aware, so
    'speak in Kannada, I cannot understand English' returns Kannada, not English.
    English negations sit before the language, Indian ones after."""
    if not text:
        return None
    t = text.lower()
    toks_l = re.split(r"\s+", t)
    toks_r = re.split(r"\s+", text)
    clean  = [re.sub(r"[\s,.।!?;:\"()\-]", "", x) for x in toks_l]   # [LANG FIX] keep vowel signs

    langs = [(i, _tok_lang(toks_l[i], toks_r[i]))
             for i in range(len(toks_l))]
    langs = [(i, c) for i, c in langs if c]
    weak_only = False
    if not langs and has_switch_cue(text):
        # STT-garbled names that are also ordinary words (കണ്ണട, Canada) count
        # only together with a speak / talk word
        langs = [(i, _tok_lang(toks_l[i], toks_r[i], weak=True))
                 for i in range(len(toks_l))]
        langs = [(i, c) for i, c in langs if c]
        weak_only = bool(langs)
    if not langs:
        return None

    wanted = []
    for i, code in langs:
        eng_neg  = (any(w in _ENG_NEG for w in clean[max(0, i - 2): i])
                    or any(w.strip(_TOK_PUNCT) in _ENG_NEG_DEVA
                           for w in toks_r[max(0, i - 2): i]))
        # [LANG FIX 12-Oct] whole words only: "mat" (मत) used to match inside
        # "matladandi" (Telugu "speak"), so "Telugu lo matladandi" counted as "NOT Telugu".
        nxt      = [re.sub(r"[\s,.।!?;:\"()\-]", "", x).lower() for x in toks_r[i + 1: i + 3]]
        me       = re.sub(r"[\s,.।!?;:\"()\-]", "", toks_r[i]).lower()
        post_neg = (any(pn in nxt for pn in _POST_NEG)
                    or any(me.endswith(pn) for pn in _POST_NEG if len(pn) >= 4))   # "हिंदीनहीं"
        if not (eng_neg or post_neg) and code not in wanted:
            wanted.append(code)
    if not wanted:
        return None

    # "इंग्लिश" inside a Hindi sentence is often just a word ("इंग्लिश मीडियम",
    # "बिल इंग्लिश में बनता है"): native-script English needs a short answer or
    # a speak/talk word — "में" alone is not enough.
    if wanted[0] == "en-IN" and not any(a in t for a in _LANG_ALIAS_MAP["en-IN"] if a.isascii()):
        if len(t.split()) <= 4 or any(w in t for w in _EN_SWITCH_CUES):
            return "en-IN"
        return None

    # Require a switch signal so a passing mention doesn't flip the call.
    native_named = not weak_only and any(
        (not a.isascii()) and a in text
        for c in wanted for a in _LANG_ALIAS_MAP.get(c, [])
    )
    has_signal = has_switch_cue(text) or native_named or len(langs) >= 2
    if not has_signal:
        return None
    return wanted[0]


_SWITCH_CUES = ("switch", "change", "speak", "talk", "continue", "prefer", "comfortable",
                "want", "understand", "बात", "बोल", "समझ", "मे", "में",
                "ಮಾತಾಡಿ", "ಮಾತನಾಡಿ", "ಮಾತಾಡ", "ಮಾತನಾಡ", "పెట్టు", "మాట్లాడ", "பேசு", "பேச",
                "സംസാരി",
                # "speak / talk" as STT writes the English word in each script
                "स्पीक", "टॉक", "ಸ್ಪೀಕ್", "స్పీక్", "ஸ்பீக்", "സ്പീക്ക്", "ടോക്ക്")


_EN_SWITCH_CUES = ("speak", "talk", "बात", "बोल", "समझ", "स्पीक", "टॉक",
                   "ಮಾತಾಡಿ", "ಮಾತನಾಡಿ", "பேசு", "మాట్లాడ", "സംസാരി")


def has_switch_cue(text: str) -> bool:
    """A short answer ("Kannada please") or a speak/talk/prefer word."""
    t = (text or "").lower()
    return len(t.split()) <= 4 or any(w in t for w in _SWITCH_CUES)


def detect_language_choice(text: str) -> Optional[str]:
    """Supported language the caller asked for, negation-aware. Falls back to
    a plain mention for short answers ("I am okay with Tamil")."""
    choice = detect_explicit_language_switch(text)
    if choice:
        return choice
    t = (text or "").lower()
    words = {re.sub(r"[\s,.।!?;:\"()\-]", "", w) for w in t.split()}    # [LANG FIX] whole words
    if len(t.split()) <= 6 and not (words & _ENG_NEG) \
            and not (words & set(_POST_NEG)) \
            and not any(w.endswith(pn) for w in words for pn in _POST_NEG if len(pn) >= 4):
        return detect_named_language(text)
    return None


