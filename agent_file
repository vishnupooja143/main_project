    # ── Language helpers ────────────────────────────────────────────────────

    def _set_tts_language(self, lang_code: str) -> None:
        self._turn_tts_lang = lang_code
        if not self._tts_instance:
            return
        pace = TTS_PACE_BY_LANG.get(lang_code, TTS_PACE)
        for kwargs in (
            {"target_language_code": lang_code, "pace": pace},
            {"target_language_code": lang_code},
        ):
            try:
                self._tts_instance.update_options(**kwargs)
                return
            except TypeError:
                continue
            except Exception as e:
                log.warning("TTS options update failed: %s", e)
                return

    async def _apply_language(self, lang_code: str) -> None:
        self._locked_lang     = lang_code
        self._language_locked = True
        self._turn_tts_lang   = lang_code
        # Record the exact moment we locked — used by the SpeakerLock
        # enrollment-gate time-pressure fallback in on_user_turn_completed().
        self._language_locked_at = time_module.monotonic()
        try:
            await self.update_instructions(build_system_prompt(locked_lang=lang_code))
        except Exception as e:
            log.error("update_instructions failed: %s", e)
        self._set_tts_language(lang_code)
        log.info("🔒 Language locked: %s", lang_code)

    async def _update_stt_language(self, lang_code: str, source: Optional[str] = None) -> None:
        inst = self._stt_instance
        if inst is None:
            return
        # sarvam.STT itself has no update_options() — only its live
        # SpeechStream does, and it REQUIRES model= too. Both mistakes were
        # silent, so the STT never locked and kept auto-detecting every clip:
        # noise in a Hindi call came back as Bengali / Gujarati / Kannada text
        # (calls …41765, …41767, …42408).
        # Detected / default English stays on auto-detect so a Hindi /
        # North-Indian caller who opened with "Hello" can still be recognised
        # and moved to Hindi. But when the caller CHOSE English ("English" to the
        # language question), lock STT to en-IN like any other language — on
        # auto-detect their English was transcribed as Hindi/other scripts for
        # the rest of the call. Saying "Hindi" / "Tamil mein baat karo" later
        # still switches: those names match in romanised English text too.
        stt_lang = ("unknown" if (lang_code == "en-IN" and source not in ("explicit", "confirmed"))
                    or source == "default"          # [LANG FIX 12-Oct] a guess: keep auto-detect
                    else lang_code)
        # NEVER call SpeechStream.update_options() mid-call: in this plugin
        # version it requests a reconnect, but _run_connection() just returns
        # and the stream never reconnects — the bot went deaf right after the
        # language lock (calls …42921, …42930). Instead set the base options and
        # have stt_node close the live stream and open a FRESH one, which reads
        # them. Without the swap the live stream stayed on auto-detect for the
        # whole call: a Malayalam caller came back as Kannada / Tamil (…46977).
        try:
            if inst._opts.language == stt_lang:
                return
            inst._opts.language = stt_lang
        except Exception as e:
            log.warning("STT language update failed: %s", e)
            return
        log.info("STT language -> %s (swapping live stream)", stt_lang)
        self._stt_swap_event.set()

    def _is_noise_segment(self, text: str, lang: Optional[str]) -> bool:
        """A short clip auto-detected in a language nobody on this call speaks —
        wind / line noise that Sarvam rendered as Bengali, Tamil, Gujarati, …"""
        code = (lang or "").split("-")[0].lower()
        locked = self._locked_lang.split("-")[0]
        if not code or code in (locked, "en", "hi"):
            return False
        if names_north_indian_language(text):
            return False
        # "ಕೇಳ್ಕಮ್ಮೋ, ಹಲೋ" (kn) was a Malayalam caller checking the line during
        # dead air — a hello in any script is the caller, never noise (…46977).
        if any(tok in _HELLO_TOKENS for tok in _TOKEN_SPLIT_RE.split(text.lower()) if tok):
            return False
        # Devanagari in a Hindi call is real speech ("नाही" = no, …43669).
        if locked == "hi" and any(0x0900 <= ord(ch) <= 0x097F for ch in text):
            return False
        return len(text.split()) <= 2

    def _decide_opening_language(self, query: str):
        """Language from a reply before the lock.

        Returns (lang_code, source, unsupported_name), or (None, None, None)
        when the reply doesn't reveal it ("yes", "hello", "hmm", noise).
        Priority: a supported language they name → an unsupported one they
        name (Hindi) → the language of a clear sentence.
        """
        _vl = getattr(self, "_voice_lock", None)
        _tv = _vl.tv_on_line() if _vl is not None and hasattr(_vl, "tv_on_line") else None
        # [TV HOLD 22-Oct] with a TV on, a language name inside a long news line is
        # the TV's, not the caller's choice ("తెలుగు స్థానిక సంస్థల విషయంలో" locked the
        # call to Telugu, …59283). Then only a short answer or "speak in …" counts.
        named_ok = (not _tv) or len(query.split()) <= 3 or has_switch_cue(query)
        choice = detect_language_choice(query) if named_ok else None
        if choice is None and named_ok and _GARBLED_TELUGU_RE.search(query or "") \
                and len(query.split()) <= 8:
            # [02-Nov …65895] "Telugu" auto-detected as Hindi: "थे लोग।", "थे ले गो, थे ले गो"
            log.info("🗣️ %r read as 'Telugu' (STT wrote the name in Hindi script)", query[:40])
            choice = "te-IN"
        if choice in ALLOWED_LANGUAGE_CODES:
            return choice, "explicit", None
        if named_ok and names_north_indian_language(query):
            return "hi-IN", "explicit", detect_north_indian_bridge(query, None)
        # [TV HOLD 19-Oct] a TV / radio talking non-stop on the line: its words are
        # not the caller's language (…58326: Marathi TV news locked the call to
        # Hindi). Only a language the caller NAMES (above) counts until it stops.
        if _tv:
            log.info("📺 language not taken from this reply — TV / radio on the line (%s)", _tv)
            return None, None, None
        if is_language_evidence(query):
            ni_name = detect_north_indian_bridge(query, self.last_detected_stt_lang)
            if ni_name:
                # [LANG FIX 17-Oct] a 2-word clip auto-detected as Bengali / Gujarati
                # ("কি বলছে?") is not proof: the call was bridged to Hindi, STT was locked
                # to Hindi and the caller's "I said English" came out as "आई सेड हिंदी"
                # (…58134). Short → unclear (the language question is asked again).
                if len(query.split()) < 3:
                    return None, None, None
                # [30-Oct] the caller did not NAME it: STT only guessed Gujarati for
                # "Okay" ("હવે સ્પોક ના નાખો" + "Hello", …63698), the call went to Hindi
                # with "sorry, I don't speak Gujarati" and the caller had to say
                # "Telugu". Ask the 2nd language question (it names the choices) first.
                if not getattr(self, "_lang_question2_asked", False):
                    log.info("🗣️ %s only guessed by STT from %r — asking the language again",
                             ni_name, query[:40])
                    return None, None, None
                return "hi-IN", "detected", ni_name
            stt_lang = normalize_stt_lang(self.last_detected_stt_lang)
            if stt_lang:
                return stt_lang, "detected", None
        return None, None, None

    def _ask_language_question(self, line: str = LANGUAGE_QUESTION) -> None:
        """Speak the language question from code (the LLM rewrote it in …58147)."""
        old = self._lang_q_handle
        if old is not None and not old.done():
            with contextlib.suppress(Exception):
                old.interrupt()
        self._lang_question_asked = True
        self._lang_q_tries += 1
        self._set_tts_language(DEFAULT_LANGUAGE)
        try:
            self._lang_q_handle = self._session.say(line, allow_interruptions=True)
        except Exception as e:
            log.warning("Language question failed: %s", e)
            self._lang_q_handle = None

    def _lang_question_heard(self) -> bool:
        """The language question finished playing without being cut off."""
        h = self._lang_q_handle
        if h is None:
            return self._lang_question_asked      # old path / unknown → assume heard
        return bool(h.done() and not h.interrupted)

    def _unclear_answer_language(self, query: str) -> str:
        """No language named even after the question was heard. Plain English
        words ("Yes", "Okay") that STT heard as English → English; anything
        else → Hindi (the default)."""
        if (normalize_stt_lang(self.last_detected_stt_lang) == "en-IN"
                and query and re.fullmatch(r"[A-Za-z\s.,!?'-]+", query)):
            return "en-IN"
        return "hi-IN"

    def _ask_end_confirm(self, turn_ctx, why: str, query: str) -> bool:
        """[END CONFIRM 29-Oct] Ask once "should I end the call?" instead of closing on
        a turn the voice lock has not verified. False = already asked once (go on)."""
        if getattr(self, "_end_confirm_asked", False):
            return False
        self._end_confirm_asked = True
        self._end_confirm_pending = True
        lang = self._locked_lang if self._language_locked else DEFAULT_LANGUAGE
        line = END_CONFIRM_LINES.get(lang, END_CONFIRM_LINES["en-IN"])
        log.info("🛑 not closing yet (%s) — the caller's voice is not verified; asking first: %r",
                 why, query[:60])
        self._set_tts_language(lang)
        self._verbatim_turn = True
        self._fallback_line = line
        self._add_directive(turn_ctx, role="system", content=(
            f"[Your goal for this reply: say ONLY this line and nothing else: \"{line}\"]\n"
            "Write ONLY the words you speak. Do not repeat this note."
        ))
        return True

    def _voice_unverified(self) -> bool:
        """[29-Oct] The voice lock exists but has not locked on the caller yet: any
        turn may come from a person beside them, a TV or a video."""
        vl = getattr(self, "_voice_lock", None)
        if vl is None:
            return False
        # [02-Nov …65862] a new lock is on probation until a turn clearly matches it:
        # the man beside the caller talked right after the lock and was answered
        return not getattr(vl, "locked", True) or not getattr(vl, "_proven", True)

    def _anchor_turn(self, why: str) -> None:
        """[ANCHOR 29-Oct] Tell the voice lock this turn surely came from the caller."""
        vl = getattr(self, "_voice_lock", None)
        if vl is not None and hasattr(vl, "note_anchor") and self._voice_unverified():
            with contextlib.suppress(Exception):
                vl.note_anchor(why)

    async def _lock_language(self, lang_code: str, source: str) -> None:
        if source == "explicit":
            self._anchor_turn("named the language")       # [ANCHOR 29-Oct]
        self._lang_source = source
        if lang_code != self._locked_lang or not self._language_locked:
            await self._apply_language(lang_code)
        # Always (idempotent): "English please" on a call already detected as
        # English must still move STT off auto-detect.
        await self._update_stt_language(lang_code, source)
        log.info("🗣️ Language %s (%s)", lang_code, source)

    async def _unlock_language(self) -> None:
        """Undo a lock that was only DETECTED and turned out wrong: back to the
        opening state, STT on auto-detect, so the next reply decides afresh."""
        log.info("🔓 Language unlocked (was %s, %s)", self._locked_lang, self._lang_source)
        self._language_locked = False
        self._lang_source     = None
        try:
            await self.update_instructions(build_system_prompt())
        except Exception as e:
            log.error("update_instructions failed: %s", e)
        # en-IN without "explicit" = STT auto-detect (see _update_stt_language).
        await self._update_stt_language("en-IN")

    def _drop_noise_segments(self, query: str, new_message) -> str:
        segs, self._turn_segments = self._turn_segments, []
        if not self._language_locked or not segs:
            return query
        kept = [t for t, lg in segs if not self._is_noise_segment(t, lg)]
        if len(kept) == len(segs):
            return query
        if not kept:
            # Whole turn looks "off-language". On a locked call that is far more
            # likely a short real answer mis-detected (ta/gu for Kannada
            # "illa"/"haa") than noise. Dropping it leaves the caller in dead air.
            log.info("🔇 all segments off-language — keeping them as the answer: %r",
                    [f"{t} ({lg})" for t, lg in segs])
            return query
        log.info("🔇 dropped off-language noise: %r",
                [f"{t} ({lg})" for t, lg in segs if self._is_noise_segment(t, lg)])
        cleaned = " ".join(kept).strip()
        with contextlib.suppress(Exception):
            new_message.content = [cleaned]
        return cleaned

    # ── Pipeline nodes ──────────────────────────────────────────────────────

    @staticmethod
    def _audio_input_started_at(activity) -> float:
        """Same reference point LiveKit's default stt_node uses for start_time_offset."""
        ar = activity._audio_recognition
        if ar is not None and ar._input_started_at is not None:
            return ar._input_started_at
        sess = activity.session
        if sess._recorder_io and sess._recorder_io.recording_started_at:
            return sess._recorder_io.recording_started_at
        return sess._started_at or time_module.time()

    # ── [SPEAKER LOCK] helpers ────────────────────────────────────────────
    def _sil_should_send(self, f) -> bool:
        """[SILENCE SKIP] False = a pure-silence frame Sarvam does not need (billed)."""
        try:
            dur = f.samples_per_channel / float(f.sample_rate)
            silent = not np.any(np.frombuffer(f.data, dtype=np.int16))
        except Exception:
            return True
        now = time_module.monotonic()
        if not silent:
            # after a skipped stretch, give Sarvam 0.2 s of silence before the first
            # sound so its VAD hears the start of the word (see _forward)
            self._sil_lead = getattr(self, "_sil_skipping", False)
            self._sil_skipping = False
            self._sil_run = 0.0
            self._sil_last_sent = now
            return True
        self._sil_run = getattr(self, "_sil_run", 0.0) + dur
        if self._sil_run <= SILENCE_TAIL_S:
            self._sil_last_sent = now
            return True
        if now - getattr(self, "_sil_last_sent", 0.0) >= SILENCE_KEEPALIVE_S:
            self._sil_last_sent = now
            return True                       # keep-alive
        self._sil_saved = getattr(self, "_sil_saved", 0.0) + dur
        self._sil_skipping = True
        return False

    def _noise_words(self, lock, text: str, speaking: bool) -> bool:
        """[NOISE WORDS] True = drop this final: a few words with no voice in their audio."""
        if NOISE_WORDS == "off" or speaking or getattr(lock, "bot_speaking", False):
            return False
        with contextlib.suppress(Exception):
            # words said over the bot (an interruption) are not in the bot-silent audio
            if (hasattr(lock, "loud_barge_recent") and lock.loud_barge_recent(3.0)) or \
                    (hasattr(lock, "customer_active") and lock.customer_active(2.5)):
                return False
        vs = getattr(lock, "last_voice_s", None)
        if vs is None or vs >= NOISE_WORDS_VOICE_S or len(text.split()) > NOISE_WORDS_MAX:
            return False
        if detect_language_choice(text):
            return False
        self._noise_word_n = getattr(self, "_noise_word_n", 0) + 1
        if NOISE_WORDS == "on":
            log.warning("🌬️ words with no voice in their audio (%.1fs of voice — wind / bike / fan) "
                        "— dropped: %r", vs, text)
            return True
        log.info("🌬️ [shadow] words with no voice in their audio (%.1fs of voice — wind / bike / fan) "
                 "— would drop: %r", vs, text)
        return False

    async def _vl_frames(self, lock, frame):
        """One incoming audio frame → the frames the voice lock releases for STT."""
        pcm = np.frombuffer(frame.data, dtype=np.int16)
        if frame.num_channels > 1:
            pcm = pcm.reshape(-1, frame.num_channels).mean(axis=1).astype(np.int16)
        sr = lock.sample_rate
        if frame.sample_rate != sr and len(pcm):
            n_out = int(len(pcm) * sr / frame.sample_rate)
            pcm = np.interp(np.linspace(0, len(pcm) - 1, n_out),
                            np.arange(len(pcm)), pcm).astype(np.int16)
        # voice prints run in a worker thread — never on the event loop
        hops = await asyncio.to_thread(lock.process, pcm)
        return [rtc.AudioFrame(data=h.tobytes(), sample_rate=sr, num_channels=1,
                               samples_per_channel=len(h)) for h in hops]

    def _note_bot_words(self, piece: str) -> None:
        """[ECHO CHECK] remember what the bot said in the last ~20 s."""
        try:
            now = time_module.monotonic()
            dq = getattr(self, "_vl_bot_words", None)
            if dq is None:
                dq = self._vl_bot_words = deque(maxlen=200)
            for t in _echo_tokens(piece):
                dq.append((now, t))
        except Exception:
            pass

    def _recent_bot_words(self, within_s: float = 20.0) -> set:
        dq = getattr(self, "_vl_bot_words", None) or ()
        now = time_module.monotonic()
        return {t for ts, t in dq if now - ts <= within_s}

    def _start_lang_check(self, lock, text: str) -> None:
        """[LANG CHECK 02-Nov] send this final's own audio for language ID (pre-lock)."""
        if LANG_CHECK == "off" or not self._language_locked or not hasattr(lock, "take_turn_raw"):
            return
        try:
            pcm = lock.take_turn_raw()
            sr = int(getattr(lock, "sample_rate", 8000) or 8000)
        except Exception:
            return
        if pcm is None or len(pcm) < LANG_CHECK_MIN_S * sr:
            return
        lst = getattr(self, "_lang_checks", None)
        if lst is None:
            lst = self._lang_checks = []
        lst.append((text, asyncio.create_task(detect_audio_language(pcm, sr))))

    def _note_clues(self, lock, text: str, verdict: str) -> None:
        """[CLUES 02-Nov] keep the lock's clues for this final until the turn is decided."""
        if CLUES == "off":
            return
        c = dict(getattr(lock, "last_clues", None) or {})
        c.pop("_top", None)
        c["text"] = text
        c["soft"] = verdict
        lst = getattr(self, "_clue_finals", None)
        if lst is None:
            lst = self._clue_finals = []
        lst.append(c)

    def _log_clues(self, decision: dict, lang_other: dict) -> None:
        """[CLUES 02-Nov] one line per final before the voice is verified: 5 clues and
        what a "2 clues say other → drop" rule WOULD do. Shadow only — nothing dropped.
        Also written to <DEBUG_WAV_DIR>/<call>_clues.jsonl for labelling."""
        finals, self._clue_turn = getattr(self, "_clue_turn", None) or [], []
        if CLUES == "off" or not finals:
            return
        addressed = decision.get("addressed_to_bot")
        action = decision.get("next_action")
        rows = []
        for c in finals:
            why = []
            sim, bank = c.get("sim"), c.get("bank") or 0
            lim = CLUE_SIM_BY_BANK[min(bank, len(CLUE_SIM_BY_BANK) - 1)] if bank else None
            if sim is not None and lim is not None and sim < lim:
                why.append(f"voice {sim:.2f}<{lim:.2f}")
            since = c.get("since_bot_s")
            if since is not None and since > CLUE_LATE_S and not c.get("over_bot"):
                why.append(f"late {since:.1f}s")
            lx = c.get("level_x")
            if lx is not None and (lx < CLUE_LEVEL_LO or lx > CLUE_LEVEL_HI):
                why.append(f"level {lx:.2f}x")
            if addressed is False:
                why.append("not said to us")
            lg = lang_other.get(c["text"])
            if lg:
                why.append(f"lang {lg}")
            short = len(c["text"].split()) <= 2 or is_presence_check(c["text"]) or is_reply_to_bot(c["text"])
            would = "DROP" if len(why) >= 2 and not short else "KEEP"
            c.update({"addressed": addressed, "action": action, "lang_other": lg,
                      "other_clues": why, "would": would, "lang": self._locked_lang,
                      "turn": self._turn_count})
            rows.append(c)
            log.info("🧪 clues%s t=%ss %r | voice %s (bank %s) | after bot %s%s | level %s | said to us %s | "
                     "lang %s → would %s%s",
                     f" [{c.get('phase')}]", c.get("t"), c["text"][:50],
                     f"{sim:.2f}" if sim is not None else "-", bank,
                     f"{since:.1f}s" if since is not None else "-", " (over bot)" if c.get("over_bot") else "",
                     f"{lx:.2f}x" if lx is not None else "-", addressed, lg or "same",
                     would, f" ({', '.join(why)})" if why else "")
        d = os.getenv("TCVL_DEBUG_WAV_DIR_noice_concilation") or os.getenv("TCVL_DEBUG_WAV_DIR") \
            or os.getenv("DEBUG_WAV_DIR") or ""
        vl = getattr(self, "_voice_lock", None)
        cid = getattr(vl, "call_id", None)
        if d and cid:
            try:
                with open(os.path.join(d, f"{cid}_clues.jsonl"), "a", encoding="utf-8") as f:
                    for r in rows:
                        f.write(json.dumps(r, ensure_ascii=False) + "\n")
            except Exception as e:
                log.debug("clues file: %s", e)

    async def _drop_side_language(self, query: str, new_message) -> str:
        """[SIDE LANGUAGE 02-Nov] …64733 / …65862: the caller speaks Telugu, the people
        beside him Kannada (and Hindi). Before the voice is verified, a final of 3+
        words in ANOTHER Indian language than the caller's is left out of the turn
        (the caller's own finals stay). The caller's language: the one they NAMED,
        else the STT language of their first answer. Language from the STT itself
        while it auto-detects, else from LANG CHECK. English never counts; hello /
        language names never count. All finals other → the turn is side talk."""
        if SIDE_LANGUAGE == "off":
            return query
        segs = list(getattr(self, "_turn_segments", None) or [])
        if not segs:
            return query
        if self._language_locked and self._lang_source == "explicit":
            ref = self._locked_lang
        elif not self._language_locked:
            ref = getattr(self, "_caller_stt_lang", None)
        else:
            ref = None
        if not ref:
            return query
        checks = {t: task for t, task in (getattr(self, "_lang_checks", None) or [])}
        if self._language_locked and any(len(t.split()) >= LANG_CHECK_MIN_WORDS for t, _ in segs):
            pend = [checks[t] for t, _ in segs if t in checks and not checks[t].done()]
            if pend:
                with contextlib.suppress(Exception):
                    await asyncio.wait(pend, timeout=0.8)
        drop = []
        for t, det in segs:
            if len(t.split()) < LANG_CHECK_MIN_WORDS or detect_language_choice(t) or is_presence_check(t):
                continue
            if len(t.split()) <= 3 and any(tok in _HELLO_TOKENS
                                           for tok in _TOKEN_SPLIT_RE.split(t.lower()) if tok):
                continue                          # "హలో ఉన్నారా" — the caller checking the line
            lg = None
            task = checks.get(t)
            if task is not None and task.done() and not task.cancelled():
                with contextlib.suppress(Exception):
                    code, prob = task.result()
                    if code and (prob is None or prob >= LANG_CHECK_MIN_PROB):
                        lg = code
            if lg is None:
                lg = det     # the STT's own guess (a forced te-IN stream always says te-IN)
            if (lg and lg != ref and lg not in _LANG_OTHER_OK and lg in ALLOWED_LANGUAGE_CODES):
                drop.append((t, lg))
        self._turn_lang_other = {t: lg for t, lg in drop}
        if not drop:
            return query
        if len(drop) == len(segs):
            self._turn_all_side = True
            log.info("🌐 the whole turn is in another language than the caller's (%s): %r",
                     ref, [f"{t} ({lg})" for t, lg in drop])
            return query
        log.info("🌐 left out of the turn — another language than the caller's (%s)%s: %r",
                 ref, "" if SIDE_LANGUAGE == "on" else " [shadow]", [f"{t} ({lg})" for t, lg in drop])
        if SIDE_LANGUAGE != "on":
            return query
        gone = {t for t, _ in drop}
        kept = [(t, lg) for t, lg in segs if t not in gone]
        self._turn_segments = kept
        cleaned = " ".join(t for t, _ in kept).strip()
        with contextlib.suppress(Exception):
            new_message.content = [cleaned]
        return cleaned

    async def _turn_other_language(self, query: str):
        """[LANG CHECK] (other language code, share of words) when most of this turn
        was spoken in an Indian language other than the call language, else None."""
        checks, self._lang_checks = getattr(self, "_lang_checks", None) or [], []
        if not checks or LANG_CHECK == "off":
            return None
        with contextlib.suppress(Exception):
            await asyncio.wait([t for _, t in checks], timeout=LANG_CHECK_WAIT_S)
        call = self._locked_lang
        tot = other = 0
        langs = {}
        for text, t in checks:
            n = len(text.split())
            tot += n
            if not t.done():
                t.cancel()
                continue
            code, prob = t.result()
            # [02-Nov …65799] the caller's 2-word "అదే ఆ." came back kn-IN (0.72):
            # language ID on a word or two is a guess — such a final never counts
            if (code and code != call and code not in _LANG_OTHER_OK and n >= LANG_CHECK_MIN_WORDS
                    and code in ALLOWED_LANGUAGE_CODES
                    and (prob is None or prob >= LANG_CHECK_MIN_PROB)):
                other += n
                langs[code] = langs.get(code, 0) + n
            log.info("🌐 lang check: %r → %s%s", text[:50], code,
                     f" ({prob:.2f})" if prob is not None else "")
        if tot and other / tot >= LANG_CHECK_SHARE:
            return max(langs, key=langs.get), other / tot
        return None

    async def _vl_keep_stt_event(self, ev, lock) -> bool:
        """False = this transcript is not the customer's speech: it is not given
        to LiveKit, so it can neither interrupt the bot nor become a turn."""
        name = str(getattr(getattr(ev, "type", None), "name", getattr(ev, "type", "")))
        alts = getattr(ev, "alternatives", None) or []
        text = (getattr(alts[0], "text", "") or "").strip() if alts else ""
        speaking = getattr(getattr(self, "_session", None), "agent_state", None) == "speaking"

        if not getattr(lock, "locked", False):
            # still learning the voice: report real words, pass everything
            if "FINAL" in name and text and not speaking and hasattr(lock, "note_enroll_words"):
                lock.note_enroll_words(len(text.split()))
            if "FINAL" in name and text:
                self._start_lang_check(lock, text)
            # [SOFT LOCK 02-Nov] the voice that answered the greeting (confirmed by a
            # 2nd answer / an anchor) is the caller: a final in a CLEARLY different
            # voice is dropped like after the full lock — by voice print, never by
            # loudness. Short replies and words over the bot are never judged.
            if "FINAL" in name and text and hasattr(lock, "soft_judge"):
                try:
                    sv, ssim = await asyncio.to_thread(lock.soft_judge)
                except Exception as e:
                    log.debug("soft judge failed: %s", e)
                    sv, ssim = "unknown", None
                self._note_clues(lock, text, sv)
                if self._noise_words(lock, text, speaking):
                    return False
                if sv == "other":
                    if is_presence_check(text) or is_reply_to_bot(text) or detect_language_choice(text):
                        log.info("🔐 soft lock: other voice (%.2f) but a reply to us — kept: %r",
                                 ssim if ssim is not None else -1, text)
                        return True
                    self._vl_dropped += 1
                    log.warning("🔐 soft lock: not the caller's voice (%.2f) — dropped before the "
                                "bot heard it: %r", ssim if ssim is not None else -1, text)
                    return False
            # [v5.0 16-Oct] before the lock, while the bot speaks: partial words from a
            # voice far quieter than the caller (TV, people in the room) must not
            # interrupt the bot — the same rule the VAD gate uses. Final words pass.
            if (("INTERIM" in name or "PREFLIGHT" in name) and speaking
                    and lock.vad_should_mute()):
                return False
            return True

        if "INTERIM" in name or "PREFLIGHT" in name:
            return not lock.vad_should_mute()     # partial words over the bot: customer only
        if "FINAL" not in name or not text:
            return True
        if not getattr(lock, "_proven", True):
            self._start_lang_check(lock, text)    # [02-Nov] probation: still check the language
            if hasattr(lock, "soft_judge"):
                with contextlib.suppress(Exception):
                    await asyncio.to_thread(lock.soft_judge)   # clues only while locked
                self._note_clues(lock, text, "probation")
        if lock.bot_speaking and lock.customer_active(2.5):
            return True                           # the lock just passed the customer over the bot
        barge = bool(getattr(lock, "loud_barge_recent", None) and lock.loud_barge_recent(3.0))

        verdict, sim = await asyncio.to_thread(lock.judge_turn)
        if self._noise_words(lock, text, speaking):
            return False
        if verdict == "other":
            # [ECHO CHECK 21-Oct] not the caller's voice AND not words a person says
            _share = echo_share(text, self._recent_bot_words())
            if ((is_word_loop(text) or (_share >= 0.999 and len(_echo_tokens(text)) >= 3))
                    and not is_presence_check(text) and not is_reply_to_bot(text)
                    and not detect_language_choice(text)):
                self._vl_dropped += 1
                log.warning("🔁 bot echo / word loop dropped (voice %s, %d%% of the words are the "
                            "bot's own): %r", f"{sim:.2f}" if sim is not None else "n/a",
                            int(100 * _share), text)
                return False
        if barge and verdict == "other":
            # [v5.0 16-Oct] a voice as loud as the caller interrupted the bot. Over the
            # bot's own audio (echo) the voice print is unreliable: the caller's
            # "మాక్సిమం ఎంత ఉండొచ్చు సబ్స్క్రిప్షన్?" scored -0.03 and was dropped
            # (…58097), "క్యా క్లాఉడ్…" 0.11 (…58039). Keep the words.
            log.info("🗣️ caller interrupted the bot — kept despite voice score %s (bot echo): %r",
                     f"{sim:.2f}" if sim is not None else "n/a", text)
            self._vl_prev_verdict = ("customer", time_module.monotonic())
            return True
        now = time_module.monotonic()
        if verdict in ("customer", "other"):
            self._vl_prev_verdict = (verdict, now)
        sim_txt = f"{sim:.2f}" if sim is not None else "n/a"

        if verdict == "unknown":
            prev = self._vl_prev_verdict
            if prev is not None and prev[0] == "customer" and now - prev[1] <= SL_INHERIT_S:
                return True                       # rest of a sentence already verified
            if speaking and not is_presence_check(text):
                log.warning("🤫 Unverifiable words while the bot is speaking — not passed on: %r", text)
                return False
            return True
        if verdict != "other":
            return True
        if is_presence_check(text):
            log.info("🔔 'Hello' kept despite voice mismatch (sim=%s): %r", sim_txt, text)
            return True
        # [VOICE CHECK 2 17-Oct] second clue before a drop: a short reply aimed at
        # the bot, at the caller's normal level, is the caller — keep it.
        lj = getattr(lock, "last_judge", None) or {}
        if ((is_reply_to_bot(text) or detect_language_choice(text))
                and not lj.get("quiet") and not lj.get("rival")):
            log.warning("🟢 reply to the bot kept — voice score %s alone is not enough to drop it: %r",
                        sim_txt, text)
            return True
        self._vl_dropped += 1
        log.warning("🚫 Not the customer's voice — dropped before the bot heard it "
                    "(sim=%s, #%d): %r", sim_txt, self._vl_dropped, text)
        return False

    async def stt_node(self, audio, model_settings):
        """LiveKit's default stt_node, plus a live stream swap: when
        _update_stt_language() sets _stt_swap_event, open a fresh Sarvam stream
        (it reads the new _opts.language), move the audio onto it, then close
        the old one. Never update_options() the live stream — see there."""
        activity = self._get_activity_or_raise()
        inst = self._stt_instance
        if inst is None or activity.stt is not inst:
            async for ev in Agent.default.stt_node(self, audio, model_settings):
                yield ev
            return

        conn_options = activity.session.conn_options.stt_conn_options
        current: dict = {"stream": None}

        # [SPEAKER LOCK] audio goes through the customer voice lock on its way to STT
        lock = getattr(self, "_voice_lock", None)
        if lock is not None:
            with contextlib.suppress(Exception):
                lock.reset_stream()

        async def _forward() -> None:
            async for frame in audio:
                out = [frame]
                if lock is not None:
                    try:
                        out = await self._vl_frames(lock, frame)
                    except Exception as e:          # fail-open: never go deaf
                        now = time_module.monotonic()
                        if now - self._vl_err_ts > 5.0:
                            self._vl_err_ts = now
                            log.error("voice lock audio error (frame passed unfiltered): %s", e)
                        out = [frame]
                s = current["stream"]
                if s is not None:
                    for f in out:
                        if SILENCE_SKIP != "off" and not self._sil_should_send(f):
                            if SILENCE_SKIP == "on":
                                continue
                        if SILENCE_SKIP == "on" and getattr(self, "_sil_lead", False):
                            self._sil_lead = False
                            n = int(f.sample_rate * 0.2)
                            with contextlib.suppress(Exception):
                                s.push_frame(rtc.AudioFrame(data=bytes(2 * n), sample_rate=f.sample_rate,
                                                            num_channels=1, samples_per_channel=n))
                        with contextlib.suppress(Exception):
                            s.push_frame(f)

        forward_task = asyncio.create_task(_forward())
        stream = None
        nxt = None
        try:
            while True:
                self._stt_swap_event.clear()
                # New stream first, so no audio is pushed into a closed one.
                old, stream = stream, inst.stream(conn_options=conn_options)
                with contextlib.suppress(Exception):
                    stream.start_time_offset = (
                        time_module.time() - self._audio_input_started_at(activity))
                current["stream"] = stream
                if old is not None:
                    with contextlib.suppress(Exception):
                        await old.aclose()
                    log.info("🎙️ STT stream swapped — language=%s", inst._opts.language)

                swapped = False
                swap_wait = asyncio.ensure_future(self._stt_swap_event.wait())
                try:
                    it = stream.__aiter__()
                    while True:
                        nxt = asyncio.ensure_future(it.__anext__())
                        await asyncio.wait({nxt, swap_wait},
                                           return_when=asyncio.FIRST_COMPLETED)
                        if not nxt.done():
                            swapped = True
                            break
                        try:
                            ev = nxt.result()
                        except StopAsyncIteration:
                            break
                        finally:
                            nxt = None
                        if lock is not None:
                            try:
                                if not await self._vl_keep_stt_event(ev, lock):
                                    continue
                            except Exception as e:  # fail-open: keep the transcript
                                log.error("voice lock transcript check error (kept): %s", e)
                        yield ev
                finally:
                    swap_wait.cancel()
                    if nxt is not None and not nxt.done():
                        nxt.cancel()
                        await asyncio.wait({nxt})
                    nxt = None
                if not swapped:
                    break
        finally:
            current["stream"] = None
            forward_task.cancel()
            await asyncio.wait({forward_task})
            if stream is not None:
                with contextlib.suppress(Exception):
                    await stream.aclose()

    async def tts_node(self, text, model_settings):
        """Buffer to clause boundaries before normalizing — ensures multi-word
        phrases like 'serial number' and 'TallyPrime Silver' match in full."""
        self._current_speech_text = ""
        speak_lang = self._turn_tts_lang or self._locked_lang
        word_cap = self._turn_word_cap

        async def _strip_directives(src):
            # Defense-in-depth: if the model leaks the private instruction (e.g.
            # "[Your goal…]" or "FOCUS: …"), strip that leading noise before TTS.
            # We buffer only the opening of the reply, clean it, then stream the rest.
            head = ""
            cleaning = True
            async for chunk in src:
                c = chunk if isinstance(chunk, str) else str(chunk)
                if not cleaning:
                    yield c
                    continue
                head += c
                # keep buffering while a bracket note is still open
                if head.count("[") > head.count("]"):
                    continue
                # wait for a little context before deciding (unless a boundary arrives)
                if len(head) < 40 and not re.search(r"[.!?।\n]", head):
                    continue
                cleaned = _LEADING_NOISE_RE.sub("", head)
                cleaning = False
                if cleaned.strip():
                    yield cleaned
                head = ""
            if cleaning and head:
                cleaned = _LEADING_NOISE_RE.sub("", head)
                if cleaned.strip():
                    yield cleaned

        async def _buffer_and_normalize(stream):
            buf = ""
            spoken: List[str] = []
            word_count = 0
            capped = False

            def _prepare(piece: str) -> Optional[str]:
                out = normalize_for_tts(sanitize_for_speech(piece), speak_lang)
                return out if out.strip() else None

            async for chunk in stream:
                if capped:
                    continue
                buf += chunk if isinstance(chunk, str) else str(chunk)

                while True:
                    m = (_FLUSH_RE if not spoken else _SENT_FLUSH_RE).search(buf)
                    if not m:
                        break
                    piece, buf = buf[: m.end()], buf[m.end() :]
                    out = _prepare(piece)
                    if out:
                        spoken.append(out)
                        self._note_bot_words(out)
                        word_count += len(out.split())
                        yield out
                    if word_count >= word_cap:
                        log.warning("✂️ TTS capped at %d words", word_count)
                        capped = True
                        buf = ""
                        break

                if not capped and len(buf) > TTS_CLAUSE_MAX_CHARS:
                    cut = buf.rfind(" ", 0, TTS_CLAUSE_MAX_CHARS)
                    if cut > 0:
                        piece, buf = buf[:cut], buf[cut:]
                        out = _prepare(piece)
                        if out:
                            spoken.append(out)
                            self._note_bot_words(out)
                            word_count += len(out.split())
                            yield out
                            if word_count >= word_cap:
                                capped = True
                                buf = ""

            if not capped and buf.strip():
                out = _prepare(buf)
                if out:
                    spoken.append(out)
                    self._note_bot_words(out)
                    yield out

            self._current_speech_text = " ".join(spoken)
            # Transfers start ONLY from _handoff_now() (consent → fixed hold line).
            # A reply no longer triggers one: …58149/…58150/…58151 were transferred
            # after "say that once more?" / a trial question / a callback promise.
            if self._handing_off:
                pass
            elif (reply_promises_transfer(self._current_speech_text)
                    or reply_offers_transfer(self._current_speech_text)):
                callback = (_CALLBACK_RE.search(self._current_speech_text)
                            or self._turn_action in ("close_polite", "close_positive"))
                if callback:
                    log.info("📞 Reply mentions an expert in a callback / close — no transfer: %r",
                             self._current_speech_text[:80])
                elif not self._transfer_offered:
                    # The LLM talked about connecting them — treat it as an offer:
                    # a yes next turn transfers (with the hold line first).
                    log.info("📞 Reply mentions connecting to an expert — treated as an offer: %r",
                             self._current_speech_text[:80])
                    self._transfer_offered = True
                    self._offer_kind = self._offer_kind or "director"
            if self._language_locked and self._current_speech_text:
                ok = reply_script_is_compliant(self._current_speech_text, speak_lang)
                self._script_violation = not ok
                if not ok:
                    log.warning("🔤 Script violation (%s) — will correct next turn", speak_lang)

        async for audio in super().tts_node(
            _buffer_and_normalize(_strip_directives(text)), model_settings
        ):
            yield audio

    async def llm_node(self, chat_ctx, tools, model_settings):
        """Buffer the full reply, strip <think> blocks, then emit it as ONE piece.
        This kills three failure modes we hit with token-streaming + qwen:
          • dead air when the model returns only a <think> block or whitespace,
          • <think> reasoning leaking into speech,
          • the fallback line getting concatenated onto a real reply.
        Replies are 1-2 sentences, so buffering costs negligible latency.

        An empty reply is retried once with a nudge before the "sorry, a small
        issue" fallback: Qwen sometimes returns no text at all (6 of 118
        replies on Oct 6, e.g. call …47839), and that line confused callers."""
        raw, diag = await self._collect_llm_text(chat_ctx, tools, model_settings)
        if not _LEADING_NOISE_RE.sub("", raw).strip():
            log.warning("⚠️ LLM reply empty (%s) — retrying once", diag)
            retry_ctx = chat_ctx.copy()
            lang_name = _LANG_NAMES.get(self._turn_tts_lang or self._locked_lang, "English")
            retry_ctx.add_message(role="system", content=(
                f"Your previous reply was empty. Reply NOW to the customer's last message "
                f"with one or two short spoken sentences in {lang_name}, following the goal "
                f"given above. Write only the words you speak."))
            raw, diag = await self._collect_llm_text(retry_ctx, tools, model_settings)
            if _LEADING_NOISE_RE.sub("", raw).strip():
                log.info("✅ retry produced a reply: %r", raw[:80])
            else:
                log.warning("⚠️ retry also empty (%s)", diag)
        elif (not self._verbatim_turn and self._turn_action not in (None, "clarify")
                and is_repeat_request(_LEADING_NOISE_RE.sub("", raw).strip())):
            # Director understood the turn but the reply asks to repeat (…51243).
            log.warning("🔁 Reply asked to repeat (action=%s) — regenerating: %r",
                        self._turn_action, raw[:80])
            retry_ctx = chat_ctx.copy()
            lang_name = _LANG_NAMES.get(self._turn_tts_lang or self._locked_lang, "English")
            meaning = (f" They meant: {self._turn_meaning}."
                       if self._turn_meaning and self._turn_action != "rephrase" else "")
            retry_ctx.add_message(role="system", content=(
                f"Do NOT ask the customer to repeat — you understood them.{meaning} Reply "
                f"NOW to that, following the goal given above, in one or two short spoken "
                f"sentences in {lang_name}. Write only the words you speak."))
            retry, diag = await self._collect_llm_text(retry_ctx, tools, model_settings)
            retry_clean = _LEADING_NOISE_RE.sub("", retry).strip()
            if retry_clean and not is_repeat_request(retry_clean):
                log.info("✅ regenerated reply: %r", retry[:80])
                raw = retry
            else:
                log.warning("⚠️ regenerated reply still asks to repeat (%s) — keeping it", diag)
        if self._fallback_line and is_repeat_request(_LEADING_NOISE_RE.sub("", raw).strip()):
            log.warning("🔁 fixed-line turn came back as a repeat request — speaking the line")
            raw = self._fallback_line
        raw = await self._guard_copied_reply(raw, chat_ctx, tools, model_settings)
        async for out in self._finish_reply(raw):
            yield out

    async def _guard_copied_reply(self, raw, chat_ctx, tools, model_settings):
        """[COPY GUARD 27-Oct] Two ways the model re-speaks an old line instead of
        answering (…61654, the caller hung up without hearing the price):
          1. it copies a reply the caller CUT OFF, note and all ("…Five users కి
             [cut off — the customer did not hear the rest]") — the note was
             stripped and the half sentence spoken, three times;
          2. it repeats its last line word for word after "I didn't understand"
             ("మీ business ఏ రకంగా ఉంది?" twice).
        Either way: regenerate once with a clear instruction. Fixed lines
        (verbatim turns) are never touched."""
        if self._verbatim_turn or self._fallback_line:
            return raw
        clean = _LEADING_NOISE_RE.sub("", raw).strip()
        copied_cut = bool(_CUT_OFF_ECHO_RE.search(clean))
        last = getattr(self, "_last_bot_reply", "") or ""
        same = bool(last) and _norm_line(_CUT_OFF_ECHO_RE.sub("", clean)) == _norm_line(last)
        if not (copied_cut or same):
            return raw
        lang_name = _LANG_NAMES.get(self._turn_tts_lang or self._locked_lang, "English")
        if copied_cut:
            log.warning("✂️ reply copied a cut-off line — regenerating: %r", clean[:100])
            note = ("Your last answer was cut off and the customer did NOT hear it. Give "
                    "the COMPLETE answer now, in full sentences that end properly. Never "
                    "copy an earlier reply or any '[cut off …]' note.")
        else:
            log.warning("🔁 reply repeats the last line word for word — regenerating: %r",
                        clean[:100])
            note = ("You just said exactly this. Say it DIFFERENTLY, in simpler words"
                    + (", with two or three short examples (e.g. shop, wholesale, "
                       "manufacturing, services)." if self._turn_action in ("clarify", "rephrase")
                       else "."))
        retry_ctx = chat_ctx.copy()
        retry_ctx.add_message(role="system", content=(
            f"{note} Follow the goal given above. One to three short spoken sentences in "
            f"{lang_name}. Write only the words you speak."))
        retry, diag = await self._collect_llm_text(retry_ctx, tools, model_settings)
        rc = _LEADING_NOISE_RE.sub("", retry).strip()
        if rc and not _CUT_OFF_ECHO_RE.search(rc) and not (
                last and _norm_line(rc) == _norm_line(last)):
            log.info("✅ regenerated reply: %r", rc[:100])
            return retry
        log.warning("⚠️ regenerated reply no better (%s)", diag)
        if copied_cut:
            # [02-Nov] …64733 spoke "మీ business కోసమే" / "మీ business": the model copied
            # the cut line twice and the half sentence went out. Last try with the
            # cut-off lines REMOVED from the context — nothing left to copy.
            ctx2 = chat_ctx.copy()
            with contextlib.suppress(Exception):
                ctx2.items[:] = [it for it in ctx2.items if not (
                    getattr(it, "role", None) == "assistant"
                    and (getattr(it, "interrupted", False)
                         or _CUT_OFF_ECHO_RE.search(it.text_content or "")))]
            ctx2.add_message(role="system", content=(
                f"{note} Follow the goal given above. One to three short spoken sentences "
                f"in {lang_name}. Write only the words you speak."))
            r2, diag2 = await self._collect_llm_text(ctx2, tools, model_settings)
            r2c = _LEADING_NOISE_RE.sub("", r2).strip()
            if r2c and not _CUT_OFF_ECHO_RE.search(r2c) and len(r2c.split()) >= 3:
                log.info("✅ regenerated reply (cut lines removed): %r", r2c[:100])
                return r2
            log.warning("⚠️ second regeneration no better (%s)", diag2)
            # never speak a half sentence: keep only the complete sentences
            body = _CUT_OFF_ECHO_RE.sub("", clean).strip()
            whole = _complete_sentences(body)
            return whole or body
        return raw

    async def _collect_llm_text(self, chat_ctx, tools, model_settings):
        """Run the base llm_node and return (visible text, diagnostics).
        Diagnostics say what an empty reply actually contained."""
        parts: list = []
        in_think = False
        think_buf = ""
        chunks = 0
        think_chars = 0
        error = None

        stream = super().llm_node(chat_ctx, tools, model_settings)
        try:
            async for c in stream:
                # The base llm_node yields llm.ChatChunk objects, not plain
                # strings — the text lives in c.delta.content. str(c) would emit
                # the object repr, so extract the delta explicitly.
                if isinstance(c, str):
                    text = c
                else:
                    delta = getattr(c, "delta", None)
                    text = getattr(delta, "content", None) if delta else None
                if not text:
                    continue
                chunks += 1
                if in_think:
                    think_buf += text
                    if "</think>" in think_buf:
                        in_think = False
                        think_part, _, after = think_buf.partition("</think>")
                        think_chars += len(think_part)
                        parts.append(after)
                        think_buf = ""
                    continue
                if "<think>" in text:
                    before, _, rest = text.partition("<think>")
                    if before:
                        parts.append(before)
                    if "</think>" in rest:
                        think_part, _, after = rest.partition("</think>")
                        think_chars += len(think_part)
                        parts.append(after)
                    else:
                        in_think = True
                        think_buf = rest
                    continue
                parts.append(text)
        except asyncio.CancelledError:
            raise
        except Exception as e:
            error = e
            log.error("LLM node error: %s", e)
        finally:
            aclose = getattr(stream, "aclose", None)
            if aclose:
                with contextlib.suppress(Exception):
                    await aclose()

        raw = "".join(parts).strip()
        diag = (f"text_chunks={chunks} think_chars={think_chars + len(think_buf)} "
                f"unclosed_think={in_think} raw={raw[:80]!r}"
                + (f" error={error!r}" if error else ""))
        return raw, diag

    async def _finish_reply(self, raw: str):
        """Final guards on a fully buffered reply, then emit it as one piece."""
        # Strip a leaked private directive ("[Your goal for this reply: …]")
        # BEFORE the empty check. tts_node strips it too, so a reply that was
        # nothing but the echoed directive passed the check, then reached TTS
        # empty → dead air with no fallback (call …46977).
        reply = _LEADING_NOISE_RE.sub("", raw).strip()
        # Never speak our own cut-off note if the model echoes it.
        reply = _CUT_OFF_ECHO_RE.sub("", reply).strip()
        if reply != raw:
            log.warning("🧾 LLM reply had leading directive/noise stripped — raw: %r", raw[:300])
        if not reply and self._fallback_line:
            # A fixed line (e.g. the transfer consent question) owns this turn —
            # never replace it with "say that once more?" (…58151 at 18:55).
            log.warning("⚠️ LLM produced no usable text — speaking the fixed line")
            reply = self._fallback_line
        elif not reply:
            log.warning("⚠️ LLM produced no usable text — using fallback")
            reply = _LLM_ERROR_FALLBACK.get(
                self._turn_tts_lang, _LLM_ERROR_FALLBACK["en-IN"]
            )
        elif (self._verbatim_turn and self._fallback_line
                and _norm_line(self._fallback_line) not in _norm_line(reply)):
            # [FIXED LINE 27-Oct] a fixed line (TV request, consent, discount) must be
            # spoken as written — …61697: told to say the TV line, the LLM answered
            # "అవును, నేను తెలుగులో మాట్లాడగలను." instead.
            log.warning("📌 fixed line replaced the LLM's own text: %r", reply[:80])
            reply = self._fallback_line
        elif not self._verbatim_turn:
            # Code-level guards on the finished reply (it is fully buffered here):
            # the opening already introduced Avni, and openers must not repeat.
            if not self._allow_intro:
                cleaned = strip_self_intro(reply)
                if cleaned != reply:
                    log.info("🙅 re-introduction removed: %r → %r", reply[:80], cleaned[:80])
                    reply = cleaned
            # Never volunteer "I'm an AI assistant" — only when the caller asked.
            if not self._ai_asked:
                cleaned = strip_ai_mention(reply)
                if cleaned != reply:
                    log.info("🙅 unasked AI mention removed: %r → %r", reply[:80], cleaned[:80])
                    reply = cleaned
            reply = self._acks.filter(reply)
        fem = feminize_hindi_self(reply)
        if fem != reply:
            log.info("👩 male self-forms → female: %r → %r", reply[:80], fem[:80])
            reply = fem
        yield reply

