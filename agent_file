    def _history_for_director(self, turn_ctx) -> list:
        """The call's user/assistant turns so far, as plain dicts for the Director LLM.

        turn_ctx is a copy of the agent's chat context, which LiveKit keeps for
        the whole call (one agent per call, so it's per-call memory). We used to
        slice the last 8 ITEMS before filtering by role, then direct_turn kept
        6 — the Director saw ~3 exchanges, forgot earlier answers and re-asked
        them. Filter first, then keep the whole call (bounded by
        DIRECTOR_HISTORY_MAX). The current customer message is not in turn_ctx
        yet — direct_turn passes it separately, so it is never sent twice.
        """
        out = []
        for it in getattr(turn_ctx, "items", None) or []:
            role = getattr(it, "role", None)
            if role not in ("user", "assistant"):
                continue
            txt = getattr(it, "text_content", "") or ""
            if isinstance(txt, list):
                txt = " ".join(str(x) for x in txt)
            if not txt:
                continue
            txt = str(txt)
            # A reply the caller cut off is partial — don't present it as complete.
            if role == "assistant" and getattr(it, "interrupted", False):
                txt = txt.replace(_CUT_OFF_NOTE, "")[:300] + _CUT_OFF_NOTE
            else:
                txt = txt[:300]
            out.append({"role": role, "content": txt})
        return out[-DIRECTOR_HISTORY_MAX:]

    # Director moves that mean "discovery is over, time to pitch".
    _PITCH_ACTIONS = ("position_value", "move_to_sales", "offer_demo")

    def _trial_status_step(self, decision: dict, action: Optional[str], fixed_route: bool):
        """After discovery, route the pitch by where the customer is with the trial.

        Returns (kind, focus): "ask" → ask whether they've started the trial;
        "handoff" → trial running: fixed TRIAL_ONGOING line + expert transfer;
        "license" → trial over: pitch buying the license, not the trial;
        (None, None) → leave the Director's move alone (trial not started, or
        not at the pitch point yet — "not started" keeps the trial pitch).
        Skipped for licensed customers, decliners, and turns where the customer
        asked something or a fixed line (pricing / discount / cloud) owns it.
        """
        lead = self._lead
        if (lead.existing_customer or lead.branch == "not_interested" or fixed_route
                or decision.get("asked_question")
                or action in ("transfer_to_expert", "share_payment", "confirm_demo",
                              "answer_question", "clarify", "handle_objection",
                              "close_polite", "close_positive")):
            return None, None
        # The pitch point: the Director wants to pitch, or discovery is used up.
        if not (action in self._PITCH_ACTIONS or lead.next_slot() is None):
            return None, None

        status = lead.trial_status
        if status == "ongoing" and not self._trial_confirmed:
            # Guessed by the Director, never answered → ask; never transfer on it.
            log.info("🧪 trial 'ongoing' not confirmed by the customer — asking first")
            status = None
        if status is None:
            if lead.ask_counts.get("trial_status", 0) >= 2:
                return None, None            # dodged twice — Director's default (trial pitch)
            lead.count_slot("trial_status")
            self._trial_q_pending = True
            log.info("🧪 trial status unknown — asking before the pitch")
            return "ask", ("Discovery is done. Briefly acknowledge what they said, then ask ONLY "
                           "whether they have started using the free trial yet. Nothing else — "
                           "no pitch, no other question.")
        if (status == "ongoing" and "trial_ongoing" not in self._handoffs
                and "consent:trial_ongoing" not in self._handoffs):
            line = TRIAL_ONGOING_LINES.get(self._locked_lang, TRIAL_ONGOING_LINES["en-IN"])
            log.info("🧪 trial ongoing — expert handoff")
            return "handoff", f"Say ONLY this line, nothing else: \"{line}\""
        if (status == "not_started" and action in ("position_value", "move_to_sales")
                and lead.ask_counts.get("trial_pitch", 0) < 1):
            # Pitch the trial once (personal-use callers too — their flow pitched
            # the license); after that the Director handles their answer.
            lead.count_slot("trial_pitch")
            need = (f"for {lead.purpose}" if lead.is_personal() and lead.purpose
                    else "for what they told you")
            log.info("🧪 trial not started — pitching the free trial")
            return "trial", (f"Their free trial has not started yet. In one or two sentences, say "
                             f"how TallyPrime helps them {need}, then ask if they'd like to start "
                             "the seven-day free trial — it costs nothing. Do NOT pitch buying a "
                             "license. There is NO offer or discount — never mention one.")
        if status == "finished" and action != "move_to_sales":
            log.info("🧪 trial finished — pitching the license")
            return "license", ("Their free trial is already over. Connect what they told you to "
                               "one TallyPrime benefit, then ask if they'd like to buy the "
                               "license. Do NOT pitch or mention the free trial. There is NO "
                               "offer or discount — never mention one.")
        return None, None

    @staticmethod
    def _last_reply_cut_off(turn_ctx) -> bool:
        """True when the bot's latest reply was interrupted by the caller."""
        for it in reversed(getattr(turn_ctx, "items", None) or []):
            if getattr(it, "role", None) == "assistant":
                return bool(getattr(it, "interrupted", False))
        return False

    def _mark_cut_off_replies(self, turn_ctx) -> None:
        """Tag every reply the caller cut off, in THIS turn's context only.

        LiveKit stores a cut-off reply as just the words that played ("समझ गई।
        बताइए, आप") with interrupted=True, but that flag never reaches Qwen. The
        model saw its own half-sentences as finished replies and copied them:
        call …49021 went "बताइए, आप" → "अभी" → "को" → "जी," → "बताइए,".
        Replaying that context: 5/5 fragments untagged, 5/5 full replies tagged.
        (The old "agent_speech_interrupted" hook never fired — LiveKit 1.7 has
        no such event.) turn_ctx shares items with the agent's history, so we
        replace them with copies; the stored history and Mongo are unchanged.
        """
        items = getattr(turn_ctx, "items", None)
        if not items:
            return
        for i, it in enumerate(items):
            if getattr(it, "role", None) != "assistant" or not getattr(it, "interrupted", False):
                continue
            txt = it.text_content or ""
            if not txt or txt.endswith(_CUT_OFF_NOTE):
                continue
            try:
                items[i] = it.model_copy(update={"content": [txt + _CUT_OFF_NOTE]})
            except Exception as e:
                log.debug("cut-off mark failed: %s", e)

    def _add_directive(self, turn_ctx, *, content: str, role: str = "system"):
        """Add a system message that belongs to THIS turn only.

        turn_ctx.items persists for the whole call, so every per-turn instruction
        we injected stayed in the context forever. The model then saw the
        "finish by asking whether there's anything else" rule from every earlier
        turn and kept obeying all of them — which is why the check repeated no
        matter what the current turn's rule said. We track and purge them.
        """
        try:
            msg = turn_ctx.add_message(role="system", content=content)
            if getattr(msg, "id", None):
                self._directive_ids.append(msg.id)
        except Exception as e:
            log.debug("directive add failed: %s", e)

    def _purge_directives(self, turn_ctx) -> None:
        """Drop the previous turn's directives before injecting this turn's."""
        if not self._directive_ids:
            return
        try:
            stale = set(self._directive_ids)
            items = getattr(turn_ctx, "items", None)
            if items is not None:
                items[:] = [i for i in items if getattr(i, "id", None) not in stale]
            log.debug("🧹 purged %d stale directive(s)", len(stale))
        except Exception as e:
            log.debug("directive purge failed: %s", e)
        finally:
            self._directive_ids.clear()

    async def on_user_turn_completed(self, turn_ctx, new_message):
        """[MONGO 02-Nov] A turn the bot does not answer (language question asked by
        code, side talk, noise, transfer …) ends in StopResponse, and LiveKit then
        never adds the caller's message to the chat — so it never reached Mongo: the
        transcript started at the 3rd line (…65895). Such turns are saved here, with
        "no_reply": True, exactly as the caller said them."""
        try:
            original = new_message.text_content or ""
        except Exception:
            original = ""
        if original.strip() and self._machine_note_turn(original):   # [MACHINE HANGUP]
            cb = getattr(self, "_save_unanswered", None)
            if cb is not None:
                with contextlib.suppress(Exception):
                    cb(original.strip())
            if StopResponse is not None:
                raise StopResponse()                       # the call is being cut: no reply
            return
        try:
            return await self._on_user_turn_completed(turn_ctx, new_message)
        except BaseException as e:
            if StopResponse is not None and isinstance(e, StopResponse) and original.strip():
                cb = getattr(self, "_save_unanswered", None)
                if cb is not None:
                    with contextlib.suppress(Exception):
                        cb(original.strip())
            raise

    async def _on_user_turn_completed(self, turn_ctx, new_message):
        # [CLUES] the finals of THIS turn (later ones belong to the next turn)
        self._clue_turn, self._clue_finals = getattr(self, "_clue_finals", None) or [], []
        try:
            query = new_message.text_content or ""
        except Exception:
            query = ""

        # Drop the previous turn's private instructions FIRST. They are valid for
        # exactly one reply; leaving them in the persistent context made the model
        # obey every past turn's rule at once.
        self._purge_directives(turn_ctx)
        self._turn_word_cap = TTS_MAX_SPOKEN_WORDS
        self._verbatim_turn = False
        self._fallback_line = None
        self._turn_action = None             # Director's next_action, once it has run
        self._turn_meaning = ""              # Director's "understanding" of this turn
        self._allow_intro = bool(_IDENTITY_Q_RE.search(query))
        self._ai_asked = bool(_AI_Q_RE.search(query))

        # Before the greeting is done (i.e. during AMD detection) hold every
        # utterance and NEVER process a turn. Otherwise a voicemail/IVR saying
        # things like "...you may hang up" trips is_wrapup() and tears down the
        # room before AMD can leave its callback message.
        # if not self._greeting_done:
        #     log.info("🤫 Pre-greeting utterance held (AMD in progress): %r", query[:60])
        #     if StopResponse is not None:
        #         raise StopResponse()
        #     self._add_directive(turn_ctx,
        #         role="system",
        #         content="(Do not speak this turn. Reply with nothing at all.)",
        #     )
        #     return

        if self._transfer_busy or self._handing_off:
            log.info("📞 Transfer in progress — ignoring: %r", query[:60])
            if StopResponse is not None:
                raise StopResponse()
            self._add_directive(turn_ctx, role="system",
                                content="(Do not speak this turn. Reply with nothing at all.)")
            return

        self._mark_cut_off_replies(turn_ctx)

        # [TV HOLD 22-Oct] TV / radio non-stop on the line → ask ONCE to lower it
        _vl = getattr(self, "_voice_lock", None)
        _tv = _vl.tv_on_line() if _vl is not None and hasattr(_vl, "tv_on_line") else None
        # [TV 27-Oct] …61697: the caller's "తెలుగులో మాట్లాడతారా?" was swallowed by this
        # request (said in English) and the call never got Telugu. A reply that NAMES a
        # language goes the normal way first; the TV request comes on the next turn,
        # in the caller's language.
        _names_lang = (not self._language_locked and has_switch_cue(query)
                       and detect_language_choice(query) in ALLOWED_LANGUAGE_CODES)
        if _tv and _names_lang and not getattr(self, "_tv_asked", False):
            log.info("📺 TV on, but the caller named a language — language first, TV request next turn")
        if _tv and not _names_lang and not getattr(self, "_tv_asked", False):
            self._tv_asked = True
            tv_lang = self._locked_lang if self._language_locked else DEFAULT_LANGUAGE
            line = TV_NOISE_LINES.get(tv_lang, TV_NOISE_LINES["en-IN"])
            log.info("📺 asking the caller to lower the TV (%s)", _tv)
            self._set_tts_language(tv_lang)
            self._verbatim_turn = True
            self._fallback_line = line
            self._add_directive(turn_ctx, role="system", content=(
                f"[Your goal for this reply: say ONLY this line and nothing else: \"{line}\"]\n"
                "Do NOT greet or introduce yourself. "
                "Write ONLY the words you speak. Do not repeat this note."
            ))
            return

        # [CROWD 29-Oct] several voices answer before the lock knows the caller → ask
        # ONCE, in the caller's language (never before the language is set, never on
        # the turn the TV request was made)
        _crowd = _vl.crowd_on_line() if _vl is not None and hasattr(_vl, "crowd_on_line") else None
        if (_crowd and self._language_locked and not getattr(self, "_crowd_asked", False)
                and not getattr(self, "_tv_asked", False) and self._voice_unverified()):
            self._crowd_asked = True
            line = CROWD_LINES.get(self._locked_lang, CROWD_LINES["en-IN"])
            log.info("👥 asking the caller to speak closer / move (%s)", _crowd)
            self._set_tts_language(self._locked_lang)
            self._verbatim_turn = True
            self._fallback_line = line
            self._add_directive(turn_ctx, role="system", content=(
                f"[Your goal for this reply: say ONLY this line and nothing else: \"{line}\"]\n"
                "Do NOT greet or introduce yourself. "
                "Write ONLY the words you speak. Do not repeat this note."
            ))
            return

        self._away_prompts = 0
        self._turn_all_side = False
        self._turn_lang_other = {}
        if self._voice_unverified():
            query = await self._drop_side_language(query.strip(), new_message)
        query = self._drop_noise_segments(query.strip(), new_message)
        # [STT WORDS 21-Oct] known mis-hearings of Tally words, before anyone reads it
        # [30-Oct] the software question may have been cut off ("మీరు ప్రస్తుతం") —
        # the Director's goal for that reply still says "software" (…63698)
        _ctx = " ".join(x for x in (getattr(self, "_last_bot_reply", ""),
                                    getattr(self, "_last_bot_said", ""),
                                    getattr(self, "_last_focus", "")) if x)
        _fixed = fix_stt_words(query, _ctx)
        if _fixed != query:
            log.info("🔤 STT words corrected: %r → %r", query, _fixed)
            query = _fixed
            with contextlib.suppress(Exception):
                new_message.content = [query]

        if not query and self._turn_count > 0:
            # The whole turn was noise — stay silent instead of "please repeat".
            log.info("🔇 turn was only noise — ignored")
            if StopResponse is not None:
                raise StopResponse()

        if not query:
            self._set_tts_language(self._locked_lang)
            self._add_directive(turn_ctx, 
                role="system",
                content="You couldn't hear that clearly. In one line, ask them to repeat.",
            )
            return

        self._turn_count += 1

        # ── Language ─────────────────────────────────────────────────────
        language_only_reply = False          # "Hindi" / "Kannada please" — nothing else
        switched_now = False                 # caller asked for another language this turn
        was_locked = self._language_locked   # call already under way before this turn
        # Opening: "…You signed up for our free trial, right?". The reply to it
        # locks the language only if it names one or is a clear sentence;
        # "yes" / "hello" / "hmm" never do — then we ask the language question
        # once. An unclear answer to THAT (or silence) → Hindi. An unsupported
        # language → Hindi with the bridge line. After the lock only an
        # explicit request from the caller changes the language.
        if not self._language_locked:
            lang, source, ni_name = self._decide_opening_language(query)
            if (lang and source == "detected" and lang != "en-IN"
                    and not self._lang_question_asked):
                # [LANG FIX 21-Oct] one sentence whose language STT only GUESSED is
                # not enough before we have asked: a Telugu "ఏమి మీరు question
                # చెప్పండి" came back in Tamil script, the call was locked to Tamil and
                # the caller had to shout "తెలుగు తెలుగు తెలుగు" (…59214). Ask the
                # language question first; a language they NAME still locks at once.
                log.info("🗣️ Language only guessed from %r (%s) — asking to be sure",
                         query[:40], lang)
                lang, source, ni_name = None, None, None
            if (lang and source == "detected" and self._lang_question_asked
                    and not self._lang_question_heard() and len(query.split()) < 4
                    and self._lang_q_tries < 2):
                # A short reply over the language question is weak evidence: in
                # …58180 Kannada "… problem illa" was labelled Malayalam and locked.
                log.info("🗣️ %r (%s, detected) cut off the language question — asking again",
                         query[:40], lang)
                lang = None
            if lang is None:
                # The question counts only if the caller actually HEARD it. In
                # …58177 "Okay" → question queued, "Yes" 0.8s later cancelled it
                # unheard, and that "Yes" was taken as an unclear answer → Hindi.
                # In …58147 the LLM said "thanks for confirming" instead of it.
                # Now the code speaks it, and an unheard one is asked again.
                heard = self._lang_question_heard()
                if (not (is_wrapup(query) or _WANTS_HUMAN_RE.search(query))
                        and (not self._lang_question_asked
                             or (not heard and self._lang_q_tries < 2))):
                    log.info("🗣️ Language unclear from %r — asking preference (try %d%s)",
                             query[:40], self._lang_q_tries + 1,
                             "" if not self._lang_question_asked else ", last one unheard")
                    # "Hello?" right after the opening: they're checking the line —
                    # reassure, don't greet back or re-introduce (…45647).
                    line = (f"Yes, I can hear you. {LANGUAGE_QUESTION}"
                            if is_presence_check(query) else LANGUAGE_QUESTION)
                    self._ask_language_question(line)
                    if StopResponse is not None:
                        raise StopResponse()
                    self._add_directive(turn_ctx, role="system",
                                        content="(Do not speak this turn. Reply with nothing at all.)")
                    return
                if not (self._lang_question2_asked or is_wrapup(query)
                        or _WANTS_HUMAN_RE.search(query)):
                    # [LANG FIX 16-Oct] still unclear → ask once more, naming the choices
                    # (spoken by the code, like the first question)
                    self._lang_question2_asked = True
                    log.info("🗣️ Language still unclear from %r — asking once more", query[:40])
                    self._ask_language_question(LANGUAGE_QUESTION_2)
                    if StopResponse is not None:
                        raise StopResponse()
                    self._add_directive(turn_ctx, role="system",
                                        content="(Do not speak this turn. Reply with nothing at all.)")
                    return
                # "Yes" / "Okay" in English → English; anything else → Hindi (default)
                lang, source = self._unclear_answer_language(query), "default"
            await self._lock_language(lang, source)
            if ni_name:
                self._hindi_bridge_done = True
                self._verbatim_turn = True
                self._set_tts_language("hi-IN")
                self._add_directive(turn_ctx, role="system", content=(
                    f"[Your goal for this reply: say ONLY this line, warmly, and nothing "
                    f"else: \"{hindi_bridge_line(ni_name)}\"]\n"
                    f"You do NOT speak {ni_name}. NEVER offer or agree to talk in {ni_name}. "
                    "Write ONLY the words you speak, in Hindi. Do not repeat this note."
                ))
                return
            # Otherwise continue the normal flow below, in the locked language.
            language_only_reply = source == "explicit" and len(query.split()) <= 4
        else:
            switched = detect_explicit_language_switch(query)
            ni_asked = (switched is None and names_north_indian_language(query)
                        and has_switch_cue(query))
            if switched and switched in ALLOWED_LANGUAGE_CODES:
                if switched != self._locked_lang:
                    log.info("🔄 Language switch (asked): %s → %s", self._locked_lang, switched)
                    switched_now = True
                await self._lock_language(switched, "explicit")
            elif (self._locked_lang == "en-IN" and self._lang_source in ("default", "detected")
                    and not ni_asked and is_language_evidence(query) and len(query.split()) >= 3
                    and re.search(r"[\u0900-\u0DFF]", query)
                    and normalize_stt_lang(self.last_detected_stt_lang) in ALLOWED_LANGUAGE_CODES
                    and normalize_stt_lang(self.last_detected_stt_lang) != "en-IN"):
                # English was only assumed ("Yes" / "Okay" → English; STT stays on
                # auto-detect). A clear sentence in another language moves the call.
                det = normalize_stt_lang(self.last_detected_stt_lang)
                log.info("🔄 Language follows the caller: en-IN (%s) → %s: %r",
                         self._lang_source, det, query[:50])
                await self._lock_language(det, "detected")
            elif (self._lang_source == "detected" and self._locked_lang == "en-IN"
                  and not ni_asked):
                # [LANG FIX 16-Oct] English was only DETECTED, so STT stayed on
                # auto-detect — and wrote the caller's English "okay, all right" as
                # Bengali "ঠিক আছে" twice; the bot asked the same question 3x (…57941).
                # Two English turns in a row → lock STT to en-IN. Saying "Hindi" /
                # "Telugu" later still switches.
                if normalize_stt_lang(self.last_detected_stt_lang) == "en-IN":
                    self._en_turns += 1
                    if self._en_turns >= 2:
                        log.info("🔒 Language en-IN confirmed by %d English turns — STT locked to English",
                                 self._en_turns)
                        await self._lock_language("en-IN", "confirmed")
                else:
                    self._en_turns = 0
            elif self._lang_source == "default" and not ni_asked:
                # [LANG FIX 12-Oct] the language was only guessed (unclear answer to the
                # language question). The caller's first clear sentence decides it.
                lang, src, ni = self._decide_opening_language(query)
                if lang and not ni and lang != self._locked_lang:
                    log.info("🔄 Language from the caller's words (was a guess): %s → %s",
                             self._locked_lang, lang)
                    await self._lock_language(lang, src)
            if ni_asked and not switched:
                # Asked for a language we don't speak → stay in / move to Hindi.
                ni_name = detect_north_indian_bridge(query, None)
                log.info("🌉 Caller asked for %s → Hindi", ni_name)
                await self._lock_language("hi-IN", "explicit")
                self._verbatim_turn = True
                self._set_tts_language("hi-IN")
                self._add_directive(turn_ctx, role="system", content=(
                    f"[Your goal for this reply: say ONLY this line, warmly, and nothing "
                    f"else: \"{hindi_bridge_line(ni_name)}\"]\n"
                    f"You do NOT speak {ni_name}. NEVER offer or agree to talk in {ni_name}. "
                    "Write ONLY the words you speak, in Hindi. Do not repeat this note."
                ))
                return

        self._set_tts_language(self._locked_lang)
        lang_name = _LANG_NAMES.get(self._locked_lang, "English")

        # ── "Hello?" / "are you there?" mid-call → continue, never restart ──
        # Handled before the Director: a line check is not an answer, so it must
        # not touch the lead state, slot counts or a pending expert offer. We
        # say we're here and repeat the last question they probably missed.
        presence = is_presence_check(query)
        # [GO ON 03-Nov] a filler over a line cut BEFORE its question was heard is
        # "go on", not an answer: carry on with what that line was going to ask
        _cut_said = getattr(self, "_last_bot_said", "") or ""
        go_on = (GO_ON == "on" and not presence and is_go_on(query) and self._last_reply_cut
                 and "?" not in _cut_said)
        if go_on:
            log.info("▶️ %r over a half-said line (%r) — going on with it", query[:30], _cut_said[:50])
        if ((presence or go_on) and was_locked and self._last_reply_cut and self._last_focus
                and not self._closing):
            # [30-Oct] our last reply was cut off, so the last line they HEARD is an
            # old question they already answered: "hello?" got "you use TallyPrime?"
            # again and the caller hung up (…63694). Carry on with what that cut-off
            # reply was going to ask instead.
            acks = PRESENCE_ACK_LINES.get(self._locked_lang, PRESENCE_ACK_LINES["en-IN"])
            ack = acks[self._presence_checks % len(acks)]
            self._presence_checks += 1
            log.info("👋 Presence check %r after a cut-off reply — continuing with: %r",
                     query[:40], self._last_focus[:70])
            self._add_directive(turn_ctx, role="system", content=(
                f"[Your goal for this reply: the customer only checked the line — your last "
                f"reply was cut off and they did not hear it. Do NOT greet or introduce "
                f"yourself. Start with \"{ack}\" and then, in {lang_name}, in one short "
                f"sentence: {self._last_focus}]\n"
                "Write ONLY the words you speak. Do not repeat this note."
            ))
            return
        if (presence and was_locked and self._last_bot_reply
                and not reply_script_is_compliant(last_question_of(self._last_bot_reply) or "",
                                                  self._locked_lang)):
            # [02-Nov …65862] the last line the caller heard was the ENGLISH greeting
            # (the language was set after it): "hello?" repeated it word for word —
            # "Yes, I am here. You signed up for our free trial, right?" — and the
            # caller had to ask "తెలుగులో మాట్లాడతారా?" twice. Say it in the call's
            # language instead.
            acks = PRESENCE_ACK_LINES.get(self._locked_lang, PRESENCE_ACK_LINES["en-IN"])
            ack = acks[self._presence_checks % len(acks)]
            self._presence_checks += 1
            log.info("👋 Presence check %r — last line was in another language, asking it in %s",
                     query[:40], lang_name)
            self._add_directive(turn_ctx, role="system", content=(
                f"[Your goal for this reply: the customer only checked the line. Do NOT greet "
                f"or introduce yourself. Start with \"{ack}\" and then ask, in {lang_name} "
                f"only, in one short sentence, the same thing as this earlier line: "
                f"\"{last_question_of(self._last_bot_reply)}\"]\n"
                "Write ONLY the words you speak. Do not repeat this note."
            ))
            return
        if presence and was_locked and self._last_bot_reply:
            again = last_question_of(self._last_bot_reply)
            if again and not _SENT_END_RE.search(again[-1:]):
                again = _complete_sentences(again)   # never repeat a half sentence
            acks = PRESENCE_ACK_LINES.get(self._locked_lang, PRESENCE_ACK_LINES["en-IN"])
            line = f"{acks[self._presence_checks % len(acks)]} {again}".strip()
            self._presence_checks += 1
            self._verbatim_turn = True
            log.info("👋 Presence check %r — continuing from last line, no re-intro", query[:40])
            self._add_directive(turn_ctx, role="system", content=(
                f"[Your goal for this reply: the customer only checked the line. Do NOT greet "
                f"or introduce yourself. Say ONLY this line and nothing else: \"{line}\"]\n"
                "Write ONLY the words you speak. Do not repeat this note."
            ))
            return

        # ── Live-agent transfer: caller asks for a person, or says yes to the offer ──
        offered, self._transfer_offered = self._transfer_offered, False
        offered_kind, self._offer_kind = self._offer_kind, None
        # "Yes, but call me tomorrow, I'm busy" is NOT a yes to a transfer now.
        later = bool(_CALLBACK_RE.search(query) or busy_is_ambiguous(query))
        accepted = offered and not later and offer_answer(query) == "yes"
        if (accepted and self._last_reply_cut_off(turn_ctx)
                and "consent_reask" not in self._handoffs):
            # "हाँ" said over our "shall I connect you?" (…58148) is a backchannel,
            # not consent — they never heard the question. Ask it once more.
            self._handoffs.add("consent_reask")
            kind = offered_kind or "director"
            line = TRANSFER_CONSENT_LINES[kind].get(
                self._locked_lang, TRANSFER_CONSENT_LINES[kind]["en-IN"])
            log.info("📞 Consent question was cut off — asking again: %r", query[:40])
            self._transfer_offered = True
            self._offer_kind = offered_kind
            self._verbatim_turn = True
            self._fallback_line = line
            self._add_directive(turn_ctx, role="system", content=(
                f"[Your goal for this reply: say ONLY this line and nothing else: \"{line}\"]\n"
                "Write ONLY the words you speak. Do not repeat this note."
            ))
            return
        if accepted or _WANTS_HUMAN_RE.search(query):
            reason = "offer_accepted" if accepted else "caller_asked"
            log.info("📞 Transfer requested (%s): %r", reason, query)
            self._handoff_now(reason, offered_kind if accepted else None)
            if StopResponse is not None:
                raise StopResponse()
            self._add_directive(turn_ctx, role="system",
                                content="(Do not speak this turn. Reply with nothing at all.)")
            return
        # ("समझ नहीं आया" reads as "no" to offer_answer — the नहीं is not a refusal)
        if (offered and not later and did_not_understand(query) and "consent_simple" not in self._handoffs):
            self._handoffs.add("consent_simple")
            line = SIMPLE_CONSENT_LINES.get(self._locked_lang, SIMPLE_CONSENT_LINES["en-IN"])
            log.info("📞 Caller did not understand the transfer offer — asking it simply: %r",
                     query[:40])
            self._transfer_offered = True
            self._offer_kind = offered_kind
            self._verbatim_turn = True
            self._fallback_line = line
            self._add_directive(turn_ctx, role="system", content=(
                f"[Your goal for this reply: say ONLY this line and nothing else: \"{line}\"]\n"
                "Write ONLY the words you speak. Do not repeat this note."
            ))
            return
        if offered:
            log.info("📞 Transfer offer not accepted (%s): %r",
                     offer_answer(query) or "unclear", query[:60])

        # [END CONFIRM 29-Oct] reply to "should I end the call?"
        if getattr(self, "_end_confirm_pending", False):
            self._end_confirm_pending = False
            ans = offer_answer(query)
            if ans == "yes" or is_wrapup(query):
                self._end_confirmed = True
                log.info("👋 end of call confirmed by the caller: %r", query[:60])
                self._closing = True
                self._add_directive(turn_ctx, role="system",
                    content="Customer is wrapping up. Say one warm farewell under eight words and stop.")
                asyncio.create_task(self._hangup())
                return
            log.info("👂 caller wants to go on (%r) — continuing the call", query[:60])

        # ── Wrap-up detection ───────────────────────────────────────────
        # Only hang up on an explicit farewell — never on short replies
        # like "Silver", "okay", "yes" which are common in support calls.
        if (is_wrapup(query) and self._voice_unverified()
                and not getattr(self, "_end_confirmed", False)):
            # [END CONFIRM 29-Oct] the voice is not verified yet — it may be someone
            # beside the caller saying "Thank you" (…63522). Ask once before closing.
            if self._ask_end_confirm(turn_ctx, "farewell", query):
                return
        if is_wrapup(query):
            self._closing = True
            log.info("👋 Closing call — customer said farewell")
            self._add_directive(turn_ctx, 
                role="system",
                content="Customer is wrapping up. Say one warm farewell under eight words and stop.",
            )
            asyncio.create_task(self._hangup())
            return

        # ── Script self-correction ──────────────────────────────────────
        if self._script_violation:
            self._add_directive(turn_ctx, 
                role="system",
                content=(
                    f"Your last reply wasn't in {lang_name}. This reply must be "
                    f"entirely in {lang_name} (native script throughout)."
                ),
            )
            self._script_violation = False

        # ── Director + Reformulate run IN PARALLEL (was sequential) ──────
        # Reformulate does not depend on the Director's output, so we fire both
        # OpenAI calls at once with create_task → saves ~0.9s of wall-clock time.
        history = self._history_for_director(turn_ctx)
        discount = is_discount_query(query)
        if discount and asks_amount(query) and (
                getattr(self, "_discount_answered", False)
                or re.search(r"not\s+giving|no\s+discount|don'?t\s+(?:have|give)|without\s+discount|"
                             r"నో\s*డిస్కౌంట్|डिस्काउंट\s*नहीं|ಡಿಸ್ಕೌಂಟ್\s*ಇಲ್ಲ", query, re.I)):
            # [PRICE 21-Oct b] "tell me the pricing … since you are not giving any discount"
            # (…59277) asks for PRICES — the discount was already answered. It went
            # down the discount path and the LLM invented a two-user price.
            log.info("💰 Pricing query (discount already answered) — prices, not the discount line")
            discount = False
        plans_q  = is_plans_query(query) and not discount and not is_cloud_query(query)
        # Cloud PRICING is answered from CLOUD_FACTS; every other cloud question
        # (what it is, how it works, plans) goes to RAG like any other topic.
        cloud    = is_cloud_query(query) and is_pricing_query(query) and not discount
        pricing  = (asks_amount(query) or plans_q) and not discount and not cloud
        forced_line = False          # True when a fixed canned line must be spoken verbatim

        _unver = self._voice_unverified()
        _extra = (f"CALL_LANGUAGE: {self._locked_lang if self._language_locked else 'not set yet'}\n"
                  f"CALLER_VOICE_VERIFIED: {'no' if _unver else 'yes'}")
        director_task = asyncio.create_task(direct_turn(history, query, self._lead, _extra))
        reform_task   = (
            None if pricing or discount
            else asyncio.create_task(reformulate_query(history, query))
        )

        decision = await director_task
        if _unver:
            with contextlib.suppress(Exception):
                self._log_clues(decision, getattr(self, "_turn_lang_other", None) or {})
        else:
            self._clue_turn = []
        if _unver and is_handover(query):
            _vlh = getattr(self, "_voice_lock", None)
            if _vlh is not None and hasattr(_vlh, "soft_reset"):
                log.info("📱 phone handed over (%r) — soft lock re-seeds on the next voice", query[:60])
                with contextlib.suppress(Exception):
                    _vlh.soft_reset("phone handed over")
        # [LANG CHECK 02-Nov] the caller NAMED the call language; words in another
        # Indian language before the lock are the people around him
        _other = await self._turn_other_language(query) if _unver else None
        if _other and not (is_presence_check(query) or is_reply_to_bot(query)
                           or detect_language_choice(query)):
            _why = (f"{_other[0]} ({100 * _other[1]:.0f}% of the words), call is "
                    f"{self._locked_lang}")
            if LANG_CHECK == "on" and self._lang_source == "explicit":
                log.info("🌐 another language on the line — %s: side talk", _why)
                decision = {**decision, "addressed_to_bot": False}
            else:
                log.info("🌐 [shadow] another language on the line — %s: would be side talk", _why)
        # [SIDE TALK 29-Oct] before the voice lock knows the caller, words clearly NOT
        # said to us (people around the caller, a TV / video) get no reply: …62950 "Hi,
        # we tried to call you multiple times", …63432 a lecture video. At most
        # SIDE_TALK_MAX_STREAK turns in a row, so a real caller is never ignored long.
        if (_unver and getattr(self, "_turn_all_side", False) and SIDE_LANGUAGE == "on"
                and not (is_presence_check(query) or is_reply_to_bot(query)
                         or detect_language_choice(query))):
            log.info("🌐 another language than the caller's — side talk")
            decision = {**decision, "addressed_to_bot": False}
        if (_unver and decision.get("addressed_to_bot") is False
                and getattr(self, "_side_streak", 0) < SIDE_TALK_MAX_STREAK):
            self._side_streak = getattr(self, "_side_streak", 0) + 1
            _vls = getattr(self, "_voice_lock", None)
            if _vls is not None and hasattr(_vls, "note_side_talk"):
                with contextlib.suppress(Exception):
                    _vls.note_side_talk("not said to us")
            log.info("🙉 side talk ignored — not said to us, caller's voice not verified yet "
                     "(%d/%d): %r", self._side_streak, SIDE_TALK_MAX_STREAK, query[:80])
            if reform_task is not None:
                reform_task.cancel()
            with contextlib.suppress(Exception):
                new_message.content = [""]
            if StopResponse is not None:
                raise StopResponse()
            self._add_directive(turn_ctx, role="system",
                                content="(Do not speak this turn. Reply with nothing at all.)")
            return
        self._side_streak = 0
        # [02-Nov] …64733: "చూడు యు హావ్ టు షో యు ఈ పాయింట్స్ ఏంటి అంటే" and "అర్థం కాదా?"
        # (the person beside the caller, teaching someone) were anchored as the
        # caller → the lock's anchors split 42% / 39% and it never locked. A turn
        # the Director could not understand (clarify / rephrase) is not an anchor.
        if (_unver and decision.get("addressed_to_bot") is not False
                and decision.get("next_action") not in ("clarify", "rephrase")
                and self._language_locked and reply_script_is_compliant(query, self._locked_lang)
                and len(query.split()) <= 12):
            self._anchor_turn("answered us in the call language")   # [ANCHOR 29-Oct]
        # [END CONFIRM 29-Oct] closing on an unverified voice → ask first
        if (_unver and decision.get("next_action") in ("close_polite", "close_positive")
                and not getattr(self, "_end_confirmed", False)
                and decision.get("outcome") != "purchased"):
            if reform_task is not None:
                reform_task.cancel()
            if self._ask_end_confirm(turn_ctx, decision.get("next_action"), query):
                return
        # [CALLBACK 21-Oct] "connect me to the expert after five minutes, arrange a call
        # back" (…59277): the bot promised a callback but nothing recorded it. Save it
        # on the call record so the team can act on it.
        if (_CALLBACK_RE.search(query) and (later or decision.get("next_action") == "close_polite"
                                            or decision.get("outcome") == "callback")
                and not getattr(self, "_callback_saved", False)):
            self._callback_saved = True
            log.info("📞 Callback requested — saved on the call record: %r", query[:100])
            try:
                await transcript_collection.update_one(
                    {"call_id": self._call_id},
                    {"$set": {"callback_requested": True, "callback_request": query,
                              "callback_requested_at": now_ist(),
                              "callback_lang": self._locked_lang}},
                    upsert=True,
                )
            except Exception as e:
                log.error("Callback save failed: %s", e)
        # "Busy" right after "which accounting software?" may be the BUSY
        # software or "I'm busy" — ask ONCE which, before the Director's guess
        # (e.g. close the call) is applied.
        software_q, self._software_q_pending = self._software_q_pending, False
        busy_q, self._busy_q_pending = self._busy_q_pending, False
        if (software_q and busy_is_ambiguous(query) and not self._lead.existing_customer
                and self._lead.ask_counts.get("busy_q", 0) < 1):
            self._lead.count_slot("busy_q")
            self._busy_q_pending = True
            log.info("🤔 'busy' after the software question — asking software or busy now: %r",
                     query[:60])
            if reform_task is not None:
                reform_task.cancel()
            line = BUSY_QUESTION_LINES.get(self._locked_lang, BUSY_QUESTION_LINES["en-IN"])
            self._verbatim_turn = True
            self._fallback_line = line
            self._add_directive(turn_ctx, role="system", content=(
                f"[Your goal for this reply: say ONLY this line and nothing else: \"{line}\"]\n"
                "Do NOT greet or introduce yourself. "
                "Write ONLY the words you speak. Do not repeat this note."
            ))
            return
        was_personal = self._lead.is_personal()
        self._lead.apply(decision)   # merge slots; never re-ask a filled one
        if (busy_q and _SOFTWARE_WORD_RE.search(query)
                and not self._lead.current_software):
            # Backup for the Director: answer to "Busy software, or busy now?".
            self._lead.current_software = "Busy"
            log.info("🧾 current software → Busy (answer to the busy question)")
        if str((decision.get("updates") or {}).get("trial_status") or "").strip():
            # Confirmed when it answers our trial question, or the customer said
            # it in their own words ("मैं ट्रायल पर हूँ" — …58148 was asked again).
            self._trial_confirmed = (self._trial_q_pending
                                     or bool(_TRIAL_WORD_RE.search(query)))
        self._trial_q_pending = False
        if not self._lead.existing_customer and says_owns_license(query):
            self._lead.existing_customer = "has Tally license"
            self._lead.current_software = self._lead.current_software or "Tally"
        # Answer to last turn's "free trial or a license?" — backup for the Director.
        # "Silver" alone is enough here (says_owns_license needs "I have …").
        if self._license_q_pending:
            self._license_q_pending = False
            kind, plan = trial_or_license_answer(query)
            if kind == "license" and not self._lead.existing_customer:
                self._lead.existing_customer = f"{plan} license" if plan else "has Tally license"
                self._lead.current_software = self._lead.current_software or "Tally"
            elif (kind == "trial" and not self._lead.existing_customer
                    and self._lead.trial_status is None):
                self._lead.trial_status = "ongoing"
                self._trial_confirmed = True   # answer to our own question
            log.info("🏷️ trial-or-license answer: %s → existing=%s trial=%s", kind or "unclear",
                     self._lead.existing_customer, self._lead.trial_status)
        # Backup for the Director: "we don't do business" / "to become an accountant".
        non_biz = detect_non_business_intent(query)
        if non_biz and not self._lead.existing_customer:
            self._lead.set_personal(non_biz)
        if self._lead.is_personal() and not was_personal:
            log.info("🧭 intent → NOT a business (%s): %r", self._lead.purpose, query[:60])
        if self._lead.existing_customer:
            log.info("🏷️ existing customer: %s", self._lead.existing_customer)
        log.info("🧭 stage=%s branch=%s use=%s missing=%s",
                 self._lead.stage, self._lead.branch, self._lead.use_type,
                 self._lead.missing_slots())
        focus = decision.get("focus") or "Acknowledge them and ask the next relevant question."
        action = decision.get("next_action")
        if decision.get("focus") and not _REPEAT_FOCUS_RE.search(focus):
            self._last_focus = focus          # [30-Oct] for "hello?" after a cut-off reply
        self._turn_action = action
        self._turn_meaning = (decision.get("understanding") or "").strip()
        if self._turn_meaning:
            log.info("💡 meaning: %r", self._turn_meaning[:100])
        if action in ("position_value", "move_to_sales"):
            # No offers exist. "Mention the current offer" in the old script made
            # the bot promise a discount for buying within the trial (…51278).
            focus += " There is NO offer or discount — never mention or hint at one."
        # At most ONE "sorry, say that once more". In …54658 the call was locked to
        # kn-IN from a 2-word fragment; the caller's "yes" came back as "ಎಸ್", the
        # Director chose clarify every turn and the bot asked them to repeat three
        # times in a row → hang-up. On the second unclear turn in a row: if the
        # language was only detected, ask the language question (unlocked, STT on
        # auto-detect; an unclear answer to it → Hindi). Otherwise re-ask the last
        # question in simpler words instead of asking them to repeat again.
        # [30-Oct] "clarify" with a real goal ("ask free trial or license") after a
        # clear answer ("I use TallyPrime") is not an unclear turn: counting it made
        # the bot ask "you use TallyPrime?" right after they said so (…63694, …63698).
        # Only a plain "say that once more" counts.
        _repeat_only = action == "clarify" and (
            not self._turn_meaning or _REPEAT_FOCUS_RE.search(focus or "")
            or _UNCLEAR_MEANING_RE.search(self._turn_meaning))
        if action == "clarify" and not _repeat_only:
            log.info("🎯 clarify with a clear goal — not counted as unclear: %r", focus[:70])
        self._clarify_streak = self._clarify_streak + 1 if _repeat_only else 0
        if _repeat_only and self._clarify_streak >= 2:
            # "Heard", not "asked": in …58180 the question was cut off unheard by
            # a Kannada reply that STT labelled Malayalam, so this never fired
            # and the caller stayed stuck in Malayalam.
            if (self._lang_source == "detected" and not self._lang_question_heard()
                    and self._locked_lang not in ("hi-IN", "en-IN")):
                log.info("🔁 Unclear twice on a detected %s lock — asking language",
                         self._locked_lang)
                await self._unlock_language()
                self._clarify_streak = 0
                self._lang_q_tries = 0
                self._ask_language_question(
                    f"Sorry, I couldn't hear you clearly. {LANGUAGE_QUESTION}")
                if StopResponse is not None:
                    raise StopResponse()
                self._add_directive(turn_ctx, role="system",
                                    content="(Do not speak this turn. Reply with nothing at all.)")
                return
            log.info("🔁 Unclear twice in a row — rephrasing instead of asking to repeat")
            self._turn_action = "rephrase"   # the repeat-request guard now applies
            focus = ("You already asked them to repeat — do NOT ask them to repeat or say "
                     "that once more again. Ask your last question once more in simpler, "
                     "shorter words, as an easy yes/no question. We made this call — do NOT "
                     "ask what they want or need.")
        elif action == "clarify":
            # Outbound call: never "आपको क्या चाहिए?" (call …51121) — the Director's
            # "clarify what they meant" turned into an inbound-style question.
            focus += (" We made this call — do NOT ask what they want or need, or what "
                      "they are calling about. If you didn't understand them, just say "
                      "sorry and ask them to say it once more.")
        if switched_now:
            # Mid-call "speak in Kannada": the switch is already done. The Director
            # once wrote "apologise, you can't speak Kannada" and closed (…58180) —
            # never let it: confirm in the new language and carry on the call.
            if self._lead.branch == "not_interested" and not self._lead.outcome:
                self._lead.branch = None     # a language mix-up is not a "no"
            nxt = self._lead.next_slot()
            focus = (f"The customer asked to talk in {lang_name}. You speak {lang_name} fluently "
                     f"— NEVER say you can't. In {lang_name}, say briefly that you'll continue "
                     f"in {lang_name}, then "
                     + (f"ask about {nxt}." if nxt and not self._lead.existing_customer
                        else "ask how you can help them with TallyPrime today.")
                     + " Do NOT close the call.")
            action = self._turn_action = "ask_discovery"
            log.info("🔄 switch turn — focus overridden: continue in %s", lang_name)
        if language_only_reply:
            # They only named a language — don't "clarify" it or talk about it;
            # pick the call up from the trial question in that language.
            self._lead.count_slot("current_software")
            focus = ("Do NOT mention the language choice. Warmly carry on the call and ask "
                     "which accounting software they are using today.")

        # Repeat-question guard. The Director sometimes re-issues a slot the
        # customer keeps dodging (three identical "GST/billing/inventory?" asks
        # in one call). Count every slot it asks; once a slot is answered or has
        # been asked twice it is closed and we redirect to the next open one.
        _slot = self._lead.slot_in_focus(focus)

        # Not a business → the business script is over for this call. Checked
        # BEFORE the repeat guard below: in call …46038 that guard took the
        # Director's correct "they don't run a business" focus and rewrote it to
        # "ask ONLY about what kind of business they run" / main challenge.
        if (self._lead.is_personal() and not self._lead.existing_customer
                and not pricing and not discount and self._lead.branch != "not_interested"
                and action not in ("answer_question", "transfer_to_expert", "share_payment",
                                   "confirm_demo", "close_positive", "close_polite")):
            asks_business = (_slot in ("business_type", "num_users")
                             or (_slot == "challenges" and action in ("ask_discovery", "clarify"))
                             or action in ("ask_discovery", "greet"))
            if asks_business or (self._lead.is_personal() and not was_personal):
                focus = personal_flow_focus(self._lead)
                self._lead.stage = "decision"
                log.info("🧭 personal flow — focus: %r", focus[:70])
            elif action in ("position_value", "move_to_sales", "offer_demo"):
                self._lead.personal_pitch_done = True
            _slot = None             # nothing left for the repeat guard to police

        # Only police slots on genuine discovery turns — an objection / close /
        # identity answer that merely mentions "software" must not be rewritten
        # into a business question (call …7949: job seeker got "what business?").
        if (_slot and not pricing and not decision.get("asked_question")
                and decision.get("next_action") == "ask_discovery"
                and self._lead.branch != "not_interested"
                and not self._lead.existing_customer):
            if self._lead.is_closed(_slot):
                nxt = self._lead.next_slot()
                if nxt:
                    self._lead.mark_asked(nxt)
                    focus = (f"Do NOT repeat any question already asked. Acknowledge what "
                             f"they said, then ask ONLY about {nxt}.")
                else:
                    focus = ("All discovery questions are done — do not ask any of them "
                             "again. Acknowledge what they said and move the call forward.")
                log.info("🚫 slot '%s' closed — redirected", _slot)
            else:
                self._lead.count_slot(_slot)

        # The opening greeting already played. NEVER let the Director re-introduce —
        # after any interruption or "hello", continue from here, don't restart.
        if decision.get("next_action") == "greet" or "introduc" in focus.lower():
            if self._lead.is_personal():
                focus = ("Do NOT greet or re-introduce yourself — the intro is already done. "
                         + personal_flow_focus(self._lead))
            else:
                missing = self._lead.missing_slots()
                ask = missing[0] if missing else "how they currently manage their accounts"
                focus = (
                    "Do NOT greet or re-introduce yourself — the intro is already done. "
                    f"Warmly acknowledge what they said and ask about {ask}."
                )
        elif presence:
            # A bare "hello" that reached here (e.g. the turn that locked the
            # language) is still not a fresh start.
            focus = ("They only said hello — do NOT greet back or introduce yourself; "
                     "just continue the call. " + focus)
        # An identity answer from the Director may name Avni.
        if "ai assistant" in focus.lower():
            self._allow_intro = True
            self._ai_asked = True    # Director read a bot/AI/human question the regex missed

        # They use Tally (…54427: "Tali Prime") → trial or license decides the
        # whole call, so ask that ONCE before anything else: a trial user carries
        # on with the normal flow, a licensed one never hears about the trial.
        license_q = False
        if (not self._lead.existing_customer and self._lead.trial_status is None
                and self._lead.ask_counts.get("tally_license", 0) < 1
                and (mentions_tally(self._lead.current_software or "")
                     or (mentions_tally(query) and action == "ask_discovery"))
                and not (pricing or discount or cloud) and not decision.get("asked_question")
                and self._lead.branch != "not_interested"
                and action not in ("answer_question", "transfer_to_expert", "share_payment",
                                   "confirm_demo", "close_positive", "close_polite", "clarify")):
            license_q = True
            self._license_q_pending = True
            self._lead.count_slot("tally_license")
            log.info("🏷️ uses Tally (%r) — asking free trial or license", self._lead.current_software)
            focus = ("They told you they use TallyPrime. Briefly acknowledge it, then ask ONLY "
                     "whether they are using it on the free trial, or already have a license — "
                     "like Silver or Gold. No other question.")

        # Already a licensed Tally customer → the trial pitch and the discovery
        # script are pointless. Whatever the Director said, never push the trial
        # or ask script questions; find out what they need, then offer an expert.
        # Questions, pricing, transfer, demo and purchase paths below still win.
        if self._lead.existing_customer and (
                decision.get("next_action") in ("ask_discovery", "position_value",
                                                "move_to_sales", "offer_demo",
                                                "handle_objection", "clarify", "greet")
                or "trial" in focus.lower()):
            self._lead.existing_turns += 1
            lic = self._lead.existing_customer
            if self._lead.existing_turns == 1:
                # Asked once, as the user specified after …54427.
                focus = (f"The customer already has a paid Tally license ({lic}). Do NOT "
                         "mention or offer the free trial and ask NO discovery question. "
                         "Acknowledge their license warmly, then ask ONCE whether there is "
                         "anything they'd like to know about TallyPrime, or any feature they'd "
                         "like to explore — e.g. the latest release, more users or cloud access.")
            else:
                self._transfer_offered = True    # next turn: yes → transfer
                focus = (f"The customer already has a paid Tally license ({lic}). Do NOT "
                         "mention the free trial or ask any discovery question. Respond to "
                         "what they said, then ask if they'd like you to connect them to a "
                         "Tally expert who can help with it; if they need nothing, thank "
                         "them and close politely.")
            log.info("🏷️ existing customer — trial pitch suppressed (turn %d)",
                     self._lead.existing_turns)

        # Transfer moments (trial running, Director's transfer, purchase, demo).
        # The bot never transfers on its own: it ASKS first with a fixed consent
        # line, and only a yes next turn runs _handoff_now() (hold line → transfer).
        transfer_reason = None       # set → this turn speaks a consent question
        consent_kind = None
        trial_kind, trial_focus = ((None, None) if license_q else
                                   self._trial_status_step(decision, action,
                                                           pricing or discount or cloud))
        if trial_kind and trial_kind != "handoff":
            focus = trial_focus
        if trial_kind == "handoff":
            consent_kind = "trial_ongoing"
        elif decision.get("next_action") == "transfer_to_expert":
            ts = self._lead.trial_status if self._trial_confirmed else None
            if ts == "not_started" and not self._lead.existing_customer:
                consent_kind = "trial_not_started"
            elif ts == "ongoing" and not self._lead.existing_customer:
                consent_kind = "trial_ongoing"
            else:
                consent_kind = "director"
            log.info("📞 Director wants a transfer (%s): %r", consent_kind, query)
        elif decision.get("next_action") == "share_payment" or self._lead.outcome == "purchased":
            consent_kind = "purchase"
        elif decision.get("next_action") == "confirm_demo" or self._lead.outcome == "demo_booked":
            consent_kind = "demo"

        if consent_kind and later:
            # "Call me tomorrow / I'm busy now" — never transfer; the Director's
            # callback / close focus stands.
            log.info("📞 Transfer skipped — customer asked for later: %r", query[:60])
            consent_kind = None
        elif (consent_kind and offered and decision.get("next_action") == "transfer_to_expert"
                and offer_answer(query) != "no"):
            # They answered our "shall I connect you?" in words offer_answer()
            # missed, and the Director read it as a yes → that is the consent.
            log.info("📞 Director read a yes to our transfer offer — handing off")
            if reform_task is not None:
                reform_task.cancel()
            self._handoff_now("offer_accepted", offered_kind or consent_kind)
            if StopResponse is not None:
                raise StopResponse()
            self._add_directive(turn_ctx, role="system",
                                content="(Do not speak this turn. Reply with nothing at all.)")
            return
        if consent_kind and f"consent:{consent_kind}" in self._handoffs:
            consent_kind = None          # asked once already — no nagging
        if consent_kind:
            line = TRANSFER_CONSENT_LINES[consent_kind].get(
                self._locked_lang, TRANSFER_CONSENT_LINES[consent_kind]["en-IN"])
            transfer_reason = consent_kind
            self._fallback_line = line
            log.info("📞 Asking consent before transfer (%s)", consent_kind)
            focus = (f"Say ONLY this line, warmly, and nothing else: \"{line}\" Do NOT say you "
                     "are transferring or connecting them yet — you are only asking. Do NOT ask "
                     "for any PIN, card, UPI, email or other details.")

        # ── Pricing: answered directly from CODE, never from RAG ─────────
        # Flow: 1) if user count unknown → ask how many users (decides Silver/Gold).
        #       2) then ask which duration (monthly / yearly / lifetime).
        #       3) only then quote that ONE exact price + GST.
        # ── Discount request → fixed, honest line in the locked language ──
        # Takes priority over pricing/RAG: the bot has no authority to grant or
        # rule out a discount, so it must never improvise here (the old flow
        # flatly answered "no discount" from RAG and lost the lead).
        if transfer_reason:
            # The consent question owns this reply.
            forced_line = True
            if reform_task is not None:
                reform_task.cancel()
        elif discount:
            self._discount_answered = True
            log.info("🏷️ Discount request — fixed expert-handoff line")
            line = DISCOUNT_LINES.get(self._locked_lang, DISCOUNT_LINES["en-IN"])
            forced_line = True
            self._transfer_offered = True    # next turn: yes → transfer
            focus = (
                "The customer asked for a discount. Say ONLY this, warmly and naturally, "
                f"and nothing else: \"{line}\" Do NOT quote any price, do NOT deny a "
                "discount more strongly than this line does, and do NOT promise one."
            )
        elif cloud:
            # Cloud PRICING comes from code, never from RAG.
            log.info("☁️ Cloud pricing query — answering from CLOUD_FACTS")
            forced_line = True
            focus = ("Answer their cloud pricing question using ONLY the cloud facts given. "
                     "Say the rate is per user per month plus GST, and that the minimum is "
                     "three months.")
            if reform_task is not None:
                reform_task.cancel()
            self._add_directive(turn_ctx,
                role="system",
                content=(
                    "The customer asked about CLOUD PRICING. In two or three natural sentences, "
                    "answer using ONLY these facts — never say cloud is included or free, and "
                    "never invent a price.\n"
                    "- Always say the rate is PER USER PER MONTH and add 'plus eighteen percent GST'.\n"
                    "- Always mention the minimum is three months — one month is not available.\n"
                    "- If they told you how many cloud users they need, quote the rate for that "
                    "count (four or more users gets the lower rate); otherwise give both rates "
                    "in one short line.\n"
                    f"{CLOUD_FACTS}"
                ),
            )
        elif pricing:
            editions = named_editions(query)
            if editions:
                # They named the plan ("Gold lifetime?") — quote it; asking "how
                # many users?" first ignores what they said (…57944).
                ed_names = " and ".join(e.upper() for e in editions)
                log.info("💰 Pricing query for %s — quoting it directly", ed_names)
                forced_line = True
                focus = ("Quote the price of the plan they are asking about from the official "
                         "price list, plus eighteen percent GST. Never invent a number.")
                self._add_directive(turn_ctx,
                    role="system",
                    content=(
                        f"The customer mentioned {ed_names} while asking about price. Work out "
