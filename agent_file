    call_start_time = time_module.time()
    # call_id = participant.attributes.get("vici_id") 
    # phone_no = participant.attributes.get("phone_no", "")
   
    # log.info("Participant: %s | call_id: %s | phone: %s",
            #  participant.identity, call_id, phone_no)
   

# ── Per-call log file ────────────────────────────────────────────────


    os.makedirs(LOG_PATH, exist_ok=True)
    log_file = f"{LOG_PATH}/agent_{call_id}.log"
    file_handler = logging.FileHandler(log_file, encoding="utf-8")
    # [CLEAN LOG 16-Oct] mobile number on every line; conversation + errors only
    file_handler.setFormatter(_CallLogFormatter(phone_no, str(call_id)))
    if LOG_MODE != "full":
        file_handler.addFilter(_CallLogFilter())
    logging.getLogger().addHandler(file_handler)

    for _h in logging.getLogger().handlers:
        if _h is not file_handler and _h.level == logging.NOTSET:
            _h.setLevel(logging.INFO)
        if _h is not file_handler and LOG_CONSOLE_MODE != "full":
            # journalctl: same clean view for this call's process
