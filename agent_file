@dataclass
class LeadState:
    """Ground-truth state of the sales call — held in code, never in the LLM."""
    stage:  str = "opening"        # opening → discovery → positioning → decision → closing
    branch: Optional[str] = None   # interested | unsure | not_interested

    # Discovery slots (the five script questions)
    current_software: Optional[str] = None
    use_type:         Optional[str] = None   # business | personal
    business_type:    Optional[str] = None
    challenges:       Optional[str] = None   # GST / billing / inventory / reports
    num_users:        Optional[str] = None

    # Why a non-business caller wants Tally ("learning / accountant career",
    # "personal accounting"). Set together with use_type="personal".
    purpose:          Optional[str] = None
    personal_pitch_done: bool = False        # value + purchase question said once

    # Already a paying Tally customer (e.g. "Gold license"). Once set, the
    # free-trial pitch and the discovery script are OFF for the rest of the call
    # (call …41663: Gold-license CA was pushed the trial three times).
    existing_customer: Optional[str] = None
    existing_turns:    int = 0               # existing-customer turns handled

    # Where the customer is with the free trial — decides the pitch once
    # discovery is done: not_started → pitch the trial, ongoing → expert
    # transfer, finished → pitch the license.
    trial_status:      Optional[str] = None  # not_started | ongoing | finished

    # Outcomes
    demo_datetime:  Optional[str] = None
    decline_reason: Optional[str] = None
    outcome:        Optional[str] = None     # purchased | demo_booked | declined | callback

    # Question-first conversation control. The customer keeps the floor for as
    # long as they have questions; discovery only resumes once they're done.
    awaiting_more_questions: bool = False   # we asked "anything else?" — waiting
    discovery_announced:     bool = False   # bridge line already said once
    ask_counts: dict = field(default_factory=dict)   # slot -> times we asked it

    _DISCOVERY = ("current_software", "use_type", "business_type", "challenges", "num_users")
    # Meaningless once the caller says they don't run a business (call …46038:
    # "हम बिजनेस नहीं करते" was followed by "कितने users?").
    _BUSINESS_ONLY = ("business_type", "challenges", "num_users")

    def is_personal(self) -> bool:
        return self.use_type == "personal"

    def applicable_slots(self) -> tuple:
        if self.is_personal():
            return ()          # no business qualification — straight to value / purchase
        return self._DISCOVERY

    def snapshot(self) -> dict:
        snap = asdict(self)
        if self.is_personal():
            snap["mode"] = f"NOT a business — wants Tally for: {self.purpose or 'personal use'}"
            snap["not_applicable"] = list(self._BUSINESS_ONLY)
        return snap

    @staticmethod
    def _norm_use_type(v) -> Optional[str]:
        low = str(v or "").lower()
        if not low:
            return None
        if any(w in low for w in ("personal", "learn", "student", "study", "job", "career",
                                  "accountant", "no business", "not business", "non-business",
                                  "not a business", "individual")):
            return "personal"
        if "business" in low or "shop" in low or "company" in low or "firm" in low:
            return "business"
        return None

    def set_personal(self, purpose: Optional[str]) -> bool:
        """Customer says they don't run a business. Returns True if this changed the state."""
        changed = self.use_type != "personal"
        self.use_type = "personal"
        # A specific reason ("learning / accountant career") replaces the generic one.
        if purpose and (not self.purpose or self.purpose.startswith("personal accounting")):
            self.purpose = purpose
        return changed

    def discovery_complete(self) -> bool:
        if self.is_personal():
            return True
        filled = sum(getattr(self, s) is not None for s in self._DISCOVERY)
        return filled >= 3

    def missing_slots(self) -> list:
        labels = {
            "current_software": "current accounting software",
            "use_type":         "business or personal use",
            "business_type":    "type of business",
            "challenges":       "main challenges (GST, billing, inventory, reports)",
            "num_users":        "number of users",
        }
        return [labels[s] for s in self.applicable_slots() if getattr(self, s) is None]

    def profile_for_actor(self) -> str:
        """What the customer has already told us, for the voice LLM's every turn.

        The voice LLM only ever saw the current turn's goal, so it forgot what
        the customer said two turns ago and fell back to business questions.
        """
        facts = []
        if self.is_personal():
            facts.append(f"They do NOT run a business — they want Tally for "
                         f"{self.purpose or 'personal accounting'}.")
        elif self.use_type:
            facts.append(f"Use: {self.use_type}.")
        for slot, label in (("business_type", "Business"), ("current_software", "Current software"),
                            ("challenges", "Main interest / challenge"), ("num_users", "Users")):
            val = getattr(self, slot)
            if val and not (self.is_personal() and slot in self._BUSINESS_ONLY):
                facts.append(f"{label}: {val}.")
        if self.existing_customer:
            facts.append(f"Already has a Tally license: {self.existing_customer}.")
        if self.trial_status:
            facts.append("Free trial: " + {"not_started": "not started yet",
                                           "ongoing": "using it right now",
                                           "finished": "already used / over"}[self.trial_status] + ".")
        if not facts:
            return ""
        out = ("WHAT THE CUSTOMER HAS ALREADY TOLD YOU (remember it; never ask it again or "
               "contradict it):\n- " + "\n- ".join(facts))
        if self.is_personal():
            out += ("\nNEVER ask this customer about their business type, number of users or "
                    "business challenges — they have no business.")
        return out

    def next_slot(self) -> Optional[str]:
        """First unfilled slot we haven't already asked twice.

        Enforced in code, not in the prompt: a slot the customer has dodged
        twice is closed for good, so we can never loop the same question.
        """
        labels = {
            "current_software": "which accounting software they use today",
            "use_type":         "whether it's for business or personal use",
            "business_type":    "what kind of business they run",
            "challenges":       "their main challenge — GST, billing, inventory or reports",
            "num_users":        "how many users need access",
        }
        if self.existing_customer:
            return None       # licensed customer — no script questions
        for s in self.applicable_slots():
            if getattr(self, s) is None and self.ask_counts.get(s, 0) < 2:
                return labels[s]
        return None

    # Keywords that identify which discovery slot a Director "focus" is asking about.
    _SLOT_KEYWORDS = {
        # No bare "tally"/"software": almost every focus mentions Tally, so
        # "ask their challenges with Tally" was matched as current_software and
        # rewritten (call …41663, four wrong redirects in one call).
        "current_software": ("accounting software", "which software", "what software",
                             "any software", "accounting system"),
        "use_type":         ("personal", "business or personal"),
        "business_type":    ("type of business", "kind of business", "what business"),
        "challenges":       ("challenge", "gst", "billing", "inventory", "report",
                             "difficulty", "problem", "dikkat"),
        "num_users":        ("how many user", "number of user", "users"),
    }

    def slot_in_focus(self, focus: str) -> Optional[str]:
        """Which discovery slot the Director's focus is asking about, if any."""
        low = (focus or "").lower()
        for slot, words in self._SLOT_KEYWORDS.items():
            if any(w in low for w in words):
                return slot
        return None

    def is_closed(self, slot: str) -> bool:
        return getattr(self, slot) is not None or self.ask_counts.get(slot, 0) >= 2

    def count_slot(self, slot: str) -> None:
        self.ask_counts[slot] = self.ask_counts.get(slot, 0) + 1

    def mark_asked(self, slot_label: str) -> None:
        """Record that we just asked the slot `next_slot()` returned."""
        labels = {
            "which accounting software they use today":   "current_software",
            "whether it's for business or personal use":  "use_type",
            "what kind of business they run":             "business_type",
            "their main challenge — GST, billing, inventory or reports": "challenges",
            "how many users need access":                 "num_users",
        }
        key = labels.get(slot_label)
        if key:
            self.ask_counts[key] = self.ask_counts.get(key, 0) + 1

    def apply(self, decision: dict) -> None:
        """Merge a Director decision — only fills, never overwrites with blanks.

        Exception: use_type follows the customer's latest statement. In call
        …46038 a garbled first answer set use_type="business"; the customer's
        "हम बिजनेस नहीं करते" could never correct it, so the business script
        (type of business, number of users) kept running.
        """
        updates = decision.get("updates") or {}
        for k, v in updates.items():
            if k == "trial_status":
                # Latest statement wins ("not started" → later "I started it today").
                ts = str(v or "").strip().lower().replace(" ", "_").replace("-", "_")
                if ts in ("not_started", "ongoing", "finished"):
                    self.trial_status = ts
                continue
            if k == "use_type":
                new = self._norm_use_type(v)
                if new == "personal":
                    self.set_personal(updates.get("purpose") or str(v))
                elif new == "business":
                    self.use_type = "business"
                continue
            if k in self.__dataclass_fields__ and v and getattr(self, k) is None:
                setattr(self, k, str(v))
        br = decision.get("branch")
        if br in ("interested", "unsure", "not_interested"):
            self.branch = br
        stg = decision.get("stage")
        if stg:
            self.stage = stg
        dt = decision.get("demo_datetime")
        if dt:
            self.demo_datetime = str(dt)
        out = decision.get("outcome")
        if out in ("purchased", "demo_booked", "declined", "callback"):
            self.outcome = out


