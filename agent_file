def _gate_vad(inner_vad, voice_lock):
    """[SPEAKER LOCK] LiveKit's VAD hears the RAW phone audio, so a person beside
    the caller could pause / interrupt the bot. This wrapper feeds the VAD silence
    while the bot is speaking, unless the lock has just passed the CUSTOMER's voice."""
    if voice_lock is None or not hasattr(voice_lock, "vad_should_mute"):
        return inner_vad
    try:
        from livekit.agents import vad as _lk_vad

        class _LockGatedVAD(_lk_vad.VAD):
            def __init__(self, inner, lock):
                super().__init__(capabilities=inner.capabilities)
                self._inner = inner
                self._lock = lock
                try:
                    inner.on("metrics_collected",
                             lambda *a: self.emit("metrics_collected", *a))
                except Exception:
                    pass

            @property
            def model(self):
                return getattr(self._inner, "model", "unknown")

            @property
            def provider(self):
                return getattr(self._inner, "provider", "unknown")

            def stream(self, *args, **kwargs):
                s = self._inner.stream(*args, **kwargs)
                push = s.push_frame
                lock = self._lock

                def push_frame(frame):
                    try:
                        if lock.vad_should_mute():
                            frame = rtc.AudioFrame(
                                data=bytes(frame.samples_per_channel * frame.num_channels * 2),
                                sample_rate=frame.sample_rate,
                                num_channels=frame.num_channels,
                                samples_per_channel=frame.samples_per_channel,
                            )
                    except Exception:
                        pass
                    push(frame)

                try:
                    s.push_frame = push_frame
                except Exception as e:
                    log.warning("VAD gate could not hook the stream: %s", e)
                return s

        log.info("🛡️ VAD gate on — while the bot speaks only the customer's voice can pause it")
        return _LockGatedVAD(inner_vad, voice_lock)
    except Exception as e:
        log.warning("VAD gate unavailable (%s) — running with the plain VAD", e)
        return inner_vad


def _build_turn_handling():
    # livekit-agents 1.7 reads ONLY the nested keys below. The old flat form
    # (min_endpointing_delay=..., min_interruption_duration=...) was silently
    # ignored, so every call ran on library defaults (max wait 2.5s).
    th = agents.TurnHandlingOptions(
        endpointing={
            "min_delay": MIN_ENDPOINTING_DELAY,
            "max_delay": MAX_ENDPOINTING_DELAY,
        },
        interruption={
            "enabled": True,
            "min_duration": MIN_INTERRUPTION_DURATION,
            "min_words": MIN_INTERRUPTION_WORDS,
            "false_interruption_timeout": 1.5,
            "resume_false_interruption": True,
        },
        preemptive_generation={"enabled": False},
    )
    log.info("🚦 endpointing min=%.2fs max=%.2fs | interruption min=%.2fs words=%d | "
             "preemptive_generation disabled",
             MIN_ENDPOINTING_DELAY, MAX_ENDPOINTING_DELAY,
             MIN_INTERRUPTION_DURATION, MIN_INTERRUPTION_WORDS)
    return th


async def Digital_agent_logic_vishnu(ctx: JobContext, candidate_data: dict):
