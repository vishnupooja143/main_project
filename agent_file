class _CallLogFilter(logging.Filter):
    """conversation mode: keep the conversation, call events and real errors."""

    def filter(self, record: logging.LogRecord) -> bool:
        try:
            msg = record.getMessage()
        except Exception:
            return True
        if any(d in msg for d in _LOG_DROP):
            return False
        if any(k in msg for k in _LOG_KEEP):
            return True
        if record.levelno >= logging.ERROR:
            return True
        if record.levelno >= logging.WARNING:
            low = msg.lower()
            return any(w in low for w in _LOG_PROBLEM)
        return False


class _CallLogFormatter(logging.Formatter):
    """time | mobile | LEVEL | message, with the conversation lines labelled."""

    def __init__(self, phone: str, call_id: str):
        super().__init__(datefmt="%Y-%m-%d %H:%M:%S")
        self.phone, self.call_id = phone or "Unknown", call_id or "?"

    def format(self, record: logging.LogRecord) -> str:
        msg = record.getMessage()
        if msg.startswith("[user] "):
            msg = "👤 CUSTOMER : " + msg[7:]
        elif msg.startswith("[assistant] "):
            msg = "🤖 BOT      : " + msg[12:]
        elif msg.startswith("[assistant:"):
            tag, _, rest = msg[11:].partition("] ")
            msg = f"🤖 BOT ({tag}) : {rest}"
        line = (f"{self.formatTime(record, self.datefmt)} | 📱 {self.phone} | "
                f"{record.levelname:<7} | {msg}")
        if record.exc_info:
            line += "\n" + self.formatException(record.exc_info)
        return line

