    r"(?:കണക്ട്|ട്രാൻസ്ഫർ|connect|transfer)\s*(?:ചെയ്യ|ചെയ്)",
    re.I,
)

# The bot's OWN reply promising a hand-off ("I'll connect you with our expert").
# The LLM sometimes says this unprompted (e.g. "never guess → connect to expert"),
# in any language — if it did, the transfer MUST actually happen.
_PROMISED_TRANSFER_RE = re.compile(
    r"(?:connect|transfer|कनेक्ट|ट्रांसफर|जोड़|ಕನೆಕ್ಟ್|ಟ್ರಾನ್ಸ್‌?ಫರ್|కనెక్ట్|ట్రాన్స్‌?ఫర్|"
    r"கனெக்ட்|டிரான்ஸ்பர்|கணெக்ட்|കണക്ട്|ട്രാൻസ്ഫർ)",
    re.I,
)
_PROMISED_TARGET_RE = re.compile(
    r"expert|specialist|एक्सपर्ट|ಎಕ್ಸ್‌?ಪರ್ಟ್|ఎక్స్‌?పర్ట్|எக்ஸ்பர்ட்|എക്സ്പർട്ട്", re.I,
)


def reply_promises_transfer(text: str) -> bool:
    """True when the spoken reply is a statement (not an offer) that we're connecting them."""
    if not text or "?" in text:
        return False          # "Shall I connect you?" is an offer, not a promise
    return bool(_PROMISED_TRANSFER_RE.search(text) and _PROMISED_TARGET_RE.search(text))


def reply_offers_transfer(text: str) -> bool:
    """True when the spoken reply ASKS whether to connect them to an expert."""
    return bool(text and "?" in text
                and _PROMISED_TRANSFER_RE.search(text) and _PROMISED_TARGET_RE.search(text))

# Answer to the discount line's "Shall I connect you with our expert?"
_OFFER_YES = {"yes", "yeah", "yep", "sure", "ok", "okay", "haan", "han", "haa", "haanji", "please",
              "connect", "हाँ", "हां", "ठीक", "ಹೌದು", "ಸರಿ", "ಆಯ್ತು", "అవును", "సరే", "ஆமா", "ஆம்",
              "சரி", "അതെ", "ശരി"}
_OFFER_NO = {"no", "nope", "nah", "not", "dont", "don't", "nahi", "nahin", "nai", "na", "नहीं", "नही",
             "ना", "मत", "illa", "beda", "ಇಲ್ಲ", "ಬೇಡ", "vaddu", "ledu", "వద్దు", "లేదు", "illai",
             "vendam", "இல்லை", "வேண்டாம்", "ഇല്ല", "വേണ്ട"}
_OFFER_YES_RE = re.compile(r"go\s*ahead|please\s+do|कर\s*(?:दो|दीजिए|दीजिये)|जोड़\s*(?:दो|दीजिए)", re.I)


def offer_answer(text: str) -> Optional[str]:
    """'yes' / 'no' / None (a question or anything unclear)."""
    if "?" in text:
        return None
    toks = {t for t in re.split(r"[\s,.।!;:\"'()\-]+", text.lower()) if t}
    if toks & _OFFER_NO:
        return "no"
    if toks & _OFFER_YES or _OFFER_YES_RE.search(text):
        return "yes"
    return None


async def search_knowledge_base(
    query: str,
    n_results: int = RAG_TOP_K,
    lang_code: Optional[str] = None,
) -> Optional[str]:
    """
    Ask the shared RAG service (rag_service.py) for the top knowledge-base
    chunks. Language filter, fallback and script filter happen there.
    Returns a formatted context string for injection into the system prompt,
    "" if the knowledge base has nothing, or None if the service is down/slow —
    a service failure is NOT "we don't know the answer".
    """
    try:
        session = await get_http_session()
        async with session.post(
            f"{RAG_SERVICE_URL}/search",
            json={"query": query, "lang_code": lang_code, "n_results": n_results},
            timeout=aiohttp.ClientTimeout(total=RAG_TIMEOUT),
        ) as resp:
            if resp.status != 200:
                log.error("RAG service returned HTTP %d — continuing without RAG", resp.status)
                return None
            data = await resp.json()
            return data.get("context", "")
    except asyncio.TimeoutError:
        log.error("RAG service timed out after %.1fs — continuing without RAG", RAG_TIMEOUT)
        return None
    except Exception as e:
        log.error("RAG service unavailable (%s) — continuing without RAG", e)
        return None


async def _warm_llm(llm_instance) -> None:
    try:
        ctx = ChatContext()
        ctx.add_message(role="user", content="hi")
        stream = llm_instance.chat(chat_ctx=ctx)
        try:
            async for _ in stream:
                break
        finally:
            await stream.aclose()
        log.info("✅ LLM pre-warmed")
    except Exception as e:
        log.warning("LLM pre-warm failed: %s", e)


