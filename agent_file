def machine_words_alone(text: str):
    """[MACHINE HANGUP] words that alone prove a machine (no sound flag needed)."""
    t = text or ""
    return [m.group(0) for rx in _MACHINE_ALONE for m in [rx.search(t)] if m]


def machine_words(text: str):
    """[MACHINE HANGUP] ("strong" | "weak" | None, [matched words]) for a transcript."""
    t = text or ""
    strong = [m.group(0) for rx in _MACHINE_STRONG for m in [rx.search(t)] if m]
    if strong:
        return "strong", strong
    weak = [m.group(0) for rx in _MACHINE_WEAK for m in [rx.search(t)] if m]
    return ("weak", weak) if weak else (None, [])


def machine_verdict(text: str, lines_through: int):
    """[MACHINE HANGUP] (is_machine, why). Strong words → machine. Weak words ("busy",
    "try later" — a person says them too) count only when the voice ALSO talked through a
    SECOND bot line (a person stops to listen; a recording does not)."""
    kind, words = machine_words(text)
    if kind == "strong":
        return True, f"operator/voicemail words {words}"
    if kind == "weak" and lines_through >= 2:
        return True, f"weak words {words} + talked through {lines_through} bot line(s)"
    return False, (f"only weak words {words}" if words else "no machine words")


async def transcribe_audio(pcm, sr: int, wait_s: float = 4.0):
    """[MACHINE HANGUP] (transcript, language_code) of one audio piece via Sarvam REST, or ("", None)."""
    try:
        form = aiohttp.FormData()
        form.add_field("file", _pcm_to_wav(pcm, sr), filename="machine.wav", content_type="audio/wav")
        form.add_field("model", "saaras:v3")
        form.add_field("mode", "transcribe")
        form.add_field("language_code", "unknown")
        http = await get_http_session()
        async with http.post(
                _LANG_CHECK_URL, data=form, headers={"api-subscription-key": SARVAM_API_KEY},
                timeout=aiohttp.ClientTimeout(total=wait_s)) as r:
            if r.status != 200:
                log.info("🤖 machine word check HTTP %s", r.status)
                return "", None
            j = await r.json()
        return (j.get("transcript") or "").strip(), j.get("language_code")
    except Exception as e:
        log.info("🤖 machine word check failed: %s", e)
        return "", None
_CUT_OFF_ECHO_RE = re.compile(r"\s*\[\s*cut off[^\]]*\]?", re.I)
_SENT_END_RE = re.compile(r"[.?!।]")


def _norm_line(t: str) -> str:
    """Compare two spoken lines ignoring case, spaces and punctuation."""
    return re.sub(r"[\s.,!?।—–\-:;'\"]+", "", (t or "").lower())


def _complete_sentences(t: str) -> str:
    """Text up to the last sentence end ('' if there is none)."""
    ends = [m.end() for m in _SENT_END_RE.finditer(t or "")]
    return t[:ends[-1]].strip() if ends else ""


