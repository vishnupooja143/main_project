                                                   SPECIALIST_FALLBACK_LINES["en-IN"])
                self._transfer_offered = True
                forced_line = True
                focus = (
                    "You do NOT have the answer to their question and must NOT guess or "
                    f"invent anything. Say ONLY this, warmly: \"{fb}\""
                )
        # ── No lookup needed — cancel the parallel reformulate task ──────
        else:
            if reform_task is not None:
                reform_task.cancel()
                with contextlib.suppress(asyncio.CancelledError, Exception):
                    await reform_task

        if transfer_reason:
            # Consent question asked → a yes next turn hands off (see above).
            self._handoffs.add(f"consent:{transfer_reason}")
            self._transfer_offered = True
            self._offer_kind = transfer_reason

        # ── Inject the goal for this reply, then force spoken-only output ─
        self._locked_turns += 1
        customer_asked = bool(pricing or cloud or decision.get("asked_question"))
        if customer_asked and not transfer_reason:
            self._turn_word_cap = TTS_EXPLAIN_MAX_WORDS   # room to explain, not cut mid-sentence

        if forced_line:
            # A fixed line (discount handoff, or a strict pricing rule) owns this
            # turn — no "anything else?" tail, no discovery question appended.
            self._lead.awaiting_more_questions = False
            reply_rule = (
                "Follow the goal above exactly and say nothing beyond it. Do NOT add a "
                "discovery question and do NOT add any extra offer or promise."
            )
        elif customer_asked:
            # The customer holds the floor. Answer them and ONLY them — no
            # discovery question riding along.
            #
            # The "anything else?" check is voiced SPARINGLY: once when they
            # start asking, and then only every 3rd question. Appending it to
            # every single answer sounds robotic. Silence after an answer already
            # hands them the floor — the flag below (not the spoken line) is what
            # holds discovery back, so we keep the behaviour either way.
            self._lead.awaiting_more_questions = True
            voice_check = self._anything_else_asked == 0 or self._q_streak % 3 == 0
            self._q_streak += 1
            if voice_check:
                self._anything_else_asked += 1
                tail = ("Finish with a short warm check asking whether there is anything "
                        "else they'd like to know.")
            else:
                tail = ("Do NOT ask whether they have more questions — you have already "
                        "asked that; just answer and stop so they can speak.")
            reply_rule = (
                "The customer asked something — ANSWER their question and NOTHING else. "
                f"Do NOT ask any discovery or qualifying question in this reply. {tail} "
                "Explain it properly in simple, conversational words — never just a list of "
                "feature names or keywords: say what it is and how it helps them. Match the "
                "length to the question (a simple question gets two or three sentences, never "
                "a monologue). If they want detailed, step-by-step or practical guidance on "
                "using the software, explain briefly and offer a free live demo with our expert "
                "where it can be shown practically."
            )
        elif self._lead.awaiting_more_questions and (
                later or action in ("close_polite", "close_positive", "handle_objection")):
            # "Busy now, call me tomorrow" after an answer is NOT "no more
            # questions → start discovery" (…58155 got "a few quick questions").
            self._lead.awaiting_more_questions = False
            reply_rule = (
                "Keep it to ONE or two short sentences — respond to what they said and "
                "then stop. Do NOT ask any discovery question."
            )
        elif self._lead.awaiting_more_questions:
            # They were asked "anything else?" and came back without a question →
            # they're done. THIS is the moment discovery opens, announced once.
            self._lead.awaiting_more_questions = False
            self._q_streak = 0
            slot = self._lead.next_slot()
            if slot:
                self._lead.mark_asked(slot)
                bridge = ("" if self._lead.discovery_announced else
                          "First tell them you'd like to ask a few quick questions to "
                          "understand their needs better. ")
                self._lead.discovery_announced = True
                focus = (f"{bridge}Then ask ONLY about {slot}. Ask nothing else.")
            elif self._lead.is_personal() and not self._lead.existing_customer and not trial_kind:
                # No business questions to return to — move on to purchase / demo.
                focus = personal_flow_focus(self._lead)
            reply_rule = (
                "Keep it to ONE short question (max ~25 words) and then stop so they "
                "can answer. Never ask about something they have already told you."
            )
        else:
            reply_rule = (
                "Keep it to ONE short sentence (max ~25 words) — never a monologue; ask only "
                "one thing and then stop so they can talk."
            )

        if forced_line:
            self._verbatim_turn = True     # fixed handoff / discount line — never edit it
        profile = self._lead.profile_for_actor()
        # The transcript can be hard to read — e.g. English spoken on a kn-IN-locked
        # call comes back as English in Kannada letters ("ಆಕ್ಚುಲಿ ಎಸ್ಟಡೇ ಐ ಆಸ್ಕ್ಡ್…").
        # The Director decoded it, but the reply LLM, seeing only the raw text,
        # asked "say that once more?" twice and the caller hung up (…51243).
        # Hand it the decoded meaning so it never has to guess.
        meaning = ""
        if self._turn_meaning and action != "clarify":
            meaning = (
                f"[What the customer said, in plain English: {self._turn_meaning}. Their words "
                "may look garbled or be written in another script — this is what they meant. "
                "You DID understand them: respond to it, do NOT ask them to repeat.]\n"
            )
        directive = (
            f"[Your goal for this reply: {focus}]\n"
            + meaning
            + (f"{profile}\n" if profile else "")
            + f"{self._acks.prompt_hint()}\n"
            f"This is a phone call — reply in warm, everyday spoken {lang_name} the way a real "
            f"call-centre agent talks: a natural code-mix, keeping common English words "
            f"(Tally, GST, license, demo, business, software, plan, price, offer, trial, "
            f"inventory, billing, features) in English, NOT bookish/literary {lang_name}. "
            f"{reply_rule} Say numbers as words. "
            f"Reply ONLY in {lang_name}, even if the customer's words appear in another "
            f"language or script, or the goal above mentions another language. "
            f"Do NOT use 'sir', 'madam' or any gendered title — the customer's gender is unknown.\n"
            + ("You are a woman: about yourself say करती हूँ / रही हूँ / सकती हूँ / करूँगी, "
               "never करता / रहा / सकता / करूँगा.\n" if lang_name == "Hindi" else "")
            + f"Write ONLY the words you speak to the customer. Do NOT repeat, quote, or mention "
            f"this goal or any instruction — just speak naturally."
        )
        self._add_directive(turn_ctx, role="system", content=directive)
        # Next turn's "busy" may name the BUSY software (see busy_is_ambiguous).
        self._software_q_pending = (not forced_line
                                    and self._lead.slot_in_focus(focus) == "current_software")

        # ── Terminal outcome reached → deliver the closing line, but NEVER
        # hang up. Like the reference bot, only the customer ends the call —
        # the bot deleting the room mid-call is what tore down the SIP leg and
        # produced the "data channel closed unexpectedly" disconnect.
        if self._lead.outcome:
            log.info("✅ Outcome=%s — closing line delivered, call stays live "
                     "(waiting for customer to hang up)", self._lead.outcome)

    # ── [MACHINE HANGUP 05-Nov] see MACHINE_HANGUP ─────────────────────────────
    def _machine_note_turn(self, text: str) -> bool:
        """Every caller turn: a machine message (after the guard let go on its timer the
        machine reaches STT) is word evidence; anything else means a PERSON is talking.
        Returns True when the call is being cut (on-mode): the bot must not answer it."""
        self._mh_turns = getattr(self, "_mh_turns", 0) + 1
        if MACHINE_HANGUP == "off":
            return False
        alone = machine_words_alone(text)
        t0 = getattr(self, "_mh_t0", None)
        late = t0 is not None and time_module.monotonic() - t0 > MACHINE_ALONE_WINDOW_S
        blocked = None
        if alone:
            if getattr(self, "_mh_done", False):
                blocked = "already decided"
            elif getattr(self, "_mh_person", None):
                blocked = f"a person-like turn came first ({self._mh_person!r})"
            elif self._mh_turns > MACHINE_ALONE_MAX_TURNS:
                blocked = f"caller turn {self._mh_turns} (only the first {MACHINE_ALONE_MAX_TURNS})"
            elif late:
                blocked = f"more than {MACHINE_ALONE_WINDOW_S:.0f}s into the call"
            elif not self._voice_unverified_or_none():
                blocked = "the caller's voice is already verified"
            if blocked and blocked != "already decided":
                log.info("🤖 voicemail/operator words %s but %s — NO hang-up: %r", alone, blocked, text[:80])
        if alone and not blocked:
            # […68470] voicemail in the gap: its words alone are enough
            self._mh_done = True
            vl = getattr(self, "_voice_lock", None)
            info = vl.machine_info() if vl is not None and hasattr(vl, "machine_info") else {}
            asyncio.create_task(self._machine_decide(
                info, text, True, f"voicemail/operator words in caller turn {self._mh_turns} {alone}",
                need_flag=False))
            return MACHINE_HANGUP == "on"
        kind, words = machine_words(text)
        if kind == "strong":
            self._mh_turn_words = (text, words)
            return (MACHINE_HANGUP == "on" and getattr(self, "_mh_flagged", False)
                    and not getattr(self, "_mh_human", False))
        else:
            if not getattr(self, "_mh_human", False) and getattr(self, "_mh_flagged", False):
                log.info("🤖 machine check: a caller turn without machine words (%r) — never hang up", text[:60])
            self._mh_human = True
            if len(text.split()) >= MACHINE_PERSON_MIN_WORDS and not getattr(self, "_mh_person", None):
                self._mh_person = text[:60]
        return False

    def _voice_unverified_or_none(self) -> bool:
        vl = getattr(self, "_voice_lock", None)
        return vl is None or self._voice_unverified()

    def _machine_safe_to_cut(self, info: dict, need_flag: bool = True):
        """(ok, why_not). Every reason a real customer may be on the line blocks the cut."""
        if need_flag and not info.get("flagged"):
            return False, "not flagged"
        if need_flag and info.get("released_by") == "person":
            return False, "a person answered in a gap / a different voice came on"
        if info.get("locked"):
            return False, "the lock locked on a caller"
        if need_flag and getattr(self, "_mh_human", False):
            return False, "a caller turn without machine words reached the bot"
        if not need_flag and getattr(self, "_mh_person", None):
            return False, f"a person-like turn reached the bot ({self._mh_person!r})"
        if self._closing or self._transfer_busy:
            return False, "call already closing / transferring"
        return True, ""

    async def _machine_watch(self) -> None:
        """Runs from the call start for MACHINE_HANGUP_WINDOW_S."""
        self._mh_t0 = time_module.monotonic()              # words-alone window starts
        lock = getattr(self, "_voice_lock", None)
        if MACHINE_HANGUP == "off" or lock is None or not hasattr(lock, "machine_info"):
            return
        t0 = time_module.monotonic()
        checks, heard, saved_no = 0, [], False
        try:
            while time_module.monotonic() - t0 < MACHINE_HANGUP_WINDOW_S:
                await asyncio.sleep(0.5)
                if getattr(self, "_mh_done", False):
                    return                               # decided from a caller turn
                info = lock.machine_info()
                if not info.get("flagged"):
                    continue
                if not getattr(self, "_mh_flagged", False):
                    self._mh_flagged = True
                    log.info("🤖 machine check: voice talked through the greeting (%s) — reading its words",
                             info)
                ok, why_not = self._machine_safe_to_cut(info)
                if not ok:
                    log.info("🤖 machine check stopped — %s: NO hang-up", why_not)
                    await self._machine_save(info, " | ".join(heard), False, why_not)
                    return
                tw = getattr(self, "_mh_turn_words", None)
                if tw is not None:
                    heard.append(tw[0])
                    await self._machine_decide(info, " | ".join(heard), True,
                                               f"STT turn has operator/voicemail words {tw[1]}")
                    return
                due = checks < len(MACHINE_HANGUP_CHECK_S) and (
                    info.get("audio_s", 0) >= MACHINE_HANGUP_CHECK_S[checks]
                    or (info.get("released_by") == "timer" and info.get("audio_s", 0) >= 1.5))
                if not due:
                    if not saved_no and (checks >= len(MACHINE_HANGUP_CHECK_S) or (
                            info.get("released_by") == "timer" and checks)):
                        # keep watching only for an STT turn with operator words (the guard
                        # let go and the machine reached STT); any other turn ends the watch
                        saved_no = True
                        log.info("🤖 machine check: no operator/voicemail words (%r) — NO hang-up",
                                 " | ".join(heard)[:120])
                        await self._machine_save(info, " | ".join(heard), False, "no machine words")
                    continue
                checks += 1
                pcm = lock.machine_audio()
                if pcm is None:
                    continue
                text, lang = await transcribe_audio(pcm, int(getattr(lock, "sample_rate", 8000) or 8000))
                if text:
                    heard = [text]                       # each check reads the whole kept audio
                is_m, why = machine_verdict(text, int(info.get("lines_through", 0)))
                log.info("🤖 machine check %d (%.1fs of its voice, %s): %r → %s",
                         checks, info.get("audio_s", 0), lang, text[:120],
                         "MACHINE" if is_m else why)
                if is_m:
                    await self._machine_decide(lock.machine_info(), text, True, why, lang)
                    return
        except Exception as e:
            log.warning("🤖 machine check error (no hang-up): %s", e)

    async def _machine_decide(self, info: dict, text: str, is_m: bool, why: str, lang=None,
                              need_flag: bool = True) -> None:
        self._mh_done = True
        ok, why_not = self._machine_safe_to_cut(info, need_flag)   # again: a person may have come
        if not ok:
            log.info("🤖 machine words found but %s — NO hang-up", why_not)
            await self._machine_save(info, text, False, f"words ok but {why_not}", lang)
            return
        if MACHINE_HANGUP != "on":
            log.warning("🤖📴 [SHADOW] would hang up — machine answer: %s | %r", why, text[:120])
            await self._machine_save(info, text, True, why, lang)
            return
        self._closing = True
        log.warning("🤖📴 MACHINE ANSWER — hanging up: %s | %r", why, text[:120])
        await self._machine_save(info, text, True, why, lang)
        with contextlib.suppress(Exception):
            self._session.interrupt(force=True)
        try:
            lk = await get_lk_api()
            await lk.room.delete_room(api.DeleteRoomRequest(room=self._room_name))
            log.info("📴 Room deleted (machine answer): %s", self._room_name)
        except Exception as e:
            log.info("📴 machine hang-up room delete: %s", e)

    async def _machine_save(self, info: dict, text: str, is_m: bool, why: str, lang=None) -> None:
        doc = {"machine_detect": {
            "mode": MACHINE_HANGUP, "machine": bool(is_m), "hung_up": bool(is_m and MACHINE_HANGUP == "on"),
            "why": why, "heard": (text or "")[:500], "language": lang,
            "talked_through_lines": info.get("lines_through"), "greeting_voice_share": info.get("ratio"),
            "released_by": info.get("released_by"), "at": now_ist()}}
        if is_m and MACHINE_HANGUP == "on":
            doc["reason_for_call_disconnect"] = MACHINE_HANGUP_REASON
        for coll in (transcript_collection, transcript_collection_track):
            try:
                await coll.update_one({"call_id": self._call_id}, {"$set": doc}, upsert=True)
            except Exception as e:
                log.error("machine_detect save failed: %s", e)

    async def _hangup(self) -> None:
        try:
            sp = getattr(self._session, "current_speech", None)
            if sp is not None and hasattr(sp, "wait_for_playout"):
                await asyncio.wait_for(sp.wait_for_playout(), timeout=10.0)
            else:
                await asyncio.sleep(5.0)
        except Exception:
            await asyncio.sleep(3.0)
        await asyncio.sleep(0.5)
        try:
            lk = await get_lk_api()
            await lk.room.delete_room(api.DeleteRoomRequest(room=self._room_name))
            log.info("📴 Room deleted: %s", self._room_name)
        except Exception as e:
            if "not_found" in str(e) or "does not exist" in str(e):
                log.info("📴 Room already gone (LiveKit closed it): %s", self._room_name)
            else:
                log.warning("Hangup room delete failed: %s", e)

    def _caller_present(self) -> bool:
        """[TRANSFER 21-Oct] is the caller still in the room? True when unknown."""
        try:
            room, p = self._room, self._participant
            if room is None or p is None:
                return True
            return any(rp.identity == p.identity for rp in room.remote_participants.values())
        except Exception:
            return True

    def _handoff_now(self, reason: str, kind: Optional[str]) -> None:
        """Customer agreed (or asked) → speak the fixed hold line, uninterruptible,
        and transfer only once it has fully played. Every transfer goes through
        here, so the caller always hears why and that they are being transferred."""
        line = transfer_hold_line(kind, self._locked_lang)
        self._handing_off = True
        self._transfer_offered = False
        self._offer_kind = None
        self._handoffs.add(kind or reason)
        self._turn_word_cap = TTS_EXPLAIN_MAX_WORDS   # never clip the hold line
        self._set_tts_language(self._locked_lang or DEFAULT_LANGUAGE)
        log.info("📞 Handoff (%s/%s) — hold line, then transfer: %r", reason, kind, line[:80])
        handle = None
        try:
            handle = self._session.say(line, allow_interruptions=False)
        except Exception as e:
            log.warning("Hold line failed: %s", e)
        asyncio.create_task(self._transfer_after_hold(handle, reason))

    async def _transfer_after_hold(self, handle, reason: str) -> None:
        if handle is not None and hasattr(handle, "wait_for_playout"):
            with contextlib.suppress(Exception):
                await asyncio.wait_for(handle.wait_for_playout(), timeout=25.0)
        self._handing_off = False
        await self._run_transfer(reason)

    async def _transfer_after_playout(self, reason: str) -> None:
        sp = getattr(self._session, "current_speech", None)
        if sp is not None and hasattr(sp, "wait_for_playout"):
            with contextlib.suppress(Exception):
                await asyncio.wait_for(sp.wait_for_playout(), timeout=15.0)
        await self._run_transfer(reason)

    async def _run_transfer(self, reason: str) -> None:
        if self._transfer_busy or self._closing:
            return
        if time_module.monotonic() - self._last_transfer_ts < TRANSFER_RETRY_COOLDOWN_S:
            log.info("📞 Transfer (%s) skipped — cooldown", reason)
            return
        if not self._caller_present():
            # [TRANSFER 21-Oct] the caller hung up while the hold line played (…59211):
            # the transfer failed with "participant does not exist" and the bot then
            # told an empty room the expert was busy.
            log.info("📞 Transfer (%s) skipped — the caller already hung up", reason)
            return
        self._transfer_busy = True
        self._last_transfer_ts = time_module.monotonic()
        log.info("📞 Transferring (%s) to live agent", reason)
        ok, detail = await self._execute_transfer()
        log.info("📞 Transfer %s: %s", "OK" if ok else "FAILED", detail)
        try:
            await transcript_collection.update_one(
                {"call_id": self._call_id},
                {"$set": { "transfer_reason": reason,
                          "transfer_detail": detail, "transfer_at": now_ist()}},
                upsert=True,
            )
        except Exception as e:
            log.error("Transfer status save failed: %s", e)

        if ok:
            self._closing = True
            await asyncio.sleep(0.5)
            with contextlib.suppress(Exception):
                await self._room.disconnect()
                log.info("Bot left the room after transfer")
            return

        # Not connected → tell the caller and keep the call going.
        self._transfer_busy = False
        if (not self._caller_present() or "does not exist" in str(detail)
                or "not_found" in str(detail)):
            log.info("📞 Caller is gone — no 'expert is busy' line")
            return
        lang = self._locked_lang or DEFAULT_LANGUAGE
        self._set_tts_language(lang)
        with contextlib.suppress(Exception):
            self._session.say(TRANSFER_FAILED_LINES.get(lang, TRANSFER_FAILED_LINES["en-IN"]))

    async def _execute_transfer(self) -> tuple:
        """Find a free live agent and SIP-transfer the caller. Returns (ok, detail)."""
        if self._participant is None:
            return False, "no participant"
        try:
            http = await get_http_session()
            async with http.post(f"{API_ENDPOINT}/liveagents/DTLL",
                                 timeout=aiohttp.ClientTimeout(total=3), ssl=False) as resp:
                data = await resp.json(content_type=None)
            # Response: {"user": ["2101", "2102"], "ext": ["8600053", "8600051"]}
            # (older API returned a single string for "user").
            users = data.get("user") if isinstance(data, dict) else None
            if isinstance(users, str):
                users = [users]
            users = [str(u).strip() for u in (users or []) if str(u).strip()]
            ext = users[0] if users else None
            log.info(f"Live-agent response: {data} → selected user={ext}")
            if not ext or ext == "No agents available":
                return False, f"no agents available ({data})"
            lk = await get_lk_api()
            await lk.sip.transfer_sip_participant(TransferSIPParticipantRequest(
                participant_identity=self._participant.identity,
                room_name=self._room_name,
                transfer_to=f"sip:{ext}*DTLG_L@{CALL_TRANSFER_ENDPOINT}",
                play_dialtone=True,
            ))
            # Only after the SIP transfer really succeeded.
            await transcript_collection.update_one(
                {"call_id": self._call_id},
                {"$set": {"transfer_status": True}},
                upsert=True,
            )
            return True, f"agent {ext}"
        except Exception as e:
            return False, f"{type(e).__name__}: {e}"


