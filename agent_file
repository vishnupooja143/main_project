# answered them. A transcript the voice print already says is NOT the caller is
# dropped when it is a word loop or mostly the bot's own recent words.
_ECHO_TOKEN_RE = re.compile(r"[\s,.।!?;:\"'()\-]+")


def _echo_tokens(text: str) -> list:
    return [t for t in _ECHO_TOKEN_RE.split((text or "").lower()) if len(t) >= 2]


def is_word_loop(text: str) -> bool:
    """4+ words, at most half of them different ("gold three gold three gold")."""
    toks = _echo_tokens(text)
    return len(toks) >= 4 and len(set(toks)) <= len(toks) / 2


def echo_share(text: str, bot_words: set) -> float:
    """Share of the transcript's words that the bot itself just said (1.0 = all of
    them: the bot's own sentence came back; a caller repeating a few of the bot's
    words adds their own: "I want Gold for multiple users")."""
    toks = _echo_tokens(text)
    if len(toks) < 2 or not bot_words:
        return 0.0
    return sum(1 for t in toks if t in bot_words) / len(toks)


