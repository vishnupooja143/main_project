    log.info("🎙️ STT: %s mode=%s, auto-detect language | speech_threshold=%.2f min_frames=%d",
             STT_MODEL, STT_MODE, STT_POSITIVE_THRESHOLD, STT_MIN_SPEECH_FRAMES)

    # ── VAD ──────────────────────────────────────────────────────────────
    vad_instance = silero.VAD.load(
        min_speech_duration=VAD_MIN_SPEECH,
        activation_threshold=VAD_THRESHOLD,
        min_silence_duration=VAD_MIN_SILENCE,
    )
    log.info("🎚️ VAD: threshold=%.2f silence=%.2fs", VAD_THRESHOLD, VAD_MIN_SILENCE)
    vad_instance = _gate_vad(vad_instance, voice_lock)          # [SPEAKER LOCK]

    # ── Agent ─────────────────────────────────────────────────────────────
    agent = TallyDigitalAgent()
    agent._tts_instance = tts_instance
    agent._stt_instance = stt_instance
    agent._room_name    = ctx.room.name
    agent._room         = ctx.room
    agent._participant  = participant
    agent._call_id      = call_id
    agent._voice_lock = voice_lock                               # [SPEAKER LOCK]
    agent._set_tts_language(DEFAULT_LANGUAGE)

    call_ended = asyncio.Event()

    # ── Session ───────────────────────────────────────────────────────────
    session = AgentSession(
        stt=stt_instance,
        vad=vad_instance,
        llm=llm_instance,
        tts=tts_instance,
        aec_warmup_duration=1.0,
        user_away_timeout=12.0,
        max_tool_steps=1,
        turn_handling=_build_turn_handling(),
    )
    agent._session = session

    def _save(role: str, text: str, extra: Optional[dict] = None):
        return save_message_to_call(
            transcript_collection,
            transcript_collection_track,
            {
                "call_id":  call_id,
                "role":     role,
                "text":     text,
                "room":     ctx.room.name,
                "phone_no": phone_no,
                "lead_id": lead_id,
                "campaign_id": campaign_id,
                "extra":    extra,
            },
        )

    def _say(text: str, allow_interruptions: bool = True, source: str = "short_line"):
        # add_to_chat_ctx=False keeps these out of the LLM context, which also
        # means no conversation_item_added — so save them to Mongo here, or the
        # transcript misses lines the caller actually heard.
        log.info("[assistant:%s] %s", source, text[:120])
        asyncio.create_task(_save("assistant", text, {"source": source}))
        try:
            return session.say(text, allow_interruptions=allow_interruptions,
                               add_to_chat_ctx=False)
        except TypeError:
            return session.say(text, allow_interruptions=allow_interruptions)

    # Final STT transcripts not yet committed as a user turn. Cleared when
    # LiveKit commits the turn; whatever is left when the call ends (caller
    # said "nahi" and hung up before the turn closed) is saved as dropped.
    # Speech during the uninterruptible greeting is ignored on purpose.
    pending_finals: list = []          # (text, spoken_at)

    def _save_unanswered(text: str) -> None:
        # [MONGO 02-Nov] see on_user_turn_completed: the turn is saved now, and its
        # finals are no longer pending (they would be saved twice at hang-up)
        spoken_at = pending_finals[0][1] if pending_finals else now_ist()
        pending_finals.clear()
        log.info("💾 saved a turn the bot did not answer: %r", text[:80])
        asyncio.create_task(_save("user", text, {"no_reply": True, "timestamp": spoken_at}))

    agent._save_unanswered = _save_unanswered

    async def _flush_pending(reason: str) -> None:
        if not pending_finals:
            return
        dropped = " ".join(t for t, _ in pending_finals)
        spoken_at = pending_finals[0][1]
        pending_finals.clear()
        log.warning("🛟 uncommitted caller speech saved as dropped (%s): %r",
                    reason, dropped[:120])
        await _save("user", dropped,
                    {"dropped": True, "drop_reason": reason, "timestamp": spoken_at})

    # ── Event handlers ────────────────────────────────────────────────────

    @session.on("user_input_transcribed")
    def _on_stt_transcript(ev):
        detected = getattr(ev, "language", None) or getattr(ev, "language_code", None)
        if detected:
            agent.last_detected_stt_lang = detected

        text = (getattr(ev, "transcript", "") or "").strip()
        if text:
            agent._last_stt_ts = time_module.monotonic()     # [STT DEAF 30-Oct]
        if getattr(ev, "is_final", True) and text:
            sp = session.current_speech
            during_locked = sp is not None and not sp.allow_interruptions
            log.info("🎤 stt final%s: %r (lang=%s)",
                     " [ignored — bot line not interruptible]" if during_locked else "",
                     text[:120], detected)
            if not during_locked:
                pending_finals.append((text, now_ist()))
                agent._turn_segments.append((text, detected))
                # [SIDE LANGUAGE 02-Nov] the first answer after the greeting gives the
                # caller's language until they name one
                if (agent._greeting_done and getattr(agent, "_caller_stt_lang", None) is None
                        and detected and detected != "en-IN" and len(text.split()) >= 1):
                    agent._caller_stt_lang = detected

        # Backchannel: short acknowledgement fired the instant the caller
        # finishes — arrives with human timing instead of buried in the reply.
        if BACKCHANNEL_PROBABILITY <= 0:
            return
        if not getattr(ev, "is_final", True):
            return
        if not agent._language_locked or agent._turn_count < 1:
            return
        if session.current_speech is not None:
            return
        # No backchannel on a bare "hello?" — the reply already says "I'm here".
        if is_presence_check(text):
            return
        # A turn shorter than min_words can't interrupt a playing line, so
        # LiveKit holds it until the caller speaks again — the backchannel
        # itself stalled "ബിസിനസ്സിനുവേണ്ടിയിട്ടാ മാം" (2 words) for 11s (call …46977).
        turn_text = " ".join(t for t, _ in pending_finals) or text
        if len(split_words(turn_text, split_character=True)) < MIN_INTERRUPTION_WORDS:
            return
        pool = _BACKCHANNELS.get(agent._locked_lang, [])
        if pool and random.random() < BACKCHANNEL_PROBABILITY:
            # Through the call's ack memory: never the same backchannel twice in
            # a row, and the reply that follows won't open with another one.
            bc = agent._acks.pick_backchannel(pool)
            if not bc:
                return
            try:
                _say(bc, source="backchannel")
                agent._acks.note_spoken(bc)
            except Exception as e:
                log.debug("Backchannel skipped: %s", e)

    @session.on("conversation_item_added")
    def on_item_added(event: ConversationItemAddedEvent):
        if not hasattr(event.item, "role"):
            return
        text = getattr(event.item, "text_content", "") or ""
        # The TTS path already strips a leaked private directive so the caller
        # never hears it, but the raw item still carries it. Clean it here too
        # so "[Your goal for this reply: …]" can never reach Mongo — the
        # evaluation pipeline scores this stored text.
        if event.item.role == "assistant":
            text = _LEADING_NOISE_RE.sub("", text).strip()
            # Remember the last real line the caller heard, for "hello?" turns.
            # Our own "are you there?" checks don't count, nor a cut-off half
            # line ("को" → the "hello?" reply repeated "जी, को", call …49021).
            cut_off = bool(getattr(event.item, "interrupted", False))
            if text and not cut_off and not is_presence_check(text) \
                    and "लाइन पर" not in text and "still there" not in text.lower():
                agent._last_bot_reply = strip_self_intro(text)
            # [30-Oct] a backchannel ("ఓకే") is neither a heard question nor a cut one
            # [02-Nov] …64733: "TallyPrime లో" (2 words, cut off) left _last_reply_cut
            # False, so the caller's "hello?" got the greeting again. A cut-off
            # fragment is short by nature — it counts; only a backchannel is skipped.
            _bc = text.strip(" .,!?") in _ALL_BACKCHANNELS
            if text and (len(text.split()) > 2 or (cut_off and not _bc)):
                agent._last_reply_cut = cut_off
                agent._last_bot_said = text
        elif event.item.role == "user":
            pending_finals.clear()      # committed — nothing left to rescue
        log.info("[%s]%s %s", event.item.role,
                 " (cut off)" if getattr(event.item, "interrupted", False) else "", text[:120])

        # Per-turn latency (livekit fills ChatMessage.metrics). User items carry
        # STT / end-of-turn / our on_user_turn_completed (director + RAG) time;
        # assistant items carry LLM TTFT, TTS TTFB and end-to-end latency.
        m = getattr(event.item, "metrics", None) or {}
        if event.item.role == "user" and m:
            log.info("⏱️ user: stt=%.2fs eot_wait=%.2fs turn_logic=%.2fs",
                     m.get("transcription_delay", -1), m.get("end_of_turn_delay", -1),
                     m.get("on_user_turn_completed_delay", -1))
        elif event.item.role == "assistant" and m:
            log.info("⏱️ agent: llm_ttft=%.2fs tts_ttfb=%.2fs e2e=%.2fs",
                     m.get("llm_node_ttft", -1), m.get("tts_node_ttfb", -1),
                     m.get("e2e_latency", -1))

        asyncio.create_task(
            save_message_to_call(
                transcript_collection,
                transcript_collection_track,
                {
                    "call_id":  call_id,
                    "role":     event.item.role,
                    "text":     text,
                    "room":     ctx.room.name,
                    "phone_no": phone_no,
                    "lead_id": lead_id,
                    "campaign_id": campaign_id,
                },
            )
        )

    # [SPEAKER LOCK] the lock must know exactly when the bot is talking: it learns
    # only the voice that ANSWERS the bot, and gates strictly while the bot speaks.
    @session.on("agent_state_changed")
    def _on_agent_state_voice_lock(ev):
        if voice_lock is not None:
            try:
                voice_lock.set_bot_speaking(
                    getattr(ev, "new_state", None) in ("speaking", "thinking"))
            except Exception as e:
                log.debug("voice lock bot-state update failed: %s", e)

    def _lock_drop_count() -> int:
        vl = getattr(agent, "_voice_lock", None)
        st = getattr(vl, "stats", None) or {}
        return sum(int(st.get(k, 0) or 0) for k in ("turns_dropped", "noise_dropped", "loud_dropped"))

    async def _stt_deaf_check(start_ts: float, drops0: int) -> None:
        """[STT DEAF 30-Oct] see STT_DEAF_LINES."""
        await asyncio.sleep(STT_DEAF_WAIT_S)
        vl = getattr(agent, "_voice_lock", None)
        why_not = None
        if agent._last_stt_ts >= start_ts - 0.2:
            return                                    # STT wrote something — normal turn
        if getattr(session, "current_speech", None) is not None:
            why_not = "bot speaking"
        elif getattr(session, "user_state", None) == "speaking":
            why_not = "caller still speaking"
        elif agent._closing or agent._transfer_busy or not agent._language_locked:
            why_not = "not in the conversation"
        elif agent._deaf_prompts >= STT_DEAF_MAX:
            why_not = "asked twice already"
        elif _lock_drop_count() != drops0:
            why_not = "the voice lock dropped it (not the caller)"
        elif vl is not None and (getattr(vl, "_mg_on", False)
                                 or (hasattr(vl, "tv_on_line") and vl.tv_on_line())):
            why_not = "TV / recorded voice on the line"
        if why_not:
            log.info("🙊 speech with no transcript — not asking (%s)", why_not)
            return
        agent._deaf_prompts += 1
        line = STT_DEAF_LINES.get(agent._locked_lang, STT_DEAF_LINES["en-IN"])
        log.warning("🙊 caller spoke but STT wrote nothing for %.0fs — asking to repeat (%d/%d)",
                    STT_DEAF_WAIT_S, agent._deaf_prompts, STT_DEAF_MAX)
        with contextlib.suppress(Exception):
            agent._set_tts_language(agent._locked_lang)
        _say(line, source="stt_deaf")

    _deaf_state = {"start": None, "drops": 0}

    @session.on("user_state_changed")
    def _on_user_state(ev):
        _new = getattr(ev, "new_state", None)
        if _new == "speaking":
            _deaf_state["start"] = time_module.monotonic()
            _deaf_state["drops"] = _lock_drop_count()
            return
        if _new == "listening" and _deaf_state["start"] is not None:
            st, _deaf_state["start"] = _deaf_state["start"], None
            if (time_module.monotonic() - st >= STT_DEAF_MIN_SPEECH_S
                    and agent._deaf_prompts < STT_DEAF_MAX and agent._language_locked):
                asyncio.create_task(_stt_deaf_check(st, _deaf_state["drops"]))
            return
        if _new != "away":
            return
        if getattr(session, "current_speech", None) is not None:
            return
        if agent._closing or agent._transfer_busy:
            return
        if not agent._language_locked:
            if not agent._greeting_done:
                return
            if not agent._lang_question_asked:
                # Silent after the opening → ask the language once.
                agent._ask_language_question()
                return

            # Silent after the language question too → Hindi, don't ask again.
            async def _default_to_hindi():
                await agent._lock_language("hi-IN", "default")
                agent._set_tts_language("hi-IN")
                agent._away_prompts = 1          # next silence → goodbye
                session.say("हेलो, आप लाइन पर हैं?")

            asyncio.create_task(_default_to_hindi())
            return

        agent._away_prompts += 1
        checks = {
            "en-IN": "Hello, are you still there?",
            "hi-IN": "हेलो, आप लाइन पर हैं?",
            "kn-IN": "ಹಲೋ, ನೀವು ಇದ್ದೀರಾ?",
            "te-IN": "హలో, మీరు ఉన్నారా?",
            "ta-IN": "ஹலோ, நீங்க இருக்கீங்களா?",
            "ml-IN": "ഹലോ, നിങ്ങൾ ഉണ്ടോ?",
        }
        byes = {
            "en-IN": "Okay, I'll call back later. Take care!",
            "hi-IN": "ठीक है, बाद में बात करते हैं। धन्यवाद!",
            "kn-IN": "ಸರಿ, ನಂತರ ಮಾತಾಡೋಣ. ಧನ್ಯವಾದ!",
            "te-IN": "సరే, తర్వాత మాట్లాడుకుందాం. ధన్యవాదాలు!",
            "ta-IN": "சரி, பிறகு பேசலாம். நன்றி!",
            "ml-IN": "ശരി, പിന്നെ സംസാരിക്കാം. നന്ദി!",
        }

        if agent._away_prompts == 1:
            _say(checks.get(agent._locked_lang, checks["en-IN"]), source="away_check")
        else:
            agent._closing = True
            _say(byes.get(agent._locked_lang, byes["en-IN"]), source="away_bye")

            async def _end_after_bye():
                sp = getattr(session, "current_speech", None)
                if sp is not None and hasattr(sp, "wait_for_playout"):
                    try:
                        await asyncio.wait_for(sp.wait_for_playout(), timeout=10.0)
                    except Exception:
                        await asyncio.sleep(4)
                else:
                    await asyncio.sleep(4)
                if not call_ended.is_set():
                    log.info("📴 Ending call — caller silent after check-in")
                    await asyncio.shield(_do_cleanup())
                    call_ended.set()

            asyncio.create_task(_end_after_bye())


    cleanup_lock    = asyncio.Lock()
    cleanup_started = False
    # [CLEANUP SAFE 19-Oct] set when _do_cleanup() has fully finished. After a
    # transfer the room closes and the job shuts down AT ONCE: the shutdown removed
    # the log file and could cut cleanup short — the transfer call (…58318) has no
    # "📊 VOICE LOCK" / "🎧 AUDIO TO STT" lines and cleanup_call() may not finish.
    cleanup_done    = asyncio.Event()

    async def _do_cleanup():
        nonlocal cleanup_started
        async with cleanup_lock:
            if cleanup_started:
                return
            cleanup_started = True

        # Caller spoke but the turn never committed (hung up first, or speech
        # scheduling was already paused). Save it before cleanup_call marks
        # the call ready for evaluation, so the evaluator sees their last words.
        try:
            await _flush_pending("call_ended")
            await _do_cleanup_body()
        finally:
            cleanup_done.set()

    async def _do_cleanup_body():
        # [SPEAKER LOCK] final stats line + close debug files
        if voice_lock is not None:
            try:   # [CLEAN LOG 16-Oct] one short line instead of the long stats dump
                _st = voice_lock.stats
                # [21-Oct] "dropped" = turns the bot really did not hear. The lock's own
                # "other" count also held turns the agent KEPT (barge-in, "reply to the
                # bot", "Hello"), so …59214 showed dropped=2 with nothing dropped.
                log.info("📊 VOICE LOCK | state=%s | customer turns=%d | dropped=%d | "
                         "kept despite voice=%d | relocks=%d",
                         voice_lock.state.value, _st['turn_customer'],
                         getattr(agent, '_vl_dropped', 0),
                         max(0, _st['turn_other'] + _st['turn_noise'] - getattr(agent, '_vl_dropped', 0)),
                         getattr(voice_lock, '_relocks', 0))
                # [AUDIO SAFE 19-Oct] what reached STT: the caller's sound untouched,
                # silence, or denoised. "changed" must always be 0.
                _ac = getattr(voice_lock, "audio_check", None)
                if _ac:
                    log.info("🎧 AUDIO TO STT | untouched=%.1fs | silence=%.1fs | denoised=%.1fs | changed=%d",
                             _ac["raw_s"], _ac["silent_s"], _ac["denoised_s"], _ac["changed"])
                log.info("💰 STT SILENCE %s | not sent to Sarvam=%.1fs | no-voice words %s=%d",
                         "skipped" if SILENCE_SKIP == "on" else f"[{SILENCE_SKIP}] would skip",
                         getattr(agent, "_sil_saved", 0.0),
                         "dropped" if NOISE_WORDS == "on" else "would drop",
                         getattr(agent, "_noise_word_n", 0))
            except Exception:
                pass
            try:
                voice_lock.close()
            except Exception as e:
                log.warning("Voice lock close error: %s", e)

        lk_api = await get_lk_api()
        try:
            await cleanup_call(call_id, transcript_collection, transcript_collection_track, ctx.room.name, lk_api, call_start_time)
        except Exception as e:
            log.error("Cleanup error: %s", e)


    @ctx.room.on("participant_disconnected")
    def on_disconnect(p):
        if p.identity != participant.identity:
            return
        log.info("Customer %s disconnected — 10s grace period", p.identity)

        async def _grace_then_cleanup():
            try:
                # No audio after hang-up, so any open turn commits within the
                # max endpointing wait. Anything still pending after that was
                # lost — save it now, before later bot lines, to keep order.
                await asyncio.sleep(MAX_ENDPOINTING_DELAY + 1.0)
                await _flush_pending("caller_hung_up")
                await asyncio.sleep(max(0.0, 10 - MAX_ENDPOINTING_DELAY - 1.0))
                for rp in ctx.room.remote_participants.values():
                    if rp.identity == p.identity:
                        log.info("%s reconnected — cleanup aborted", p.identity)
                        return
            except asyncio.CancelledError:
                pass
            log.warning("=== CALL ENDED BY PARTICIPANT ===")
            await asyncio.shield(_do_cleanup())
            call_ended.set()

        asyncio.ensure_future(_grace_then_cleanup())

    @session.on("close")
    def on_session_close(ev):
        err = getattr(ev, "error", None)
        if err:
            log.error("AgentSession closed with error: %s", err)
        else:
            log.info("AgentSession closed normally")
        if not call_ended.is_set():
            async def _cleanup_then_end():      # [CLEANUP SAFE 19-Oct] finish first
                try:
                    await asyncio.shield(_do_cleanup())
                finally:
                    call_ended.set()
            asyncio.ensure_future(_cleanup_then_end())

    async def _on_shutdown(reason: str = ""):
        log.info("Job shutdown: %s", reason)
        # [CLEANUP SAFE 19-Oct] let the call's cleanup (transcript save, summary
        # lines) finish before the log file is closed.
        try:
            if not cleanup_started:
                await asyncio.wait_for(asyncio.shield(_do_cleanup()), timeout=15.0)
            else:
                await asyncio.wait_for(cleanup_done.wait(), timeout=15.0)
        except Exception as e:
            log.warning("Cleanup did not finish before shutdown: %s", e)
        try:
            logging.getLogger().removeHandler(file_handler)
            file_handler.close()
        except Exception:
            pass

    ctx.add_shutdown_callback(_on_shutdown)

    # ── Start session ─────────────────────────────────────────────────────
    await session.start(
        agent=agent,
        room=ctx.room,
        room_options=room_io.RoomOptions(
            audio_input=room_io.AudioInputOptions(
                # SIP telephony audio is 8kHz mono — match it exactly, like the
                # working reference bot. Leaving the default 24kHz meant a
                # sample-rate mismatch on the media path that can destabilise
                # the SIP leg mid-call.
                noise_cancellation=None,
                sample_rate=8000,
                num_channels=1,
            ),
            # Don't let the framework auto-close the session on the first
            # disconnect blip — our participant_disconnected handler runs a 10s
            # grace period + reconnect check instead, so a transient SIP drop
            # doesn't kill a live call.
            close_on_disconnect=False,
        ),
    )

