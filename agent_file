def _names_bot(text: str) -> bool:
    low = (text or "").lower()
    forms = _BOT_NAME_FORMS.get(_BOT_NAME.lower(), [_BOT_NAME.lower()])
    return any(f in low for f in forms)


def strip_self_intro(reply: str) -> str:
    """Drop greeting-only and self-introduction sentences ("Namaste, I am Avni
    from Tally Solutions.") from a mid-call reply. Falls back to clause level if
    that would leave nothing, and returns the reply unchanged if even that fails."""
    if not reply or not (_names_bot(reply) or _GREETING_ONLY_RE.match(
            _SENTENCE_SPLIT_RE.split(reply.strip())[0])):
        return reply

    def _keep(part: str) -> bool:
        return not _names_bot(part) and not _GREETING_ONLY_RE.match(part)

    sents = [s for s in _SENTENCE_SPLIT_RE.split(reply.strip()) if s.strip()]
    kept = [s for s in sents if _keep(s)]
    if not kept:
        clauses = [c for c in re.split(r"(?<=[,!])\s+", reply.strip()) if c.strip()]
        kept = [c for c in clauses if _keep(c)]
    out = " ".join(kept).strip(" ,")
    return out if len(out.split()) >= 2 else reply


