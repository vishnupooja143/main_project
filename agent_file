# Avni is a woman: her Hindi first-person verbs must be feminine. The LLM slips
# into the male form ("सुन रहा हूँ", "note कर लूँगा") — fix it in code. Only forms
# tied to "हूँ" or the 1st-person future "-ऊँगा" are touched, so third-person
# verbs ("वो guide करेंगे", "आप कर रहे हैं") stay as they are.
_END = r"(?=[\s,.।!?—\-]|$)"
_MASC_SELF_RE = [
    (re.compile(r"ता(\s+)(हूँ|हूं|हु)" + _END), r"ती\1\2"),                # करता हूँ
    (re.compile(r"(?<!\S)(रहा|चुका|गया|सका|पाया)(\s+)(हूँ|हूं|हु)" + _END),  # रहा हूँ
     lambda m: {"रहा": "रही", "चुका": "चुकी", "गया": "गई", "सका": "सकी",
                "पाया": "पाई"}[m.group(1)] + m.group(2) + m.group(3)),
    (re.compile(r"(ूँ|ूं|ऊँ|ऊं)गा" + _END), r"\1गी"),                      # करूँगा
]


def feminize_hindi_self(text: str) -> str:
    """Male first-person Hindi verb forms → female ones (Avni is a woman)."""
    for rx, repl in _MASC_SELF_RE:
        text = rx.sub(repl, text)
    return text


# A reply that only asks the caller to repeat. Allowed only when the Director
