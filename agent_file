    if LOG_MODE == "full":
        # Sarvam's own VAD/transcript events (START_SPEECH, END_SPEECH, "Received
        # empty transcript") are DEBUG-only — only wanted while debugging.
        for _name in ("livekit.plugins.sarvam.log.SpeechStream",
                      "livekit.plugins.sarvam.log.STT"):
            logging.getLogger(_name).setLevel(logging.DEBUG)
    log.info("📱 CALL START | mobile=%s | call_id=%s | lead=%s | campaign=%s",
             phone_no, call_id, lead_id, campaign_id)

    # ── Recording ────────────────────────────────────────────────────────
    asyncio.create_task(start_recording(ctx.room.name, call_id))

    # ── [SPEAKER LOCK] customer voice lock for this call ─────────────────
    voice_lock = None
    if SPEAKER_LOCK_AVAILABLE and SPEAKER_LOCK_ENABLED:
        try:
            voice_lock = CustomerVoiceLock(sample_rate=8000, call_id=str(call_id))
            # [QUIET GATE] before the lock a voice far quieter than the caller (someone
            # beside them) goes to STT as silence. OFF unless DIGITAL_QUIET_GATE=true
            # (it cut word beginnings, …60035); speaker_lock9 has no quiet gate at all.
            voice_lock.quiet_voice_stt_gate = (
                os.getenv("DIGITAL_QUIET_GATE", "false").lower() == "true")
            # AMD listens BEFORE the greeting: nothing heard until the bot has
            # greeted may be learned as "the customer" (open_enrollment() below).
            voice_lock.hold_enrollment()
            if preload_voice_lock_models is not None:
                # warm the models in the background so the first lock is not late
                threading.Thread(target=preload_voice_lock_models, args=(8000,),
                                 name=f"voicelock-preload-{call_id}", daemon=True).start()
            log.info("🔒 Customer voice lock ready")
        except Exception as e:
            voice_lock = None
            log.error("❌ Voice lock init failed — running without it: %s", e)
    else:
        log.warning("🎧 Voice lock off (available=%s enabled=%s)",
                    SPEAKER_LOCK_AVAILABLE, SPEAKER_LOCK_ENABLED)



    # ── TTS ──────────────────────────────────────────────────────────────
