        # "Who is this / what is this call?" is answered from the prompt, never
        # RAG — it was falling through to the no-answer line (…41793).
        elif "ai assistant" not in focus.lower() and not trial_kind and (
                decision.get("asked_question") or needs_rag_lookup(query)):
            search_query = await reform_task   # already in flight, near-instant here
