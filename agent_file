_ACK_ALT = "|".join(re.escape(p) for p in sorted(_ACK_PHRASES, key=len, reverse=True))
# One opener unit: optional "जी," + phrase + punctuation. Up to three chained
# ("जी, बिल्कुल, समझ गई। ..."). Punctuation is required so a phrase that is part
# of the sentence ("बिल्कुल free है") is never cut. The lookahead (letters and
# Indic signs, but not the danda "।") stops "ok" matching inside "okay".
_ACK_NOT_LETTER = r"(?![A-Za-z0-9_ऀ-ॣ०-෿])"
_ACK_UNIT = rf"(?:(?:जी|ji)\s*,?\s*)?(?:{_ACK_ALT}){_ACK_NOT_LETTER}\s*[,.!।—–-]+\s*"
_ACK_LEAD_RE = re.compile(rf"^\s*(?:{_ACK_UNIT}){{1,3}}", re.I)
_ACK_FIND_RE = re.compile(rf"(?:{_ACK_ALT}){_ACK_NOT_LETTER}", re.I)


def _ack_key(phrase: str) -> str:
    p = re.sub(r"\s+", " ", (phrase or "").strip().lower())
    return _ACK_CANON.get(p, p)


class AckTracker:
    """Per-call memory of the acknowledgement openers the bot has spoken.

    filter() runs on every finished LLM reply. The opener is removed when it
    was used recently, or when the previous reply (or a backchannel just
    before this reply) already opened with one. So at most every other reply
    starts with an acknowledgement, and never the same one twice in a row.
    """

    def __init__(self, window: int = 4):
        self.recent: deque = deque(maxlen=window)   # canonical keys, newest last
        self.last_had_ack = False

    def _record(self, keys) -> None:
        for k in keys:
            if k in self.recent:
                self.recent.remove(k)
            self.recent.append(k)

    def filter(self, reply: str) -> str:
        m = _ACK_LEAD_RE.match(reply or "")
        if not m:
            self.last_had_ack = False
            return reply
        keys = [_ack_key(x) for x in _ACK_FIND_RE.findall(m.group(0))]
        rest = reply[m.end():].lstrip(" ,.!।—–-")
        if len(rest.split()) < 2:
            # The acknowledgement IS the reply ("ठीक है।") — keep it.
            self._record(keys)
            self.last_had_ack = True
            return reply
        if self.last_had_ack or any(k in self.recent for k in keys):
            log.info("🔁 ack opener %r dropped (recent=%s)", m.group(0).strip(), list(self.recent))
            self.last_had_ack = False
            return rest[:1].upper() + rest[1:] if rest[:1].isascii() else rest
        self._record(keys)
        self.last_had_ack = True
        return reply

    def note_spoken(self, phrase: str) -> None:
        """A backchannel was just spoken — the next reply shouldn't also open with one."""
        self._record([_ack_key(phrase)])
        self.last_had_ack = True

    def pick_backchannel(self, pool: list) -> Optional[str]:
        fresh = [p for p in pool if _ack_key(p) not in self.recent]
        return random.choice(fresh) if fresh else None

    def prompt_hint(self) -> str:
        if self.last_had_ack:
            return ("Do NOT open this reply with any acknowledgement word (like 'समझ गई', "
                    "'ठीक है', 'okay', 'got it') — go straight to the point.")
        if self.recent:
            used = ", ".join(f"'{k}'" for k in self.recent)
            return (f"Usually skip the acknowledgement and go straight to the point. Never "
                    f"open with one already used in this call: {used}.")
        return "Usually skip the acknowledgement and go straight to the point."


# ── 4. Not a business ───────────────────────────────────────────────────────
# Backup for the Director (like says_owns_license): the caller says they don't
# run a business, or want Tally to learn / for a job. Call …46038: "हम बिजनेस
# नहीं करते" and "अकाउंटेंट बनने के लिए" were followed by business questions.
_BIZ_WORD = (r"(?:business|bussiness|बिजनेस|बिज़नेस|बिज़्नेस|बिजनस|बिज़नस|व्यापार|व्यवसाय|"
             r"धंधा|dhanda|dhandha|vyapar|vyapaar)")
_NO_BUSINESS_RE = re.compile(
    # English: negation before ("I don't have any business", "not for business")
    rf"\b(?:no|not|don'?t|do\s+not|doesn'?t|never)\b(?:\s+\w+){{0,3}}?\s+{_BIZ_WORD}|"
    # Hindi: negation after ("हम बिजनेस नहीं करते", "कोई बिजनेस नहीं है") — but not
    # "बिजनेस अच्छा नहीं चल रहा" (business isn't going well).
    # The first lookahead stops "नही" matching as a prefix of "नहीं" (letters and
    # signs only — the danda "।" may follow).
    rf"{_BIZ_WORD}(?:\s+\S+){{0,2}}?\s+(?:नहीं|नही|nahi|nahin|nai)"
    r"(?![a-zऀ-ॣ०-ॿ])(?!\s*(?:चल|chal))",
    re.I,
)
_LEARNING_RE = re.compile(
    r"(?:अकाउंटेंट|एकाउंटेंट|accountant)\s*(?:बन|ban)|become\s+an?\s+accountant|"
    r"(?:सीखने|learning|लर्निंग|learn|study|स्टडी|पढ़ाई|पढाई)\s*(?:के\s*लिए|ke\s*liye|purpose)|"
    r"for\s+(?:learning|study|studies)|learn(?:ing)?\s+(?:tally|accounting)|"
    r"(?:tally|टैली|टेली|accounting|अकाउंटिंग)\s*सीख|"
    r"\bstudent\b|स्टूडेंट|विद्यार्थी|\bfresher\b|फ्रेशर|accounting\s+job|"
    r"(?:job|जॉब|नौकरी)\s*(?:के\s*लिए|ke\s*liye)|for\s+(?:a\s+)?job",
    re.I,
)
_PERSONAL_USE_RE = re.compile(
    r"personal\s+use|for\s+(?:my\s+)?personal|पर्सनल\s*(?:use|यूज़|यूज|काम)|"
    r"निजी\s*(?:काम|use|उपयोग)|for\s+myself|अपने\s*(?:खुद\s*)?के\s*लिए",
    re.I,
)


def detect_non_business_intent(text: str) -> Optional[str]:
    """Short purpose label when the caller says Tally is not for a business, else None."""
    t = text or ""
    if _LEARNING_RE.search(t):
        return "learning Tally / accounting career"
    if _NO_BUSINESS_RE.search(t) or _PERSONAL_USE_RE.search(t):
        return "personal accounting (no business)"
    return None


def personal_flow_focus(lead: "LeadState") -> str:
    """Next move for a caller who has no business: value → purchase → demo."""
    purpose = lead.purpose or "personal accounting"
    if not lead.personal_pitch_done:
        lead.personal_pitch_done = True
        return (f"The customer does NOT run a business — they want Tally for {purpose}. "
                "Do NOT ask about business type, number of users or business challenges. "
                "Briefly acknowledge that, say in one line how TallyPrime helps with it "
                "(accounting entries, GST and reports — the same software used in accounting "
                "jobs), then ask whether they'd like to purchase TallyPrime for it.")
    return (f"The customer does NOT run a business ({purpose}) — never ask about business "
            "type, users or business challenges. Respond to what they just said. If they "
            "are interested, ask if they'd like to go ahead with the purchase; if they are "
            "unsure, offer a free live demo with our expert.")


