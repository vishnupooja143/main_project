async def save_message_to_call(coll,track_coll, data: dict) -> None:
    try:
        msg = {
            "role":      data["role"],
            "text":      data["text"],
            "timestamp": now_ist(),
            # e.g. {"dropped": True} / {"source": "backchannel"}
            **(data.get("extra") or {}),
        }
        # [MONGO 02-Nov] a message saved late with the time it was SPOKEN (a turn the
        # bot did not answer, speech left when the caller hung up) goes to its place
        # in time, not after the bot's next line
        push = ({"$each": [msg], "$sort": {"timestamp": 1}}
                if "timestamp" in (data.get("extra") or {}) else msg)
        await coll.update_one(
            {"call_id": data["call_id"],"phone_no": data["phone_no"], "lead_id": data["lead_id"], "campaign_id": data["campaign_id"]},
            {
                "$push": {
                    "messages": push
                },
                "$setOnInsert": {
                    "created_at":       now_ist(),
                    "evaluation_status": "active",
                    "transfer_status": False,
                },
                
            },
            upsert=True,

            
        )

        await track_coll.update_one(
        {
            "call_id":     data["call_id"],
            "phone_no":    data["phone_no"],
            "lead_id":     data["lead_id"],
            "campaign_id": data["campaign_id"],
        },
        {
            "$setOnInsert": {
                "created_at": now_ist(),
            }
        },
        upsert=True,
    )
    except Exception as e:
        log.error("Failed to save message: %s", e)


async def cleanup_call(call_id: str, coll, track_coll, room_name: str, lk_api, call_start_time=None) -> None:
    try:
        log.info("🧹 Cleanup for call_id=%s room=%s", call_id, room_name)
        await coll.update_one(
            {"call_id": call_id},
            {
                "$set": {
                    "ended_at":          now_ist(),
                    "evaluation_status": "yet_to_evaluate",
                    "ready_for_eval":    True,
                }
            },
            upsert=True,
        )

        talktime_data = {}
        if call_start_time is not None:
            duration_seconds = round(time_module.time() - call_start_time, 2)
            talktime_data["talktime_seconds"] = duration_seconds
            talktime_data["talktime_formatted"] = str(datetime.timedelta(seconds=int(duration_seconds)))
        else:
            log.info("call_id: %s - Call start time is None, cannot calculate talktime")

        await coll.update_one(
            {"call_id": call_id},
            {"$set": {**talktime_data}},
            upsert=True
        )

        await track_coll.update_one(
            {"call_id": call_id},
            {"$set": {**talktime_data}},
            upsert=True
        )
        try:
            await lk_api.room.delete_room(api.DeleteRoomRequest(room=room_name))
            log.info("🗑️ Room deleted: %s", room_name)
        except Exception as e:
            log.debug("Room deletion: %s", e)
        log.info("✅ Cleanup complete for %s", call_id)
    except Exception as e:
        log.error("Cleanup error: %s", e)


