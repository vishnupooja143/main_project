    # ── STT ──────────────────────────────────────────────────────────────
    # language="unknown" → Sarvam auto-detects from audio each utterance.
    # This is why we do NOT need a destructive STT rebuild on language change.
    stt_instance = sarvam.STT(
        language="unknown",
        model=STT_MODEL,
        mode=STT_MODE,
        sample_rate=8000,
        api_key=SARVAM_API_KEY, 
