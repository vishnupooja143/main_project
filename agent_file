_REPEAT_REQUEST_RE = re.compile(
    r"say (that|it) (once more|again|one more time)|repeat (that|it|yourself)|"
    r"come again|didn'?t (catch|get|understand)|"
    r"(फिर से|दोबारा|एक बार फिर) (बता|बोल|कह)|"
