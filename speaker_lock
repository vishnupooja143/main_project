DIARIZE_W_COV       = _f("DIARIZE_W_COV", 0.40)
DIARIZE_W_QUIET     = _f("DIARIZE_W_QUIET", 0.20)
DIARIZE_W_EARLY     = _f("DIARIZE_W_EARLY", 0.15)
DIARIZE_W_NEAR      = _f("DIARIZE_W_NEAR", 0.25)
DIARIZE_W_LEVEL     = _f("DIARIZE_W_LEVEL", 0.0)

# ── [v10 30-Oct] FIRST-HELLO SEED ────────────────────────────────────────────
# The first answer after the bot's greeting (starting within DIARIZE_SEED_WINDOW_S of
# the bot stopping; its first ~1 s) is nearly always the person who picked up.
# Its voice is a SOFT seed: it never locks on its own. When that voice also leads the
# DIARIZE scores by DIARIZE_SEED_MARGIN (instead of the full DIARIZE_MARGIN), answered
# DIARIZE_SEED_ANSWERS answers and has DIARIZE_SEED_SECS of speech, it is taken without
# waiting for the full margin. A voice that beats it by DIARIZE_MARGIN is taken
# instead (the seed was wrong). Log tag: "seed".
#   on / shadow (default: only logged, "seed would pick A") / off
DIARIZE_SEED          = _s("DIARIZE_SEED", "shadow")
DIARIZE_SEED_WINDOW_S = _f("DIARIZE_SEED_WINDOW_S", 3.0)
DIARIZE_SEED_SIM      = _f("DIARIZE_SEED_SIM", 0.40)       # seed ↔ voice centroid agreement
DIARIZE_SEED_SELF_SIM = _f("DIARIZE_SEED_SELF_SIM", 0.25)  # 2nd piece joins the seed if it agrees
DIARIZE_SEED_MARGIN   = _f("DIARIZE_SEED_MARGIN", 0.08)
