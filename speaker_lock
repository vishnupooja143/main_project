DIARIZE_STREAK_SECS   = _f("DIARIZE_STREAK_SECS", 2.5)
DIARIZE_MAX_WAIT_S  = _f("DIARIZE_MAX_WAIT_S", 20.0)    # in doubt, old rule after this much speech
