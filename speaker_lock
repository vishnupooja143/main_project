        self._run_foreign = False
        self._bank: List[np.ndarray] = []
        self._pending_answer: Optional[List[Tuple[bool, np.ndarray]]] = None
        self._foreign_answers = 0
        self._turn_audio: Deque[Tuple[int, np.ndarray]] = collections.deque(maxlen=150)   # 15 s
        # Untouched audio of the caller's current answer (silences included,
        # 0.5 s before the first word), for a second STT listen when the first
        # one missed a number or time. Reset whenever the bot starts talking.
        self._raw_turn: Deque[np.ndarray] = collections.deque(maxlen=120)    # 12 s
        self._raw_preroll: Deque[np.ndarray] = collections.deque(maxlen=5)   # 0.5 s
        self._raw_started = False
        self._cust_rms: Deque[float] = collections.deque(maxlen=20)
        self._foreign_turns: List[np.ndarray] = []
        self._loud_foreign: List[Tuple[int, np.ndarray]] = []   # FAST_RELOCK: (bot line, audio)
        self._rivals: List[np.ndarray] = []     # voice prints of voices known NOT to be the customer
        self._weak_turns: List[np.ndarray] = []   # WEAK LOCK: kept turns that matched badly
        self._any_speech_idx = -10 ** 9           # PRE-LOCK GATE: last hop with a voice (bot talking or not)
        self._ans_rms: Deque[float] = collections.deque(maxlen=200)   # v5.0 caller answer level
        self._recent_voice: Deque[float] = collections.deque(maxlen=8) # v5.0 voice rms, last hops
        self._barge_hops: List[Tuple[int, np.ndarray]] = []           # v5.0 loud speech over the bot
        self._barge_commit = False
        self._loud_barge_idx = -10 ** 9                                # v5.0 last caller-level voice over the bot
        self._pl_held: List[Tuple[int, np.ndarray]] = []   # the last slices the gate silenced
        self._voice_det = _make_voice_detector(sample_rate)
        self._weak_rebuilds = 0
        self._prev_lock: Optional[Dict] = None    # KEEP OLD LOCK: the lock before a re-lock
        self._enroll_words = 0              # words STT heard from the caller so far
        self._enroll_words_seen = False     # the agent reports words at all
        self._words_wait_logged = False
        self._last_err_ts = 0.0
        # v4.9 STT DENOISE / MUTE OTHER
        self._denoiser = None
        if STT_DENOISE and not STT_RAW:     # [STT RAW] never denoised
            try:
                self._denoiser = _SttDenoiser(sample_rate)
            except Exception as e:
                logger.warning(f"[{self.call_id}] STT denoise off for this call: {e}")
        self._dn_active = False
        self._dn_want_since = None                 # [AUDIO SAFE] when the other state was first wanted
        # [AUDIO SAFE 19-Oct] what the lock did to every 100 ms slice sent to STT
        self.audio_check = {"raw_s": 0.0, "silent_s": 0.0, "denoised_s": 0.0,
                            "preroll_s": 0.0, "changed": 0}
        self._ac_logged = False
        self._mute_on = False                 # inside a muted stretch
        self._mute_eval: Optional[Tuple[int, bool, Optional[float]]] = None
        self._mute_run_hops = 0
        self._mute_run_sim: Optional[float] = None
        self._mute_last_idx = -10 ** 9
        logger.info(f"[{self.call_id}] 🔒 CustomerVoiceLock init sr={sample_rate} hop={HOP_MS}ms "
                    f"lookahead={LOOKAHEAD_HOPS * HOP_MS}ms sep={self._separator is not None} "
                    f"tse={self._extractor is not None} "
                    f"prelock_gate={'off' if not PRELOCK_NOISE else 'silero' if self._voice_det is not None else 'simple'}"
                    f"{'+stt' if PRELOCK_NOISE and PRELOCK_STT_GATE else ''} "
                    f"stt_denoise={'on' if self._denoiser is not None else 'off'} "
                    f"mute_other={'on@%.2f' % MUTE_OTHER_SIM if MUTE_OTHER else 'off'} "
                    f"diarize={DIARIZE} barge_tv={BARGE_TV_GUARD} quiet_voice={QUIET_VOICE} soft_lock={SOFT_LOCK} nearfield={NEARFIELD} seed={DIARIZE_SEED} dz_sep={DIARIZE_SEPARATE} tv_vad={TV_VAD}{' (old TCVL_TV_VAD=' + _TVV_OLD + ' ignored)' if _TVV_OLD and _TVV_OLD != TV_VAD else ''} "
                    f"barge_guard={'on' if PRELOCK_BARGE_GUARD else 'off'} "
                    f"barge_enroll={'on' if BARGE_ENROLL else 'off'} "
                    f"smart_gate={'on' if PRELOCK_SMART_GATE else 'off'} stt_raw={'on' if STT_RAW else 'off'} "
                    f"fast_barge={'on' if FAST_BARGE else 'off'}")

    # ── public API ────────────────────────────────────────────────────────
    @property
    def locked(self) -> bool:
        return self.state is LockState.LOCKED

    def set_bot_speaking(self, speaking: bool) -> None:
        speaking = bool(speaking)
        if speaking and not self._bot_speaking and self._tv_near_base():
            if getattr(self, "_tv_near_seen", False):
                self._tv_near_miss = 0
            else:
                self._tv_near_miss = getattr(self, "_tv_near_miss", 0) + 1
                if self._tv_near_miss >= TV_NEAR_MISS_LINES:
                    self._tv_near_off = True
                    logger.warning(f"[{self.call_id}] 📺 no voice louder than the TV after "
                                   f"{self._tv_near_miss} bot lines — the caller may be quieter "
                                   f"than the TV: TV filter off for this call")
            self._tv_near_seen = False
        if speaking != self._bot_speaking:
            logger.debug(f"[{self.call_id}] bot_speaking={speaking}")
        if speaking and not self._bot_speaking and self._answer_hist:
            n = len(self._answer_hist)
            ok = sum(1 for good, _ in self._answer_hist if good)
            logger.info(f"[{self.call_id}] 🎧 last answer: {n * self._hop_s:.1f}s of speech, "
                        f"{ok}/{n} hops reached STT")
            # embedding it is done on the audio thread, not the event loop
            self._pending_answer = list(self._answer_hist)
            self._answer_hist.clear()   # each answer is judged on its own
        if speaking and not self._bot_speaking:
            self._raw_turn.clear()
            self._raw_started = False
        if speaking and not self._bot_speaking:
            self._answer_id += 1
            self._bgm_bot_start = self._next_idx
            self._mg_lines = getattr(self, "_mg_lines", 0) + 1
            self._mg_line_bot = 0
            self._mg_line_voice = 0
            self._mg_line_speech = 0
        if self._bot_speaking and not speaking:
            self._mg_line_end = True              # judged on the audio thread
        if speaking:
            self._bot_seen = True
        if self._bot_speaking and not speaking:
            t0 = getattr(self, "_fb_t0", None)
            if t0 is not None:
                self._fb_t0 = None
                logger.info(f"[{self.call_id}] ⏹️ caller interrupted the bot — bot stopped "
                            f"{time.monotonic() - t0:.1f}s after their voice was heard")
            if BARGE_ENROLL and self._barge_hops:
                self._barge_commit = True          # handled on the audio thread (_push)
            self._bot_end_ts = time.monotonic()
            self._bot_end_idx = self._next_idx     # audio clock, not wall clock
        self._bot_speaking = speaking

    def hold_enrollment(self) -> None:
        """Do not learn a voice yet. For agents that listen BEFORE the bot speaks
        (e.g. AMD before the greeting): until the bot has talked, every sound would
        count as the customer's 'answer' — ringback, IVR, a bystander's 'hello?'."""
        with self._mutex:
            self._enroll_open = False

    def open_enrollment(self) -> None:
        """The bot has greeted — learn the voice that answers it from now on."""
        with self._mutex:
            if not self._enroll_open:
                self._enroll_open = True
                logger.info(f"[{self.call_id}] 🎙️ enrollment opened (bot has greeted)")

    def note_anchor(self, why: str = "") -> None:
        """[ANCHOR 29-Oct] The agent is sure the turn just heard came from the caller
        (e.g. they named the language we asked for). Marks this answer for DIARIZE
        and for the answer-agreement check. Never drops anything."""
        with self._mutex:
            if self.state is LockState.LOCKED and not self._proven:
                # [02-Nov] probation: the agent says this turn was the caller's
                self._prob_anchor_n = getattr(self, "_prob_anchor_n", 0) + 1
                return
            if self.state is not LockState.ENROLLING:
                return
            a = getattr(self, "_anchor_aids", None)
            if a is None:
                a = self._anchor_aids = set()
            a.add(self._answer_id)
            logger.info(f"[{self.call_id}] ⚓ anchor: answer {self._answer_id} is the caller's"
                        f"{' (' + why + ')' if why else ''} — this voice is preferred")
            if QUIET_VOICE != "off" and "named" in (why or ""):
                self._qv_arm()
            self._sl_on_anchor(why or "")
            self._wait_until_s = 0.0
            self._maybe_build()

    # ── [v11 SOFT LOCK] see SOFT_LOCK ─────────────────────────────────────────
    def soft_judge(self) -> Tuple[str, Optional[float]]:
        """Call on every STT final BEFORE the full lock. Returns ("customer" |
        "other" | "unknown", similarity). Only "other" (and SOFT_LOCK=on) means drop.
        Takes the voice heard since the last call (bot silent only)."""
        if SOFT_LOCK == "off" and CLUES == "off":
            return "unknown", None
        with self._mutex:
            b = getattr(self, "_sl_buf", None)
            raw = list(b) if b else []
            if b:
                b.clear()
            locked = self.state is LockState.LOCKED
            if (locked and self._proven) or not self._enroll_open:
                self.last_clues = None
                self.last_voice_s = None
                return "unknown", None
            aid = self._answer_id
            bot_end = self._bot_end_idx
            bot_now = self._bot_speaking
            lv = list(getattr(self, "_sl_levels", None) or [])
            bank_n = len(getattr(self, "_sl_bank", None) or [])
        self._sl_last = None
        self.last_voice_s = len(raw) * self._hop_s     # [NOISE WORDS 05-Nov] voice heard for this final
        # [CLUES 02-Nov] everything known about this final except its words (shadow)
        clues = {"t": None, "voiced_s": round(len(raw) * self._hop_s, 1), "since_bot_s": None,
                 "over_bot": bool(bot_now), "level_x": None, "sim": None, "bank": bank_n,
                 "phase": "probation" if locked else "prelock"}
        self.last_clues = clues
        if raw:
            i0 = raw[0][2]
            clues["t"] = round(i0 * self._hop_s, 1)
            if bot_end and i0 >= bot_end:
                clues["since_bot_s"] = round((i0 - bot_end) * self._hop_s, 1)
            top_r = float(np.percentile([r for _, r, _ in raw], 90))
            if lv:
                clues["level_x"] = round(top_r / max(float(np.median(lv)), 1.0), 2)
            clues["_top"] = top_r
        if len(raw) * self._hop_s < SOFT_MIN_S:
            return "unknown", None                 # too short to judge a voice
        # [02-Nov …65799] the turn's buffer also held a quiet voice beside the caller
        # (22–40% of the caller): judged together it scored 0.24 and re-seeded the
        # soft lock on a mixture. Only the loud part of the turn is judged (when it
        # is long enough on its own).
        top = clues["_top"]
        loud = [p for p, r, _ in raw if r >= SOFT_LOUD_SHARE * top]
        pcs = loud if len(loud) * self._hop_s >= 0.5 else [p for p, _, _ in raw]
        try:
            emb = self._embed(np.concatenate(pcs), self.sample_rate)
        except Exception as e:
            logger.debug(f"soft judge embed failed: {e}")
            emb = None
        if emb is None:
            return "unknown", None
        with self._mutex:
            bank = getattr(self, "_sl_bank", None)
            if bank:
                clues["sim"] = round(float(np.dot(emb, _norm(np.mean(np.vstack(bank), axis=0)))), 2)
            if self.state is LockState.LOCKED or SOFT_LOCK == "off":
                return "unknown", None
            bank = getattr(self, "_sl_bank", None)
            if not bank:
                self._sl_bank = [emb]
                self._sl_seed_aid = aid
                self._sl_confirmed = False
                self._sl_drops = 0
                self._sl_last = (emb, aid, None, "seed")
                self._sl_note_level(clues.get("_top"))
                self.stats["soft_seed"] += 1
                logger.info(f"[{self.call_id}] 🌱 soft lock: seed from the first answer "
                            f"({len(pcs) * self._hop_s:.1f}s of voice)")
                return "unknown", None
            prof = _norm(np.mean(np.vstack(bank), axis=0))
            sim = float(np.dot(emb, prof))
            conf = getattr(self, "_sl_confirmed", False)
            if not conf:
                # confirmed only by the agent's anchor (see _sl_on_anchor): people
                # around the caller answer in their own voice twice just as easily
                self._sl_last = (emb, aid, sim, "pending")
                return "unknown", sim
            rivals = getattr(self, "_sl_rivals", None) or []
            rsim = max((float(np.dot(emb, _norm(np.mean(np.vstack(r), axis=0)))) for r in rivals),
                       default=None)
            if sim >= SOFT_SAME and (rsim is None or rsim < SOFT_RIVAL_MAX):
                self._sl_drops = 0
                bank.append(emb)
                if len(bank) > SOFT_BANK:
                    bank.pop(1)                    # the seed stays
                self._sl_last = (emb, aid, sim, "customer")
                self._sl_note_level(clues.get("_top"))
                self.stats["soft_kept"] += 1
                return "customer", sim
            if sim >= SOFT_SAME:
                self._sl_last = (emb, aid, sim, "doubt")   # like both voices: kept, not learned
                self.stats["soft_doubt"] += 1
                return "unknown", sim
            other = (sim < SOFT_DIFF or (rsim is not None and sim < SOFT_RIVAL_MAX
                                         and rsim - sim >= SOFT_RIVAL_GAP))
            if not other:
                if sim < 0.15:
                    self._sl_add_rival(emb)        # probably another voice: learn it
                self._sl_last = (emb, aid, sim, "doubt")
                self.stats["soft_doubt"] += 1
                return "unknown", sim
            self._sl_add_rival(emb)
            if len(bank) < SOFT_MIN_BANK:
                # [02-Nov …65799] a profile from ONE answer is too weak to drop on
                # (the caller's own "నేను ఇప్పుడు Teleprime" scored 0.06 against it)
                self._sl_last = (emb, aid, sim, "doubt")
                self.stats["soft_doubt"] += 1
                logger.info(f"[{self.call_id}] 🔐 soft lock: different voice ({sim:.2f}) but the "
                            f"caller's print is from one answer only — kept")
                return "unknown", sim
            if self._sl_drops >= SOFT_MAX_DROPS:
                self._sl_drops = 0
                self._sl_last = (emb, aid, sim, "cap")
                self.stats["soft_cap"] += 1
                logger.warning(f"[{self.call_id}] 🔐 soft lock: {SOFT_MAX_DROPS} drops in a row — "
                               f"this one is kept (voice {sim:.2f}); an anchor on it re-seeds")
                return "unknown", sim
            self._sl_last = (emb, aid, sim, "other")
            if SOFT_LOCK == "on":
                self._sl_drops += 1
                self.stats["soft_dropped"] += 1
                return "other", sim
            self.stats["soft_shadow_drop"] += 1
            logger.info(f"[{self.call_id}] 🔐 [shadow] soft lock would drop this turn (voice {sim:.2f})")
            return "unknown", sim

    def _real_crowd(self, voices: List[Dict]) -> bool:
        """[CROWD FIX 03-Nov …65919] the caller ALONE was told "many people are
        talking around you": DIARIZE had split his one voice in two groups (loud short
        words / longer answers, level 1.00 vs 0.43) and BOTH groups held the answers
        the agent confirmed as his (anchor 41% / 59%). Two groups are other people only
        when they sound clearly different AND not both of them gave the caller's
        confirmed answers."""
        if CROWD_CHECK == "off":
            return True
        big = [g for g in voices if g.get("secs", 0) >= CROWD_MIN_SECS]
        for i, a in enumerate(big):
            for b in big[i + 1:]:
                sim = float(np.dot(a["cen"], b["cen"]))
                self._crowd_dbg = (round(sim, 2), round(a.get("anchor", 0.0), 2), round(b.get("anchor", 0.0), 2))
                both_caller = (a.get("anchor", 0.0) >= CROWD_ANCHOR_BOTH
                               and b.get("anchor", 0.0) >= CROWD_ANCHOR_BOTH)
                if sim < CROWD_MAX_SIM and not both_caller:
                    return True
        if CROWD_CHECK == "shadow":
            logger.info(f"[{self.call_id}] 👥 [shadow] {len(voices)} voice groups look like ONE "
                        f"person — the crowd request would not be made")
            return True
        if not getattr(self, "_crowd_one_logged", False):
            self._crowd_one_logged = True
            logger.info(f"[{self.call_id}] 👥 {len(voices)} voice groups, but they look like ONE "
                        f"person (close prints or both gave the caller's answers) — no crowd request")
        return False

    def _sl_note_level(self, top: Optional[float]) -> None:
        if top:
            lv = getattr(self, "_sl_levels", None)
            if lv is None:
                lv = self._sl_levels = collections.deque(maxlen=8)
            lv.append(float(top))

    def _sl_seed_print(self) -> Optional[np.ndarray]:
        bank = getattr(self, "_sl_bank", None)
        return _norm(np.mean(np.vstack(bank), axis=0)) if bank else None

    def _sl_add_rival(self, emb: np.ndarray) -> None:
        rivals = getattr(self, "_sl_rivals", None)
        if rivals is None:
            rivals = self._sl_rivals = []
        for r in rivals:
            if float(np.dot(emb, _norm(np.mean(np.vstack(r), axis=0)))) >= SOFT_RIVAL_JOIN:
                r.append(emb)
                del r[:-4]
                return
        rivals.append([emb])
        del rivals[:-3]

    def _sl_confirm(self, why: str) -> None:
        self._sl_confirmed = True
        self._sl_drops = 0
        self.stats["soft_confirmed"] += 1
        logger.info(f"[{self.call_id}] 🔐 soft lock {'ON' if SOFT_LOCK == 'on' else '[shadow]'}: "
                    f"caller confirmed by {why} — before the full lock, clearly different "
                    f"voices {'are' if SOFT_LOCK == 'on' else 'would be'} dropped (by voice print, "
                    f"not loudness)")

    def _sl_reseed(self, emb: np.ndarray, aid: int, why: str) -> None:
        old = list(getattr(self, "_sl_bank", None) or [])
        self._sl_rivals = [r for r in (getattr(self, "_sl_rivals", None) or [])
                           if float(np.dot(emb, _norm(np.mean(np.vstack(r), axis=0)))) < SOFT_RIVAL_JOIN]
        if old:
            self._sl_rivals.append(old[:4])     # the wrong seed is the other voice
        self._sl_bank = [emb]
        self._sl_seed_aid = aid
        self._sl_drops = 0
        self.stats["soft_reseed"] += 1
        logger.warning(f"[{self.call_id}] 🌱 soft lock: re-seeded — {why}")
        self._sl_confirm("the agent's anchor on the new voice")

    def _sl_on_anchor(self, why: str = "") -> None:
        last = getattr(self, "_sl_last", None)
        if SOFT_LOCK == "off" or not last or last[1] != self._answer_id:
            return
        emb, aid, sim, kind = last
        conf = getattr(self, "_sl_confirmed", False)
        if kind == "seed":
            if not conf:
                self._sl_confirm("the agent's anchor on the seed answer")
            return
        if sim is None:
            return
        if not conf:
            if sim >= SOFT_SAME:
                self._sl_bank.append(emb)
                self._sl_confirm(f"the agent's anchor ({sim:.2f})")
            elif sim < SOFT_RESEED_SIM:
                # [02-Nov …65799] one weak anchor (0.24, "answered in the call language")
                # re-seeded a CORRECT seed. Re-seed only when the voice is clearly
                # different AND either the caller named the language in it, or two
                # anchored answers agree on that new voice.
                cand = getattr(self, "_sl_cand", None)
                if cand is None:
                    cand = self._sl_cand = []
                agree = any(float(np.dot(emb, c)) >= SOFT_SAME for c in cand)
                cand.append(emb)
                del cand[:-3]
                if "named" in why or agree:
                    self._sl_cand = []
                    self._sl_reseed(emb, aid, f"the anchored answer is a different voice ({sim:.2f}"
                                              f"{', named the language' if 'named' in why else ', 2 answers agree'})"
                                              f" — the first answer was someone else")
        elif kind == "doubt" and sim >= SOFT_ANCHOR_LEARN:
            # an anchored answer (the agent says: the caller) that sounds roughly like
            # the caller is learned — a 1 s seed alone rarely reaches SOFT_SAME
            bank = self._sl_bank
            bank.append(emb)
            if len(bank) > SOFT_BANK:
                bank.pop(1)
            self.stats["soft_learned"] += 1
            lc = getattr(self, "last_clues", None) or {}
            self._sl_note_level(lc.get("_top"))
            logger.info(f"[{self.call_id}] 🔐 soft lock: anchored answer ({sim:.2f}) learned into "
                        f"the caller's print ({len(bank)} answers)")
        elif kind == "cap" and sim < SOFT_RESEED_SIM:
            self._sl_reseed(emb, aid, f"the voice dropped {SOFT_MAX_DROPS}× answered us "
                                      f"({sim:.2f}) — the seed was the wrong person")

    def soft_reset(self, why: str = "") -> None:
        """The phone changed hands ("ఒక్క నిమిషం, ఇస్తాను"): the next answer is the seed."""
        with self._mutex:
            if getattr(self, "_sl_bank", None):
                self._sl_bank = []
                self._sl_rivals = []
                self._sl_confirmed = False
                self._sl_drops = 0
                self.stats["soft_reset"] += 1
                logger.warning(f"[{self.call_id}] 🌱 soft lock reset{' (' + why + ')' if why else ''} "
                               f"— the next answer is the new seed")

    def soft_locked(self) -> bool:
        return (SOFT_LOCK == "on" and self.state is not LockState.LOCKED
                and bool(getattr(self, "_sl_confirmed", False)))

    def note_side_talk(self, why: str = "") -> None:
        """[SIDE 02-Nov] The agent is sure the answer just heard was NOT the caller
        (e.g. another language than the one the caller named, …64733). The voice
        holding that speech is pushed down in DIARIZE exactly as an anchor pushes
        up (DIARIZE_ANCHOR decides: shadow = logged only). Never drops anything."""
        with self._mutex:
            if self.state is LockState.LOCKED and not self._proven:
                # [02-Nov …65862] probation: a side-talk turn must not count as "the voice
                # talking to the bot" — four of them re-locked onto the man beside the caller
                if self._probation_turns:
                    self._probation_turns.pop()
                if self._foreign_turns:
                    self._foreign_turns.pop()
                logger.info(f"[{self.call_id}] 🙉 side talk during probation{' (' + why + ')' if why else ''} "
                            f"— not used to re-lock")
                return
            if self.state is not LockState.ENROLLING:
                return
            a = getattr(self, "_side_aids", None)
            if a is None:
                a = self._side_aids = set()
            a.add(self._answer_id)
            anc = getattr(self, "_anchor_aids", None)
            if anc is not None:
                anc.discard(self._answer_id)
            last = getattr(self, "_sl_last", None)
            if last is not None and last[1] == self._answer_id and last[3] != "seed":
                self._sl_add_rival(last[0])
            logger.info(f"[{self.call_id}] 🙉 side talk: answer {self._answer_id} is NOT the "
                        f"caller's{' (' + why + ')' if why else ''}")

    def crowd_on_line(self) -> Optional[str]:
        """[CROWD 29-Oct] Several voices answer the bot before the lock (family, shop,
        office), or None. Read by the agent to ask the caller for a quieter place."""
        if self.state is LockState.LOCKED and getattr(self, "_proven", False):
            return None
        return getattr(self, "_crowd_reason", None)

    def note_enroll_words(self, n: int) -> None:
        """The agent heard `n` words from the caller (a final transcript, not
        spoken over the bot). See ENROLL_MIN_WORDS."""
        with self._mutex:
            self._enroll_words_seen = True
            if self.state is not LockState.ENROLLING or not self._enroll_open:
                return
            self._enroll_words += max(0, int(n))
            self._maybe_build()

    def _is_answer_time(self) -> bool:
        if self._bot_speaking:
            return False
        if not self._bot_seen:          # no bot events wired → can't window, allow
            return True
        since = (self._next_idx - self._bot_end_idx) * self._hop_s
        return POST_BOT_GRACE_S <= since <= ANSWER_WINDOW_S

    def reset_stream(self) -> None:
        """A new STT stream started — drop half-processed audio, keep the profile."""
        with self._mutex:
            self._pending = np.zeros(0, dtype=np.int16)
            self._ring.clear()
            self._next_release = self._next_idx
            self._tse_cache = None
            self._prev_open = not self.locked
            self._mute_on = False
            self._mute_eval = None

    def process(self, pcm: np.ndarray) -> List[np.ndarray]:
        """Feed int16 mono audio of any length; returns released 100 ms hops (int16)."""
        out: List[np.ndarray] = []
        t0 = time.monotonic()
        with self._mutex:
            if self._pending_answer is not None:
                done, self._pending_answer = self._pending_answer, None
                self._learn_from_answer(done)
            if pcm is not None and len(pcm):
                pcm = np.asarray(pcm, dtype=np.int16)
                self._pending = np.concatenate([self._pending, pcm])
                if self._wav_in is not None:
                    self._wav_in.writeframes(pcm.tobytes())
            while len(self._pending) >= self.hop_len:
                raw = self._pending[:self.hop_len].copy()
                self._pending = self._pending[self.hop_len:]
                self._push(raw)
                if STT_RAW:
                    out.append(raw)                   # [STT RAW] the line audio, at once
                # The 300 ms look-ahead is only needed to judge audio heard WHILE THE
                # BOT SPEAKS. In verify mode everything else goes to STT untouched, so
                # holding it back only added 0.3 s to every reply. Release at once.
                need = (0 if (MODE == "verify" and not self._bot_speaking
                              and not (self._get(self._next_release) or _NO_HOP).bot)
                        else LOOKAHEAD_HOPS)
                if need == 0 and self._mute_armed():
                    need = MUTE_LOOKAHEAD_HOPS
                while self._next_idx - 1 - self._next_release >= need:
                    hop = self._get(self._next_release)
                    self._next_release += 1
                    if hop is not None:
                        o = self._release(hop)      # decisions (who is speaking) always run
                        if STT_RAW:
                            self.audio_check["raw_s"] += self._hop_s
                        else:
                            self._audio_check(hop.pcm, o)
                            out.append(o)
            if self._denoiser is not None and out and not STT_RAW:
                out = self._denoise(out)
            if self._wav_out is not None and out:
                self._wav_out.writeframes(np.concatenate(out).astype(np.int16).tobytes())
            dt = time.monotonic() - t0
            self._proc_s += dt
            if pcm is not None:
                self._proc_audio_s += len(pcm) / self.sample_rate
            self._proc_max_ms = max(self._proc_max_ms, dt * 1000.0)
        return out

    def timing(self) -> Dict[str, float]:
        """Cost of the voice lock: share of real time spent in process(), worst
        single call, typical / worst turn check (ms)."""
        j = list(self._judge_ms)
        return {
            "cpu_pct": 100.0 * self._proc_s / max(1e-6, self._proc_audio_s),
            "proc_max_ms": self._proc_max_ms,
            "judge_ms_med": float(np.median(j)) if j else 0.0,
            "judge_ms_max": max(j) if j else 0.0,
        }

    def _open_wav(self, name: str):
        w = wave.open(os.path.join(DEBUG_WAV_DIR, name), "wb")
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(self.sample_rate)
        return w

    def summary(self) -> str:
        s = self.stats
        if self._sims:
            q = np.percentile(np.array(self._sims), [10, 50, 90])
            dist = f" sims p10/p50/p90={q[0]:.2f}/{q[1]:.2f}/{q[2]:.2f}"
        else:
            dist = ""
        return (f"[{self.call_id}] VoiceLock state={self.state.value} thr={self._thr:.2f}/"
                f"{self._thr_clean:.2f} pass={s['pass']} tse={s['tse_ok']} "
                f"tse_fail={s['tse_fail']} soft={s['soft_pass']} hold={s['hold_open']} "
                f"backfill={s['backfill']} other={s['other']} "
                f"unsure={s['uncertain']} noise/silence={s['silence']} last_sim={self._last_sim:.2f}"
                f"{dist} bank={len(self._bank)} cleaned={s['bank_cleaned']} widened={s['widened']} switch={s['switch']} "
                f"foreign_blocked={s['foreign_blocked']} answer_pass={s['answer_pass']} "
                f"mode={MODE} turns_ok={s['turn_customer']} turns_dropped={s['turn_other']} "
                f"relocks={self._relocks} bot_events={'yes' if self._bot_seen else 'NO'} "
                f"proven={'yes' if self._proven else 'no'} "
                f"mixed={s['turn_mixed']} bank_skipped={s['bank_skipped']} gray_kept={s['gray_kept']} "
                f"fast_relock={s['fast_relock']} noise_dropped={s['turn_noise']} loud_dropped={s['loud_drop']} stale_cut={s['stale_cut']} prelock_silenced={s['prelock_silenced'] * self._hop_s:.0f}s weak_rebuild={s['weak_rebuild']} lock_restored={s['lock_restored']} words={self._enroll_words} "
                f"rival={RIVAL}:{len(self._rivals)}known/{s['rival_drop']}dropped/{s['rival_shadow']}shadow "
                f"pitch={np.median(self._cust_f0) if self._cust_f0 else 0:.0f}Hz "
                f"cpu={100.0 * self._proc_s / max(1e-6, self._proc_audio_s):.0f}% "
                f"proc_max={self._proc_max_ms:.0f}ms "
                f"judge_ms={np.median(self._judge_ms) if self._judge_ms else 0:.0f}/"
                f"{max(self._judge_ms) if self._judge_ms else 0:.0f} "
                f"line_speech={self._line_speech_total * self._hop_s:.1f}s "
                f"line_max={max((r for r, _ in self._line_hist), default=0.0):.0f} "
                f"muted_other={s['muted_other'] * self._hop_s:.1f}s barge_blocked={s['barge_blocked']} barge_tv_blocked={s['barge_tv_blocked']} quiet_voice={s['qv_muted_runs']}runs/{s['qv_backfilled']}kept soft={'on' if getattr(self, '_sl_confirmed', False) else ('seed' if getattr(self, '_sl_bank', None) else 'no')}/kept{s['soft_kept']}/doubt{s['soft_doubt']}/dropped{s['soft_dropped'] + s['soft_shadow_drop']}/reseed{s['soft_reseed']} barge_learned={s['barge_learned']} barge_start={s['barge_start'] * self._hop_s:.1f}s machine={s['machine']}/{s['machine_silenced'] * self._hop_s:.0f}s fast_barge={s['fast_barge']}/{s['fast_barge_stt'] * self._hop_s:.1f}s "
                f"denoise={'on' if self._denoiser is not None else 'off'}"
                f"{'/%.0fms' % self._denoiser.ms if self._denoiser is not None else ''}")

    def line_activity(self, seconds: float = 20.0) -> Dict[str, float]:
        """Raw phone-line audio over the last `seconds` (max 60), BEFORE the voice
        lock: loudest 100 ms level, seconds of speech-like audio, seconds received."""
        with self._mutex:
            n = max(1, int(round(min(seconds, 60.0) / self._hop_s)))
            recent = list(self._line_hist)[-n:]
            return {
                "max_rms": max((r for r, _ in recent), default=0.0),
                "speech_s": sum(1 for _, sp in recent if sp) * self._hop_s,
                "received_s": len(recent) * self._hop_s,
            }

    def _fresh_turn(self, audio: List[Tuple[int, np.ndarray]]) -> List[Tuple[int, np.ndarray]]:
        """See STALE CUT. The trailing part of the captured slices with no gap
        longer than TURN_STALE_GAP_S inside it."""
        if TURN_STALE_GAP_S <= 0 or len(audio) < 2:
            return audio
        gap = max(1, int(round(TURN_STALE_GAP_S / self._hop_s)))
        cut = 0
        for k in range(len(audio) - 1, 0, -1):
            if audio[k][0] - audio[k - 1][0] > gap:
                cut = k
                break
        if cut:
            self.stats["stale_cut"] += 1
            logger.info(f"[{self.call_id}] ✂️ {cut * self._hop_s:.1f}s of older sound left out of "
                        f"this turn (it ended {(audio[cut][0] - audio[cut - 1][0]) * self._hop_s:.1f}s "
                        f"before these words)")
            return audio[cut:]
        return audio

    def _judge_hops(self) -> int:
        return max(5, int(round(TURN_JUDGE_MAX_S / self._hop_s)))

    @staticmethod
    def _turn_key(audio) -> Tuple[int, int, int]:
        return (audio[0][0], audio[-1][0], len(audio))

    def prepare_turn(self) -> None:
        """Call when the caller STOPS speaking (VAD), from a worker thread. The
        voice print of the turn so far is computed now, while LiveKit is still
        waiting to see if the caller goes on (0.5-1.8 s), so judge_turn() is
        instant. If they do go on, judge_turn() simply recomputes."""
        with self._mutex:
            if self.state is not LockState.LOCKED or MODE != "verify" or not self._turn_audio:
                return
            audio = self._fresh_turn(list(self._turn_audio))
            prof = self._profile
        key = self._turn_key(audio)
        pcm = np.concatenate([p for _, p in audio[-self._judge_hops():]])
        sim, emb = self._similarity(pcm)
        pieces = (self._piece_scores(audio)
                  if len(audio) * self._hop_s >= SEG_MIN_TURN_S else [])
        with self._mutex:
            if self._profile is prof:
                self._turn_cache = (key, prof, sim, emb, pieces)

    def judge_turn(self) -> Tuple[str, Optional[float]]:
        """Call when a user turn is committed. Returns ("customer" | "other" |
        "unknown", similarity). "other" = drop this transcript.
        The voice print is computed OUTSIDE the lock's mutex, so the audio path
        (process) never waits for it — and usually it was already computed by
        prepare_turn() during the end-of-turn wait."""
        t0 = time.monotonic()
        with self._mutex:
            audio = self._fresh_turn(list(self._turn_audio))
            self._turn_audio.clear()
            self.last_voice_s = len(audio) * self._hop_s if self.state is LockState.LOCKED else None
            cache, self._turn_cache = self._turn_cache, None
            if (NOISE_REJECT and self.state is LockState.LOCKED and MODE == "verify"
                    and len(audio) * self._hop_s < NOISE_TINY_S):
                why = self._noise_only()
                if why:
                    self.stats["turn_noise"] += 1
                    self.last_turn_info = {"mixed": False, "noise": True}
                    logger.warning(f"[{self.call_id}] 🔇 words from NOISE dropped — {why} "
                                   f"in the last {NOISE_ONLY_S:.1f}s")
                    return "other", None
            if self.state is not LockState.LOCKED or MODE != "verify" or not audio:
                return "unknown", None
            prof = self._profile
        key = self._turn_key(audio)
        if cache is not None and cache[0] == key and cache[1] is prof:
            _, _, sim, emb, pieces = cache
            self.stats["judge_cached"] += 1
        else:
            sim, emb = self._similarity(
                np.concatenate([p for _, p in audio[-self._judge_hops():]]))
            pieces = (self._piece_scores(audio)
                      if len(audio) * self._hop_s >= SEG_MIN_TURN_S else [])

        def part_fn():
            sims = [p["sim"] for p in pieces if p["sim"] is not None]
            return max(sims) if sims else None

        with self._mutex:
            self.last_turn_info = {"mixed": False}
            if self.state is not LockState.LOCKED:
                return "unknown", sim
            res = self._judge_locked(audio, sim, emb, part_fn, pieces)
        self._judge_ms.append((time.monotonic() - t0) * 1000.0)
        return res

    def _noise_only(self) -> Optional[str]:
        """See NOISE_REJECT. Why the last NOISE_ONLY_S seconds of audio (all of it
        heard with the bot silent) cannot have been somebody speaking, or None."""
        if self._bot_speaking:
            return None                         # the agent handles words over the bot
        now = self._next_idx
        if self._bot_seen and (now - self._bot_end_idx) * self._hop_s < NOISE_ONLY_S:
            return None                         # may be the end of a barge-in
        if (now - self._last_cust_pass_idx) * self._hop_s < NOISE_ONLY_S:
            return None                         # the customer just spoke over the bot
        if (now - self._last_line_speech_idx) * self._hop_s >= NOISE_ONLY_S:
            return "no speech-like sound on the line (fan / traffic / hum)"
        kinds = list(self._line_kind)
        tone, speech = kinds.count(2), kinds.count(1)
        if -1 not in kinds and tone * self._hop_s >= NOISE_TONE_MIN_S and tone >= 2 * speech:
            return f"a tone / beep / ring ({tone * self._hop_s:.1f}s of pure tone)"
        return None

    def _judge_locked(self, audio, sim, emb, part_fn, pieces=()) -> Tuple[str, Optional[float]]:
        dur = len(audio) * self._hop_s
        pcm = np.concatenate([p for _, p in audio[-100:]])
        loud = _rms(pcm)
        typical = float(np.median(self._cust_rms)) if len(self._cust_rms) >= 2 else None
        quiet = typical is not None and loud < QUIET_RATIO * typical
        if sim is not None:
            self._last_sim = sim
            self._sims.append(sim)
        loud_txt = (f"level {loud:.0f} vs customer {typical:.0f}" if typical
                    else f"level {loud:.0f}")
        mix = self._mixed_analysis(list(pieces), typical) if pieces else {"mixed": False}
        mixed = bool(mix.get("mixed"))
        if mixed:
            self.stats["turn_mixed"] += 1
            logger.warning(f"[{self.call_id}] 👥 MIXED turn — the customer and someone else "
                           f"both spoke ({dur:.1f}s, whole sim {sim if sim is not None else float('nan'):.2f}): "
                           f"{mix.get('timeline')} — kept, NOT learned")
        self.last_turn_info = mix
        # [fix 17] read by the agent's soft drop
        self.last_judge = {"level": float(loud), "typical": typical,
                           "quiet": bool(quiet), "dur": dur}

        if dur < MIN_JUDGE_S and not quiet:
            logger.info(f"[{self.call_id}] 🗣️ turn too short to judge by voice "
                        f"({dur:.1f}s captured, {loud_txt}) — let through")
            return "unknown", sim
        if dur < TURN_MIN_S:
            score, why = self._short_turn_score(pcm, sim, loud, typical, audio[0][0])
            if PROBATION and not self._proven:
                logger.info(f"[{self.call_id}] 🟡 probation: short turn passed "
                            f"({dur:.1f}s, score {score:+d}: {why})")
                return "customer", sim
            if score <= SHORT_DROP_SCORE:
                self.stats["turn_other"] += 1
                logger.warning(f"[{self.call_id}] 🚫 short turn from another voice dropped "
                               f"({dur:.1f}s, score {score:+d}: {why})")
                return "other", sim
            logger.info(f"[{self.call_id}] 🗣️ short turn accepted ({dur:.1f}s, "
                        f"score {score:+d}: {why})")
            return "customer", sim

        if sim is None:
            return "unknown", None

        reject_below = (TURN_REJECT_SIM_MATURE if len(self._bank) >= MATURE_BANK
                        else TURN_REJECT_SIM
                        if (len(self._bank) >= 2 or self._turns_since_lock > 3)
                        else YOUNG_REJECT_SIM)
        self._turns_since_lock += 1
        if PROBATION and not self._proven:
            return self._probation_turn(pcm, sim, emb, dur, loud, quiet, loud_txt, mixed)
        is_other = sim < reject_below or (quiet and sim < AMBIGUOUS_SIM)
        too_loud = bool(LOUD_GUARD and typical and loud > LOUD_RATIO * typical)
        loud_hit = False
        young = self._verified_since_lock < LOUD_GUARD_MIN_TURNS
        if (too_loud and young and not is_other and sim < LOUD_WEAK_SIM and not mixed
                and sim >= HARD_REJECT_COSINE):
            # [29-Oct] young lock: the near-phone voice may be the real caller
            self._loud_young = getattr(self, "_loud_young", [])
            self._loud_young.append((self._answer_id, pcm))
            del self._loud_young[:-4]
            lines = len({a for a, _ in self._loud_young})
            if lines >= LOUD_YOUNG_RELOCK:
                utts = [u for _, u in self._loud_young]
                self._loud_young = []
                self.stats["fast_relock"] += 1
                logger.error(f"[{self.call_id}] 🔁 the voice at the phone ({loud / typical:.1f}x louder "
                             f"than the learned one) answered {lines} bot lines — the young lock was on "
                             f"a voice beside the caller; re-identifying the customer, this turn is kept")
                self._relock_from(utts)
                return "customer", sim
            logger.warning(f"[{self.call_id}] 📢 {loud / typical:.1f}x louder than the learned voice, weak "
                           f"match (sim={sim:.2f}, {dur:.1f}s, {loud_txt}) — the lock is young, so this "
                           f"near-phone voice is KEPT, not learned ({lines}/{LOUD_YOUNG_RELOCK} before the "
                           f"lock moves to it)")
            return "customer", sim
        if too_loud and not is_other and sim < LOUD_WEAK_SIM and not mixed:
            loud_hit = is_other = True
            self.stats["loud_drop"] += 1
            logger.warning(f"[{self.call_id}] 📢 {loud / typical:.1f}x louder than the customer "
                           f"and only a weak voice match (sim={sim:.2f}, {dur:.1f}s, {loud_txt}) "
                           f"— another person near the phone")
        self.last_judge["too_loud"] = too_loud
        rival_hit = False
        if (RIVAL != "off" and not is_other and self._rivals and emb is not None
                and dur >= RIVAL_MIN_S and sim < RIVAL_CUST_SAFE):
            rsim = self._rival_match(emb)
            if rsim >= RIVAL_MIN_SIM and rsim - sim >= RIVAL_MARGIN:
                if RIVAL == "on":
                    rival_hit = is_other = True
                    self.stats["rival_drop"] += 1
                    self.last_judge["rival"] = True
                    logger.warning(f"[{self.call_id}] 👤 this is a voice already known as NOT the "
                                   f"customer (other-voice match {rsim:.2f} vs customer {sim:.2f}, "
                                   f"{dur:.1f}s, {loud_txt})")
                else:
                    self.stats["rival_shadow"] += 1
                    logger.warning(f"[{self.call_id}] 👤 [shadow] WOULD drop — matches a known other "
                                   f"voice {rsim:.2f} vs customer {sim:.2f} ({dur:.1f}s, {loud_txt}); "
                                   f"kept, set TCVL_RIVAL=on to drop")
        if is_other and not rival_hit and not loud_hit and dur >= SEG_MIN_TURN_S:
            part = part_fn()
            if part is not None and part >= SEG_ACCEPT_SIM:
                # the caller spoke in this turn, with someone else before/after
                # them. Keep it — silence here is what made callers hang up.
                # Not learned from: part of it is another voice.
                self._foreign_turns = []
                if not mixed:
                    self.stats["turn_mixed"] += 1
                    self.last_turn_info = {"mixed": True, "timeline": "(piece match only)"}
                logger.info(f"[{self.call_id}] 🗣️ mixed turn kept — the customer's voice is "
                            f"in part of it (part sim={part:.2f}, whole {sim:.2f}, {dur:.1f}s, "
                            f"{loud_txt})")
                return "customer", part
        if not is_other:
            self._foreign_turns = []
            if sim >= PROBATION_PROVE_SIM and not mixed:
                self._loud_foreign = []     # the lock clearly fits the caller
                if not too_loud:
                    self._loud_young = []
            if sim >= BANK_ADD_TURN_SIM and not mixed:
                self._rival_purge(emb)
            self._verified_since_lock += 1
            if dur >= TURN_MIN_S and not mixed:
                f0 = _pitch_hz(pcm, self.sample_rate)
                if f0 is not None:
                    self._cust_f0.append(f0)
            self.stats["turn_customer"] += 1
            self._cust_rms.append(loud)
            if sim >= BANK_ADD_TURN_SIM and emb is not None and not mixed:
                self._bank_add(emb)
            elif emb is not None and sim >= self._thr:
                self.stats["bank_skipped"] += 1
            logger.info(f"[{self.call_id}] 🗣️ turn verified as customer "
                        f"(sim={sim:.2f}, {dur:.1f}s, {loud_txt}, bank={len(self._bank)})")
            self._weak_lock_note(pcm, sim, dur, quiet or too_loud or mixed)
            return "customer", sim

        if GRAY_ZONE and sim >= GRAY_MIN_SIM and not quiet and not rival_hit and not too_loud:
            keep, why = self._gray_zone_keep(pcm, loud, typical, audio[0][0])
            if keep:
                self._foreign_turns = []
                self.stats["gray_kept"] += 1
                logger.warning(f"[{self.call_id}] 🟠 weak voice match KEPT — near-phone voice "
                               f"answering the bot (sim={sim:.2f}, {dur:.1f}s, {why}); not learned")
                return "customer", sim

        self.stats["turn_other"] += 1
        if not rival_hit and not quiet:
            self._rival_learn(emb, dur, "dropped turn")
        # A known other voice does not count towards the FAST re-lock (it would hand
        # the lock to the bystander). The slower rule below still applies: only
        # that voice answering TURN_RELOCK_COUNT bot lines in a row, with no
        # customer turn in between, moves the lock.
        if (FAST_RELOCK and not rival_hit and not too_loud
                and self._answers_bot_loudly(loud, typical, audio[0][0], dur)):
            self._loud_foreign.append((self._answer_id, pcm))
            del self._loud_foreign[:-4]
            lines = len({a for a, _ in self._loud_foreign})
            if lines >= FAST_RELOCK_COUNT:
                utts = [u for _, u in self._loud_foreign]
                self._loud_foreign = []
                self._foreign_turns = []
                self.stats["fast_relock"] += 1
                logger.error(f"[{self.call_id}] 🔁 {len(utts)} loud answers to the bot were "
                             f"dropped as another voice (last sim={sim:.2f}, {loud_txt}) — "
                             f"the lock is on the wrong voice; re-identifying the customer "
                             f"from those answers, this turn is kept")
                self._relock_from(utts)
                return "customer", sim
            logger.warning(f"[{self.call_id}] ⚠️ dropped turn is loud and answers the bot "
                           f"({lines}/{FAST_RELOCK_COUNT} before the lock is moved)")
        if not quiet:
            self._foreign_add(pcm)
        need_foreign = (TURN_RELOCK_COUNT_UNPROVEN if self._verified_since_lock == 0
                        else TURN_RELOCK_COUNT)
        if self._foreign_answers_distinct() >= need_foreign:
            # the only (loud, near-phone) voice talking to the bot for several
            # turns → the phone changed hands; follow the person on the line
            utts = self._foreign_turns
            self._foreign_turns = []
            logger.error(f"[{self.call_id}] 🔁 {len(utts)} turns in a row from a different "
                         f"voice (last sim={sim:.2f}) — re-identifying the customer")
            self._relock_from(utts)
            return "customer", sim
        logger.warning(f"[{self.call_id}] 🚫 turn from a DIFFERENT voice dropped "
                       f"(sim={sim:.2f}, {dur:.1f}s, {loud_txt}{', too quiet' if quiet else ''})")
        return "other", sim

    def _weak_lock_note(self, pcm: np.ndarray, sim: float, dur: float, skip: bool) -> None:
        """See WEAK LOCK. Called for every turn kept as the customer."""
        if (not WEAK_LOCK or self._weak_rebuilds >= WEAK_LOCK_MAX
                or len(self._bank) >= WEAK_LOCK_BANK or sim >= WEAK_LOCK_SIM):
            self._weak_turns = []
            return
        if skip or dur < TURN_MIN_S:
            return
        f0 = _pitch_hz(pcm, self.sample_rate)
        if f0 is not None and self._cust_f0:
            ref = float(np.median(self._cust_f0))
            if abs(12.0 * np.log2(f0 / ref)) > SHORT_PITCH_DIFF_ST:
                return                               # a different pitch: not counted
        self._weak_turns.append(pcm)
        del self._weak_turns[:-(WEAK_LOCK_TURNS + 2)]
        secs = sum(len(u) for u in self._weak_turns) / self.sample_rate
        if len(self._weak_turns) < WEAK_LOCK_TURNS or secs < ENROLL_MIN_SECONDS:
            return
        utts = self._weak_turns
        self._weak_turns = []
        self._weak_rebuilds += 1
        self.stats["weak_rebuild"] += 1
        logger.error(f"[{self.call_id}] 🔁 WEAK LOCK: {len(utts)} of the caller's turns in a row "
                     f"matched badly (last sim={sim:.2f}, profile never learned) — rebuilding "
                     f"the lock from those {secs:.1f}s; nothing is dropped meanwhile")
        self._relock_from(utts)

    def _restore_prev_lock(self) -> bool:
        """See KEEP OLD LOCK. Called with the mutex held."""
        p = self._prev_lock
        if not KEEP_OLD_LOCK or p is None:
            return False
        self._prev_lock = None
        self._profile, self._anchor = p["profile"], p["anchor"]
        self._bank = p["bank"]
        self._thr, self._thr_clean = p["thr"], p["thr_clean"]
        self._tse_ref = p["tse_ref"]
        self._tse_cache = None
        self._cust_f0 = collections.deque(p["cust_f0"], maxlen=20)
        self._cust_rms = collections.deque(p["cust_rms"], maxlen=20)
        self._proven = p["proven"]
        self._verified_since_lock = p["verified"]
        self._turns_since_lock = p["turns"]
        self._utts, self._utt_aids = [], []
        self._attempts, self._best = 0, None
        self._foreign_turns, self._probation_turns, self._loud_foreign = [], [], []
        self._weak_turns = []
        self._run_open = False
        self.state = LockState.LOCKED
        self.stats["lock_restored"] += 1
        logger.error(f"[{self.call_id}] ↩️ could not identify a new voice — the previous lock is "
                     f"back in place (thr={self._thr:.2f}, bank={len(self._bank)})")
        return True

    def _gray_zone_keep(self, pcm: np.ndarray, loud: float, typical: Optional[float],
                        first_idx: int) -> Tuple[bool, str]:
        """A weak-scoring turn that still looks like the person holding the phone
        answering the bot. See GRAY_ZONE."""
        why = []
        if typical:
            r = loud / typical
            why.append(f"level {r:.2f}x")
            if r < GRAY_LOUD_RATIO:
                return False, ", ".join(why)
        else:
            why.append("level n/a")
        if not self._bot_seen or self._bot_end_idx <= 0 or self._bot_speaking:
            return False, ", ".join(why + ["no bot line to answer"])
        since = (first_idx - self._bot_end_idx) * self._hop_s
        why.append(f"{since:.1f}s after the bot")
        if not (0.0 <= since <= GRAY_ANSWER_S):
            return False, ", ".join(why)
        f0 = _pitch_hz(pcm, self.sample_rate)
        if f0 is not None and self._cust_f0:
            ref = float(np.median(self._cust_f0))
            st = abs(12.0 * np.log2(f0 / ref))
            why.append(f"pitch {f0:.0f}/{ref:.0f}Hz")
            if st > SHORT_PITCH_DIFF_ST:
                return False, ", ".join(why)
        return True, ", ".join(why)

    def _rival_learn(self, emb: Optional[np.ndarray], secs: float, why: str) -> None:
        """Remember the voice print of audio that was judged NOT the customer."""
        if RIVAL == "off" or emb is None or self._profile is None or secs < RIVAL_LEARN_MIN_S:
            return
        if float(np.dot(emb, self._profile)) >= RIVAL_LEARN_MAX_CUST_SIM:
            return                                   # too close to the customer to be sure
        e = emb.astype(np.float32)
        if self._rivals:
            sims = [float(np.dot(e, r)) for r in self._rivals]
            k = int(np.argmax(sims))
            if sims[k] >= RIVAL_MERGE_SIM:           # the same other person again
                self._rivals[k] = _norm(self._rivals[k] + e)
                return
        self._rivals.append(e)
        del self._rivals[:-RIVAL_MAX]
        self.stats["rival_learned"] += 1
        logger.info(f"[{self.call_id}] 👤 another voice remembered ({why}, {secs:.1f}s) — "
                    f"{len(self._rivals)} known other voice(s)")

    def _rival_match(self, emb: Optional[np.ndarray]) -> float:
        if emb is None or not self._rivals:
            return -1.0
        return max(float(np.dot(emb, r)) for r in self._rivals)

    def _rival_purge(self, emb: Optional[np.ndarray]) -> None:
        """A clearly-verified customer turn matches a 'rival' → it was the customer."""
        if emb is None or not self._rivals:
            return
        keep = [r for r in self._rivals if float(np.dot(emb, r)) < RIVAL_PURGE_SIM]
        if len(keep) != len(self._rivals):
            logger.warning(f"[{self.call_id}] 👤 {len(self._rivals) - len(keep)} remembered "
                           f"'other' voice(s) match the customer — forgotten")
            self._rivals = keep

    def _answers_bot_loudly(self, loud: float, typical: Optional[float],
                            first_idx: int, dur: float) -> bool:
        """See FAST_RELOCK."""
        if dur < FAST_RELOCK_MIN_S:
            return False
        ref = typical or (max(self._cust_rms) if self._cust_rms else None)
        if not ref or loud < FAST_RELOCK_LOUD_RATIO * ref:
            return False
        if not self._bot_seen or self._bot_end_idx <= 0 or self._bot_speaking:
            return False
        since = (first_idx - self._bot_end_idx) * self._hop_s
        return 0.0 <= since <= GRAY_ANSWER_S

    def _foreign_add(self, pcm: np.ndarray) -> None:
        self._foreign_turns.append(pcm)
        self._foreign_aids.append(self._answer_id)
        del self._foreign_aids[:-50]

    def _foreign_answers_distinct(self) -> int:
        """How many DIFFERENT bot lines the current run of foreign turns answered.
        Someone talking on and on beside the caller is one 'answer', not three —
        only a new person who keeps answering the bot takes the lock over. Without
        bot events every turn counts."""
        n = len(self._foreign_turns)
        if n == 0:
            return 0
        if not self._bot_seen:
            return n
        return len(set(self._foreign_aids[-n:]))

    # ── for the agent: who may interrupt the bot ───────────────────────────
    @property
    def bot_speaking(self) -> bool:
        return self._bot_speaking

    def customer_active(self, within_s: float = CUSTOMER_ACTIVE_S) -> bool:
        """True if the customer's own voice was passed (while the bot was
        speaking) within the last `within_s` seconds of audio."""
        return (self._next_idx - self._last_cust_pass_idx) * self._hop_s <= within_s

    def vad_should_mute(self) -> bool:
        """The agent should feed its VAD silence right now: the bot is speaking,
        the customer is locked, and the customer is not the one talking."""
        if getattr(self, "_mg_on", False):
            return True                           # [MACHINE] a recorded voice: VAD hears silence
        if (QUIET_VOICE == "on" and self.state is not LockState.LOCKED
                and getattr(self, "_qv_vad_mute", False)):
            return True                           # [QUIET VOICE] held / muted stretch
        if not self._bot_speaking:
            # [TV VAD] bot silent: TV-only audio may be muted for the VAD
            return bool(TV_VAD == "on" and getattr(self, "_tvv_mute", False))
        if self.state is LockState.LOCKED:
            if self.customer_active():
                return False
            if FAST_BARGE and self.loud_barge_recent(FAST_BARGE_HOLD_S):
                return False                       # v5.0: caller-level voice — let it interrupt now
            return True
        # PRE-LOCK NOISE GATE: no voice print yet — only non-voice sound is muted
        if (PRELOCK_NOISE
                and (self._next_idx - self._any_speech_idx) * self._hop_s > PRELOCK_HANG_S):
            return True
        # v5.0 BARGE GUARD: a voice far quieter than the caller cannot interrupt
        ref = self._caller_level()
        if PRELOCK_BARGE_GUARD and ref:
            recent = max(self._recent_voice) if self._recent_voice else 0.0
            if recent < PRELOCK_BARGE_RATIO * ref:
                self.stats["barge_blocked"] += 1
                return True
            # [v10 BARGE TV GUARD] a non-stop voice is on the line: stricter
            if (BARGE_TV_GUARD != "off" and getattr(self, "_tv_held", False)
                    and recent < PRELOCK_BARGE_RATIO_TV * ref):
                self.stats["barge_tv_blocked"] += 1
                now = time.monotonic()
                if now - getattr(self, "_btg_logged", 0.0) > 10.0:
                    self._btg_logged = now
                    logger.info(f"[{self.call_id}] 📺 {'' if BARGE_TV_GUARD == 'on' else '[shadow] '}"
                                f"a voice at {recent / ref:.0%} of the caller's level over the bot "
                                f"{'cannot' if BARGE_TV_GUARD == 'on' else 'would not'} interrupt it "
                                f"while a non-stop voice is on the line (needs "
                                f"{PRELOCK_BARGE_RATIO_TV:.0%})")
                if BARGE_TV_GUARD == "on":
                    return True
        return False

    def loud_barge_recent(self, within_s: float = 3.0) -> bool:
        """v5.0: a voice as loud as the caller's answers was heard over the bot
        within the last `within_s` seconds (the caller interrupting)."""
        return FAST_BARGE and (self._next_idx - self._loud_barge_idx) * self._hop_s <= within_s

    def _caller_level(self) -> Optional[float]:
        """v5.0: typical loudness of the caller's answers, or None (not known yet)."""
        if len(self._ans_rms) < PRELOCK_REF_HOPS:
            return None
        # the LOUD part of the answers (words, not the quiet slices between them)
        return float(np.percentile(self._ans_rms, 80))

    def _barge_track(self, hop: _Hop) -> None:
        """v5.0 BARGE-IN ENROLLMENT: keep loud speech heard over the bot; when the
        bot stops while it is going on (the caller interrupted), learn it."""
        if not BARGE_ENROLL:
            return
        if getattr(self, "_mg_on", False):
            self._barge_hops = []
            self._barge_commit = False
            return
        if self._barge_commit:
            self._barge_commit = False
            hops, self._barge_hops = self._barge_hops, []
            if (hops and self._enroll_open and self.state is LockState.ENROLLING
                    and hop.idx - hops[-1][0] <= ENROLL_UTT_GAP_HOPS + 1
                    and len(hops) * self._hop_s >= BARGE_ENROLL_MIN_S):
                # the caller interrupting the bot is not TV: take it out of the
                # "voice talking over the bot" (BGM_GUARD) evidence
                n_bgm = sum(1 for h in hops if h[2])
                buf = getattr(self, "_bgm_buf", None)
                if n_bgm:
                    self._bgm_speech_hops = max(0, getattr(self, "_bgm_speech_hops", 0) - n_bgm)
                    for _ in range(min(n_bgm, len(buf) if buf is not None else 0)):
                        buf.pop()
                self._utts.append([h[1] for h in hops])
                self._utt_aids.append(self._answer_id)
                self._enroll_speech_s += len(hops) * self._hop_s
                self._last_enroll_idx = hop.idx
                self.stats["barge_learned"] += 1
                logger.info(f"[{self.call_id}] 🗣️ caller interrupted the bot — "
                            f"{len(hops) * self._hop_s:.1f}s of it learned as an answer")
                self._maybe_build()
            return
        if not (hop.bot and hop.speech):
            if self._barge_hops and hop.idx - self._barge_hops[-1][0] > ENROLL_UTT_GAP_HOPS and hop.bot:
                self._barge_hops = []
            return
        ref = self._caller_level()
        recent = max(self._recent_voice) if self._recent_voice else 0.0
        if ref is None or recent < BARGE_ENROLL_RATIO * ref:
            return
        if TV_NEAR_ENROLL and self._tv_near_active() and not self._tv_near_hop(hop):
            return                      # [TV NEAR] the TV talking over the bot
        if self._barge_hops and hop.idx - self._barge_hops[-1][0] > ENROLL_UTT_GAP_HOPS:
            self._barge_hops = []
        st = getattr(self, "_bgm_bot_start", None)
        in_bgm = bool(BGM_GUARD and st is not None and hop.idx - st >= BGM_SKIP_HOPS)
        self._barge_hops.append((hop.idx, hop.pcm, in_bgm))
        del self._barge_hops[:-int(4.0 / self._hop_s)]

    def _relock_from(self, utts: List[np.ndarray]) -> None:
        self._prob_anchor_n = 0
        if self._profile is not None:
            self._prev_lock = {
                "profile": self._profile, "anchor": self._anchor, "bank": list(self._bank),
                "thr": self._thr, "thr_clean": self._thr_clean, "tse_ref": self._tse_ref,
                "cust_f0": list(self._cust_f0), "cust_rms": list(self._cust_rms),
                "proven": self._proven, "verified": self._verified_since_lock,
                "turns": self._turns_since_lock,
            }
        self._weak_turns = []
        self._relocks += 1
        self.state = LockState.ENROLLING
        self._profile = None
        self._bank = []
        self._cust_rms.clear()
        self._attempts = 0
        self._best = None
        self._probation_turns = []
        self._loud_foreign = []
        self._rivals = []
        self._utts = [[u] for u in utts]
        self._utt_aids = list(range(-len(utts), 0))   # separate turns
        self._enroll_speech_s = sum(len(u) for u in utts) / self.sample_rate
        self._maybe_build()

    def _probation_turn(self, pcm, sim, emb, dur, loud, quiet, loud_txt,
                        mixed: bool = False) -> Tuple[str, float]:
        """A long turn while the lock is not yet confirmed. Never dropped."""
        if sim >= PROBATION_PROVE_SIM and dur >= PROBATION_PROVE_S:
            self._proven = True
            self._prob_anchor_n = 0
            self._probation_turns = []
            self._foreign_turns = []
            self._verified_since_lock += 1
            self.stats["turn_customer"] += 1
            self._cust_rms.append(loud)
            if emb is not None and sim >= BANK_ADD_TURN_SIM and not mixed:
                self._bank_add(emb)
            f0 = _pitch_hz(pcm, self.sample_rate)
            if f0 is not None:
                self._cust_f0.append(f0)
            logger.info(f"[{self.call_id}] ✅ lock confirmed — this turn clearly matches it "
                        f"(sim={sim:.2f}, {dur:.1f}s, {loud_txt}); normal filtering from now on")
            return "customer", sim
        self.stats["probation_pass"] += 1
        if not quiet:
            self._probation_turns.append(pcm)
        if sim < PROBATION_MISMATCH_SIM and not quiet:
            self._foreign_add(pcm)
        else:
            self._foreign_turns = []
        logger.warning(f"[{self.call_id}] 🟡 probation: turn passed (sim={sim:.2f}, {dur:.1f}s, "
                       f"{loud_txt}) — lock not confirmed yet"
                       f"{f', mismatch {len(self._foreign_turns)}/{TURN_RELOCK_COUNT_UNPROVEN}' if self._foreign_turns else ''}")
        if (RELOCK_GUARD != "off" and (self._foreign_answers_distinct() >= TURN_RELOCK_COUNT_UNPROVEN
                                        or len(self._probation_turns) >= PROBATION_MAX_TURNS)
                and getattr(self, "_prob_anchor_n", 0) < 2):
            seed = self._sl_seed_print()
            agree = (float(np.dot(seed, self._profile))
                     if seed is not None and self._profile is not None else None)
            if agree is not None and agree >= RELOCK_GUARD_SEED_SIM:
                # [02-Nov …65862] the lock agrees with the voice that answered the greeting
                # (two independent clues), and none of these turns was confirmed by the
                # agent as the caller → it is people beside the caller, not a wrong lock
                self.stats["relock_guarded"] += 1
                if self.stats["relock_guarded"] == 1:
                    logger.warning(f"[{self.call_id}] 🛡️ re-lock refused — the lock matches the first "
                               f"answer ({agree:.2f}) and fewer than 2 of the {max(len(self._probation_turns), len(self._foreign_turns))} "
                               f"other-voice turns were confirmed as the caller"
                               f"{' [shadow: re-locking anyway]' if RELOCK_GUARD == 'shadow' else ''}")
                if RELOCK_GUARD == "on":
                    # the turns are KEPT: as soon as the agent confirms 2 turns as the
                    # caller's, the re-lock goes ahead (a wrong seed + wrong lock)
                    del self._probation_turns[:-PROBATION_MAX_TURNS]
                    return "customer", sim
        if self._foreign_answers_distinct() >= TURN_RELOCK_COUNT_UNPROVEN:
            utts = self._foreign_turns
            self._foreign_turns = []
            logger.error(f"[{self.call_id}] 🔁 the new lock doesn't match the caller "
                         f"({len(utts)} turns in a row, last sim={sim:.2f}) — re-identifying, "
                         f"nothing was dropped")
            self._relock_from(utts)
        elif len(self._probation_turns) >= PROBATION_MAX_TURNS:
            utts = self._probation_turns
            logger.error(f"[{self.call_id}] 🔁 lock never confirmed after {len(utts)} turns — "
                         f"rebuilding it from the voice that is actually talking to the bot")
            self._relock_from(utts)
        return "customer", sim

    def _short_turn_score(self, pcm: np.ndarray, sim: Optional[float], loud: float,
                          typical: Optional[float], first_idx: int) -> Tuple[int, str]:
        score, why = 0, []
        if sim is not None:
            d = 2 if sim >= 0.40 else -2 if sim < SHORT_TURN_REJECT_SIM else -1 if sim < 0.15 else 0
            score += d
            why.append(f"voice {sim:.2f}({d:+d})")
        if typical:
            r = loud / typical
            d = 1 if r >= 0.6 else -3 if r < 0.2 else -2 if r < QUIET_RATIO else 0
            score += d
            why.append(f"level {r:.2f}x({d:+d})")
        f0 = _pitch_hz(pcm, self.sample_rate)
        if f0 is not None and self._cust_f0:
            ref = float(np.median(self._cust_f0))
            st = abs(12.0 * np.log2(f0 / ref))
            d = (1 if st <= SHORT_PITCH_SAME_ST else -3 if st > SHORT_PITCH_FAR_ST
                 else -2 if st > SHORT_PITCH_DIFF_ST else 0)
            score += d
            why.append(f"pitch {f0:.0f}/{ref:.0f}Hz({d:+d})")
        if self._bot_seen and self._bot_end_idx > 0:
            since = (first_idx - self._bot_end_idx) * self._hop_s
            if POST_BOT_GRACE_S <= since <= 4.0:
                score += 1
                why.append(f"answer {since:.1f}s after bot(+1)")
        self.stats["short_scored"] += 1
        return score, ", ".join(why) or "no clues"

    def take_turn_raw(self) -> np.ndarray:
        """The caller's latest answer exactly as it came off the phone line
        (int16, self.sample_rate), then forgotten. Empty if nothing was said."""
        with self._mutex:
            pcm = (np.concatenate(list(self._raw_turn)) if self._raw_turn
                   else np.zeros(0, dtype=np.int16))
            self._raw_turn.clear()
            self._raw_started = False
            return pcm

    def _turn_pieces(self, audio: List[Tuple[int, np.ndarray]]) -> List[Tuple[int, int, np.ndarray]]:
        """The turn cut at pauses (long stretches at SEG_MAX_S); a too-short piece
        joins the one before. Returns (first hop idx, last hop idx, pcm)."""
        min_h = max(1, int(round(SEG_MIN_S / self._hop_s)))
        max_h = max(min_h, int(round(SEG_MAX_S / self._hop_s)))
        pieces: List[List[Tuple[int, np.ndarray]]] = []
        cur: List[Tuple[int, np.ndarray]] = []
        last = None
        for idx, p in audio:
            if cur and (idx - last > RUN_GAP_HOPS + 1 or len(cur) >= max_h):
                pieces.append(cur)
                cur = []
            cur.append((idx, p))
            last = idx
        if cur:
            pieces.append(cur)
        merged: List[List[Tuple[int, np.ndarray]]] = []
        for pc in pieces:
            if merged and len(merged[-1]) < min_h:
                merged[-1] = merged[-1] + pc
            else:
                merged.append(pc)
        if len(merged) > 1 and len(merged[-1]) < min_h:
            tail = merged.pop()
            merged[-1] = merged[-1] + tail
        return [(pc[0][0], pc[-1][0], np.concatenate([x for _, x in pc]))
                for pc in merged if len(pc) >= min_h]

    def _piece_scores(self, audio: List[Tuple[int, np.ndarray]]) -> List[Dict]:
        """Voice print + pitch + level of each piece (last MIXED_MAX_PIECES).
        Expensive (one voice print per piece) — call OUTSIDE the mutex."""
        pcs = self._turn_pieces(audio)
        if len(pcs) < 2:
            return []
        t0 = audio[0][0]
        out = []
        for a, b, pcm in pcs[-MIXED_MAX_PIECES:]:
            sim, _pemb = self._similarity(pcm)
            out.append({"t0": (a - t0) * self._hop_s, "t1": (b - t0 + 1) * self._hop_s,
                        "sim": sim, "f0": _pitch_hz(pcm, self.sample_rate), "rms": _rms(pcm),
                        "pcm": pcm, "emb": _pemb})
        return out

    def _best_part_sim(self, audio: List[Tuple[int, np.ndarray]]) -> Optional[float]:
        sims = [p["sim"] for p in self._piece_scores(audio) if p["sim"] is not None]
        return max(sims) if sims else None

    def _mixed_analysis(self, pieces: List[Dict], typical: Optional[float]) -> Dict:
        """Did the customer AND someone else speak in this turn?"""
        info: Dict = {"mixed": False}
        scored = [p for p in pieces if p["sim"] is not None]
        if len(scored) < 2:
            return info
        ref_f0 = float(np.median(self._cust_f0)) if self._cust_f0 else None
        cust_s = other_s = 0.0
        parts = []
        _keep = []                          # [fix 18] audio of the pieces that are not OTHER
        n_cust = n_other = 0
        for p in scored:
            sim, f0 = p["sim"], p["f0"]
            far = (ref_f0 is not None and f0 is not None
                   and abs(12.0 * np.log2(f0 / ref_f0)) > SHORT_PITCH_DIFF_ST)
            quiet = typical is not None and p["rms"] < QUIET_RATIO * typical
            if sim >= MIXED_CUST_SIM:
                who = "customer"
                n_cust += 1
                cust_s += p["t1"] - p["t0"]
            elif sim < MIXED_OTHER_SIM or (sim < MIXED_WEAK_SIM and (far or quiet)):
                who = "OTHER"
                n_other += 1
                other_s += p["t1"] - p["t0"]
            else:
                who = "unsure"
            if who != "OTHER" and p.get("pcm") is not None:
                _keep.append(p["pcm"])
            if who == "OTHER" and not quiet and self._proven:
                self._rival_learn(p.get("emb"), p["t1"] - p["t0"], "other voice inside a turn")
            extra = f", {f0:.0f}Hz" if f0 is not None else ""
            parts.append(f"{p['t0']:.1f}-{p['t1']:.1f}s {who} ({sim:.2f}{extra})")
        info.update({
            "mixed": n_cust > 0 and n_other > 0,
            "customer_s": round(cust_s, 1),
            "other_s": round(other_s, 1),
            "timeline": " | ".join(parts),
            "customer_pitch": round(ref_f0) if ref_f0 else None,
        })
        if info["mixed"] and _keep:
            info["customer_pcm"] = np.concatenate(_keep)     # [fix 18]
        return info

    def close(self) -> None:
        logger.info(self.summary())
        with self._mutex:
            for w in (self._wav_in, self._wav_out):
                if w is not None:
                    try:
                        w.close()
                    except Exception:
                        pass
            if self._wav_in is not None:
                logger.info(f"[{self.call_id}] 🎧 debug audio saved: "
                            f"{os.path.join(DEBUG_WAV_DIR, self.call_id)}_in.wav / _out.wav")
            self._wav_in = self._wav_out = None

    # ── streaming internals ───────────────────────────────────────────────
    def _get(self, idx: int) -> Optional[_Hop]:
        if not self._ring:
            return None
        k = idx - self._ring[0].idx
        return self._ring[k] if 0 <= k < len(self._ring) else None

    def _span(self, lo: int, hi: int) -> np.ndarray:
        parts = [h.pcm for h in self._ring if lo <= h.idx <= hi]
        return np.concatenate(parts) if parts else np.zeros(0, dtype=np.int16)

    def _voice_span(self, center: int, back: int = WINDOW_BACK_HOPS) -> np.ndarray:
        """Speech hops around `center`, from the SAME sentence only: never across a
        pause, and never before the point where another voice took over."""
        def walk(step: int, limit: int) -> List[_Hop]:
            got, gap, i = [], 0, center + step
            while abs(i - center) <= limit:
                if step < 0 and i < self._run_start_idx:
                    break
                h = self._get(i)
                if h is None:
                    break
                if h.speech:
                    got.append(h)
                    gap = 0
                else:
                    gap += 1
                    if gap > RUN_GAP_HOPS:
                        break
                i += step
            return got
        me = self._get(center)
        back_h = list(reversed(walk(-1, back)))
        fwd = walk(+1, LOOKAHEAD_HOPS)
        parts = [h.pcm for h in back_h] + ([me.pcm] if me is not None else []) + [h.pcm for h in fwd]
        return np.concatenate(parts) if parts else np.zeros(0, dtype=np.int16)

    def _push(self, raw: np.ndarray) -> None:
        rms = _rms(raw)
        self._rms_hist.append(rms)
        self._bg = max(5.0, float(np.percentile(self._rms_hist, BG_PERCENTILE)))
        loud_enough = rms >= max(ABS_SPEECH_RMS, SPEECH_OVER_BG * self._bg)
        sfm = _sfm(raw) if loud_enough else 1.0
        speech = loud_enough and SFM_MIN <= sfm <= SFM_MAX
        self._line_kind.append(-1 if self._bot_speaking else 1 if speech
                               else 2 if (loud_enough and sfm < SFM_MIN) else 0)
        voice = bool(speech)
        if self._voice_det is not None:
            try:
                voice = self._voice_det.prob(raw) >= PRELOCK_VOICE_PROB
            except Exception as e:
                self._voice_det = None
                logger.error(f"[{self.call_id}] Silero VAD failed ({e}) — pre-lock gate "
                             f"falls back to the simple speech test")
        if voice:
            self._any_speech_idx = self._next_idx
        hop = _Hop(self._next_idx, raw, rms, speech, speech and self._is_answer_time(),
                   self._bot_speaking)
        hop.voice = voice
        self._line_hist.append((rms, bool(speech and not self._bot_speaking)))
        if speech and not self._bot_speaking:
            self._line_speech_total += 1
            self._last_line_speech_idx = self._next_idx
        self._ring.append(hop)
        self._next_idx += 1
        if TV_VAD != "off":
            try:
                self._tv_vad_track(hop)
            except Exception as e:
                now = time.monotonic()
                if now - getattr(self, "_tvv_err_ts", 0.0) > 10.0:
                    self._tvv_err_ts = now
                    logger.error(f"[{self.call_id}] TV VAD error (VAD left open): {e}")
                self._tvv_mute = False
        if MACHINE_GUARD and self.state is LockState.ENROLLING:
            try:
                self._machine_track(hop)
            except Exception as e:
                self._mg_on = False
                logger.error(f"[{self.call_id}] machine guard error (off): {e}")
        if TV_HOLD and self.state is LockState.ENROLLING:
            _st0 = getattr(self, "_bgm_bot_start", None)
            if self._bot_speaking:
                _kind = 1 if (_st0 is not None and hop.idx - _st0 >= TV_HOLD_SKIP_HOPS) else 0
            else:
                _kind = 2 if self._bot_seen else 0
            if _kind:
                if getattr(self, "_tv_hist", None) is None:
                    self._tv_hist = collections.deque(maxlen=max(20, int(TV_HOLD_WINDOW_S / self._hop_s)))
                self._tv_hist.append((_kind, bool(hop.voice)))
                if _kind == 1 and hop.voice:
                    if getattr(self, "_tv_lvls", None) is None:
                        self._tv_lvls = collections.deque(maxlen=300)
                    self._tv_lvls.append(float(rms))
            # [TV NEAR] did a near-phone voice get through after this bot line?
            if (_kind == 2 and self._tv_near_base() and hop.voice
                    and hop.rms >= TV_NEAR_X * self._tv_level()):
                self._tv_near_seen = True
        if BGM_GUARD and self._bot_speaking and self.state is LockState.ENROLLING:
            _st = getattr(self, "_bgm_bot_start", None)
            if _st is not None and hop.idx - _st >= BGM_SKIP_HOPS:
                self._bgm_bot_hops = getattr(self, "_bgm_bot_hops", 0) + 1
                if speech:
                    if getattr(self, "_bgm_buf", None) is None:
                        self._bgm_buf = collections.deque(
                            maxlen=max(10, int(BGM_BUFFER_S / self._hop_s)))
                    self._bgm_buf.append(raw)
                    self._bgm_speech_hops = getattr(self, "_bgm_speech_hops", 0) + 1
        if speech and not self._raw_started:
            self._raw_started = True
            self._raw_turn.extend(self._raw_preroll)
        if self._raw_started:
            self._raw_turn.append(raw)
        else:
            self._raw_preroll.append(raw)
        # ── v5.0 levels ──────────────────────────────────────────────
        self._recent_voice.append(rms if voice else 0.0)
        if self._bot_speaking and voice:
            _ref = self._caller_level()
            _nfb = max(1, FAST_BARGE_HOPS)
            _last3 = list(self._recent_voice)[-_nfb:]
            # sustained (FAST_BARGE_HOPS slices), not a single loud spike from a TV / a door
            if _ref and len(_last3) == _nfb and min(_last3) >= FAST_BARGE_RATIO * _ref:
                if (FAST_BARGE and self.state is LockState.LOCKED
                        and getattr(self, "_fb_logged_aid", None) != self._answer_id):
                    self._fb_logged_aid = self._answer_id
                    self._fb_t0 = time.monotonic()
                    self.stats["fast_barge"] += 1
                    logger.info(f"[{self.call_id}] ⚡ caller interrupted the bot (voice as loud as the "
                                f"caller) — bot allowed to stop at once; the words are still checked")
                self._loud_barge_idx = self._next_idx
        # [BARGE LOG 21-Oct] the loud voice ended and the bot talked on (a short
        # "hmm" / the end of the caller's own word): it was not an interruption, so
        # do not let the NEXT stop of the bot be timed from it ("stopped 6.8s
        # after their voice was heard" on …59204 was the bot's next reply ending).
        _t0 = getattr(self, "_fb_t0", None)
        if (_t0 is not None and self._bot_speaking
                and (self._next_idx - self._loud_barge_idx) * self._hop_s > FAST_BARGE_END_S):
            self._fb_t0 = None
            self._fb_logged_aid = None        # a real interruption later in this line is timed again
            self.stats["fast_barge_short"] += 1
            logger.info(f"[{self.call_id}] ⚡ short sound over the bot ({time.monotonic() - _t0:.1f}s ago) "
                        f"— not an interruption, the bot kept talking")
        if speech and hop.answer:
            self._ans_rms.append(rms)
            _ar = getattr(self, "_aid_rms", None)
            if _ar is None:
                _ar = self._aid_rms = {}
            _ar.setdefault(self._answer_id, []).append(float(rms))
            for _k in [k for k in _ar if k < self._answer_id - 6]:
                del _ar[_k]
        if self.state is LockState.ENROLLING:
            self._barge_track(hop)
            if DIARIZE != "off":
                try:
                    self._diar_observe(hop)
                except Exception as e:
                    logger.debug(f"[{self.call_id}] diarize observe error: {e}")
            self._enroll_observe(hop)
        if self._next_idx % STATS_EVERY_HOPS == 0:
            logger.info(self.summary())

    def _release(self, hop: _Hop) -> np.ndarray:
        if ((SOFT_LOCK != "off" or CLUES != "off") and self._enroll_open
                and (self.state is not LockState.LOCKED or not self._proven)):
            if hop.voice and not hop.bot:
                b = getattr(self, "_sl_buf", None)
                if b is None:
                    b = self._sl_buf = collections.deque(maxlen=120)
                b.append((hop.pcm, float(hop.rms), hop.idx))
        if (MACHINE_GUARD and self.state is not LockState.LOCKED and hop.bot
                and getattr(self, "_mg_lines", 0) == 1 and not getattr(self, "_mg_decided", False)):
            # [MACHINE] during the greeting the bot cannot be interrupted anyway: keep
            # what is heard until we know whether it is a machine (then dropped) or a
            # person (then sent to STT in one piece, nothing lost)
            if hop.voice or hop.speech:
                g = getattr(self, "_mg_greet", None)
                if g is None:
                    g = self._mg_greet = []
                g.append(hop.pcm)
            return self._shape(hop.pcm, None)
        if getattr(self, "_mg_on", False) and self.state is not LockState.LOCKED:
            # [MACHINE] a recorded voice: STT hears silence; the last second is kept
            # so a person's first words are not lost when the guard lets go
            held = getattr(self, "_mg_held", None)
            if held is None:
                held = self._mg_held = []
            held.append((hop.idx, hop.pcm))
            del held[:-10]
            if hop.voice:
                ma = getattr(self, "_mg_audio", None)
                if ma is not None and len(ma) < int(MACHINE_AUDIO_MAX_S / self._hop_s):
                    ma.append(hop.pcm)
            self.stats["machine_silenced"] += 1
            return self._shape(hop.pcm, None)
        pre_mg = getattr(self, "_mg_release_pre", None)
        if pre_mg:
            self._mg_release_pre = None
            pre = [p for i, p in pre_mg if hop.idx - i <= 10]
            if pre:
                return self._shape(hop.pcm, np.concatenate(pre + [hop.pcm]))
        flush = getattr(self, "_mg_flush", None)
        if flush:
            self._mg_flush = None
            self.stats["machine_flushed"] += len(flush)
            return self._shape(hop.pcm, np.concatenate(flush + [hop.pcm]))
        if (self.state is not LockState.LOCKED and self._tv_near_active()
                and (TV_NEAR_OVER_BOT or not hop.bot)):
            # [TV NEAR] only the voice louder than the TV (the caller at the phone).
            # [27-Oct] also WHILE THE BOT SPEAKS (…61711): the TV's words over the bot
            # ("బిడ్డల చైర్ కి.", "అది బినానే ఆడాలి.") reached STT, their transcripts cut the
            # bot off 4 times, and the caller said "your voice is breaking". The TV level
            # is measured exactly then, so the caller interrupting (louder) still passes.
            hang = max(1, int(round(TV_NEAR_HANG_S / self._hop_s)))
            if self._tv_near_hop(hop):
                self._tv_near_idx = hop.idx
            if hop.idx - getattr(self, "_tv_near_idx", -10 ** 9) <= hang:
                held, self._pl_held = self._pl_held, []
                pre = [p for i, p in held if hop.idx - i <= len(held)]
                self.stats["tv_near_passed"] += 1
                if pre and held[-1][0] == hop.idx - 1 and self._tv_near_idx == hop.idx:
                    return self._shape(hop.pcm, np.concatenate(pre + [hop.pcm]))
                return self._shape(hop.pcm, hop.pcm)
            self._pl_held.append((hop.idx, hop.pcm))
            del self._pl_held[:-max(1, PRELOCK_PREROLL_HOPS)]
            self.stats["tv_near_cut"] += 1
            return self._shape(hop.pcm, None)
        if self.state is not LockState.LOCKED and getattr(self, "_qv_level", None):
            qv = self._qv_release(hop)
            if qv is not None:
                return qv
        if self.state is not LockState.LOCKED:
            ref = self._caller_level()
            smart = PRELOCK_NOISE and PRELOCK_SMART_GATE and ref is not None
            if not (PRELOCK_NOISE and PRELOCK_STT_GATE) and not smart:
                return self._shape(hop.pcm, hop.pcm)
            hang = max(1, int(round(PRELOCK_HANG_S / self._hop_s)))
            loud_like_caller = (smart and not PRELOCK_STT_GATE
                                and hop.rms >= PRELOCK_PASS_LOUD * ref)
            if (not hop.voice and hop.idx - self._any_speech_idx > hang
                    and not loud_like_caller):
                self._pl_held.append((hop.idx, hop.pcm))    # no voice: silence
                del self._pl_held[:-max(1, PRELOCK_PREROLL_HOPS)]
                self.stats["prelock_silenced"] += 1
                return self._shape(hop.pcm, None)
            held, self._pl_held = self._pl_held, []
            pre = [p for i, p in held if hop.idx - i <= len(held)]
            if hop.voice and pre and held[-1][0] == hop.idx - 1:
                # a voice starts: send the slices just before it too (word beginnings)
                return self._shape(hop.pcm, np.concatenate(pre + [hop.pcm]))
            return self._shape(hop.pcm, hop.pcm)
        if MODE == "verify" and not hop.bot:
            # bot is silent: the caller's words go to STT untouched; the turn is
            # verified as a whole in judge_turn()
            pre = self._take_barge_start(hop) if BACKFILL else None
            if pre:
                for _i, _p in pre:
                    self._turn_audio.append((_i, _p))   # judged with the rest of the turn
            if hop.speech:
                self._turn_audio.append((hop.idx, hop.pcm))
            self.stats["raw_turn"] += 1
            if self._mute_armed():
                try:
                    if self._mute_other_hop(hop):
                        self.stats["muted_other"] += 1
                        return self._shape(hop.pcm, None)
                except Exception as e:
                    now = time.monotonic()
                    if now - self._last_err_ts > 5.0:
                        self._last_err_ts = now
                        logger.error(f"[{self.call_id}] mute-other error (slice passed): {e}")
            elif self._mute_on:
                self._mute_end()
            if pre:
                return self._shape(hop.pcm, np.concatenate([p for _, p in pre] + [hop.pcm]))
            return self._shape(hop.pcm, hop.pcm)
        _bf_other = self.stats["other"]
        try:
            seg = self._locked_decision(hop)
        except Exception as e:
            now = time.monotonic()
            if now - self._last_err_ts > 5.0:
                self._last_err_ts = now
                logger.error(f"[{self.call_id}] voice lock decision error (hop silenced): {e}")
            seg = None
        if (seg is None and FAST_BARGE and FAST_BARGE_STT and hop.bot and self.loud_barge_recent(0.6)
                and (hop.speech or hop.voice)):
            # v5.0: the caller is interrupting (caller-level voice over the bot). The
            # voice print fails on the bot's echo, so this audio went to STT as
            # silence: the bot paused, got no words, and LiveKit resumed it — it
            # talked on for 15 s over "Hello… Hello…" (V0171542040000058134).
            # Send the caller's words to STT; the agent still judges the turn.
            seg = hop.pcm
            self.stats["fast_barge_stt"] += 1
        if seg is not None:
            self._last_cust_pass_idx = hop.idx
        if BACKFILL:
            try:
                seg = self._backfill(hop, seg, _bf_other)
            except Exception as e:
                logger.error(f"[{self.call_id}] back-fill error (ignored): {e}")
        if hop.answer:
            self._answer_hist.append((seg is not None, hop.pcm))
            self._check_relock()
        return self._shape(hop.pcm, seg)

    # ── v4.9: STT denoise / mute other ────────────────────────────────────
    def _audio_check(self, raw: np.ndarray, o: np.ndarray) -> None:
        """[AUDIO SAFE 19-Oct] Proof, per call, that the lock never changes the
        caller's sound: every slice it releases must be the slice exactly as it
        came off the line, or silence, or (at a word start) the slices just before
        it followed by this one exactly. Only the 8 ms click-free fade at a gate
        edge is allowed to differ. Anything else is counted and logged as an error."""
        try:
            hs, f = self._hop_s, min(self._fade, len(raw))
            n = len(raw)
            if len(o) == n:
                if np.array_equal(o[f:], raw[f:]):
                    self.audio_check["raw_s"] += hs
                    return
                if not np.any(o[f:]):
                    self.audio_check["silent_s"] += hs
                    return
            elif len(o) > n and np.array_equal(o[-n:], raw) or (
                    len(o) > n and np.array_equal(o[-n:][f:], raw[f:])):
                self.audio_check["raw_s"] += hs
                self.audio_check["preroll_s"] += (len(o) - n) / self.sample_rate
                return
            self.audio_check["changed"] += 1
            if not self._ac_logged:
                self._ac_logged = True
                logger.error(f"[{self.call_id}] ❗ AUDIO CHECK: the lock changed a slice of "
                             f"the caller's sound (len {len(o)} vs {n}) — please report")
        except Exception:
            pass

    def _denoise_wanted(self) -> bool:
        """[AUDIO SAFE 19-Oct] Denoise on/off with hysteresis, switched only in a pause."""
        if STT_DENOISE_MIN_NOISE_RMS <= 0:
            return True
        lim = STT_DENOISE_MIN_NOISE_RMS
        want = (self._bg >= lim * STT_DENOISE_ON_X if not self._dn_active
                else not (self._bg <= lim * STT_DENOISE_OFF_X))
        if want == self._dn_active:
            self._dn_want_since = None
            return self._dn_active
        now = self._next_idx
        if self._dn_want_since is None:
            self._dn_want_since = now
        steady = (now - self._dn_want_since) * self._hop_s >= STT_DENOISE_SWITCH_S
        pause = (now - self._any_speech_idx) * self._hop_s >= STT_DENOISE_PAUSE_S
        if steady and pause:
            self._dn_want_since = None
            return want
        return self._dn_active

    def _denoise(self, out: List[np.ndarray]) -> List[np.ndarray]:
        try:
            lens = [len(o) for o in out]
            noisy = self._denoise_wanted()
            if noisy != self._dn_active:
                self._dn_active = noisy
                logger.info(f"[{self.call_id}] 🧽 STT denoise {'ON' if noisy else 'off'} "
                            f"(line noise level {self._bg:.0f}, limit {STT_DENOISE_MIN_NOISE_RMS:.0f}, "
                            f"switched in a pause)")
            if noisy:
                self.audio_check["denoised_s"] += sum(lens) / self.sample_rate
            clean = self._denoiser.feed(np.concatenate(out).astype(np.int16), apply=noisy)
            res, k = [], 0
            for n in lens:
                res.append(clean[k:k + n])
                k += n
            return res
        except Exception as e:
            logger.error(f"[{self.call_id}] STT denoise failed ({e}) — raw audio from now on")
            self._denoiser = None
            return out

    def _mute_armed(self) -> bool:
        return (MUTE_OTHER and MODE == "verify" and self.state is LockState.LOCKED
                and self._proven and self._profile is not None)

    def _mute_window(self, center: int) -> np.ndarray:
        """Speech slices of the same utterance around `center`: up to
        WINDOW_BACK_HOPS back and MUTE_LOOKAHEAD_HOPS ahead, never across a pause."""
        def walk(step: int, limit: int) -> List[_Hop]:
            got, gap, i = [], 0, center + step
            while abs(i - center) <= limit:
                h = self._get(i)
                if h is None or h.bot:
                    break
                if h.speech:
                    got.append(h)
                    gap = 0
                else:
                    gap += 1
                    if gap > RUN_GAP_HOPS:
                        break
                i += step
            return got
        me = self._get(center)
        back_h = list(reversed(walk(-1, WINDOW_BACK_HOPS)))
        fwd = walk(+1, MUTE_LOOKAHEAD_HOPS)
        parts = [h.pcm for h in back_h] + ([me.pcm] if me is not None else []) + [h.pcm for h in fwd]
        return np.concatenate(parts) if parts else np.zeros(0, dtype=np.int16)

    def _mute_other_hop(self, hop: _Hop) -> bool:
        """True = this slice of the caller's turn is another voice: send silence."""
        if not hop.speech:
            # quiet tail of a muted voice stays muted; anything else passes
            if self._mute_on and hop.idx - self._mute_last_idx <= RUN_GAP_HOPS:
                return True
            if self._mute_on:
                self._mute_end()
            return False
        le = self._mute_eval
        if le is not None and 0 < hop.idx - le[0] < LOCKED_EVAL_EVERY_HOPS:
            mute, sim = le[1], le[2]
        else:
            win = self._mute_window(hop.idx)
            sim = None
            mute = False
            if not self._mute_line_quiet():
                self.stats["mute_noisy"] += 1    # noisy line: scores unreliable, never mute
            elif len(win) >= MUTE_MIN_S * self.sample_rate:
                sim, _ = self._similarity(win)
                if sim is not None:
                    h = MUTE_OTHER_HYST if self._mute_on else 0.0
                    mute = sim < MUTE_OTHER_SIM + h
                    if not mute and sim < MUTE_PITCH_SIM + h and len(self._cust_f0) >= 3:
                        f0 = _pitch_hz(win, self.sample_rate)
                        cf0 = float(np.median(self._cust_f0))
                        if f0 and cf0 and abs(12.0 * np.log2(f0 / cf0)) >= MUTE_PITCH_ST:
                            mute = True
            elif self._mute_on:
                mute = True                  # too short to change our mind
            self._mute_eval = (hop.idx, mute, sim)
        if mute:
            if not self._mute_on:
                self._mute_on = True
                self._mute_run_hops = 0
                self._mute_run_sim = sim
            self._mute_run_hops += 1
            if sim is not None:
                self._mute_run_sim = sim if self._mute_run_sim is None else min(self._mute_run_sim, sim)
            self._mute_last_idx = hop.idx
            return True
        if self._mute_on:
            self._mute_end()
        return False

    def _mute_line_quiet(self) -> bool:
        """The line between words is quiet compared with the customer's voice
        (no steady babble / AC / traffic under the speech)."""
        if len(self._cust_rms) < 2:
            return False
        typical = float(np.median(self._cust_rms))
        recent = [h.rms for h in list(self._ring)[-20:] if not h.bot]
        if len(recent) < 10 or typical <= 0:
            return False
        floor = float(np.percentile(recent, 20))
        return floor < MUTE_MAX_NOISE_RATIO * typical

    def _mute_end(self) -> None:
        if self._mute_on and self._mute_run_hops:
            s = self._mute_run_sim
            logger.info(f"[{self.call_id}] 🔇 {self._mute_run_hops * self._hop_s:.1f}s of ANOTHER voice "
                        f"in the caller's turn sent to STT as silence "
                        f"(sim {'%.2f' % s if s is not None else 'n/a'} < {MUTE_OTHER_SIM:.2f})")
        self._mute_on = False
        self._mute_run_hops = 0
        self._mute_run_sim = None

    def _backfill(self, hop: _Hop, seg: Optional[np.ndarray],
                  other_before: int) -> Optional[np.ndarray]:
        """[fix 25] See BACKFILL. Returns seg, possibly with the blocked start of
        this sentence in front of it."""
        buf = getattr(self, "_bf", None)
        if buf is None:
            buf = self._bf = []
            self._bf_run = None
        run = getattr(self, "_run_start_idx", None)
        if self._bf_run != run:                     # a new sentence
            buf.clear()
            self._bf_run = run
        if seg is None:
            if self.stats["other"] != other_before or getattr(self, "_run_foreign", False):
                buf.clear()                         # clearly somebody else: keep nothing
            elif hop.speech:
                buf.append((hop.idx, hop.pcm))      # unsure: keep it for now
                del buf[:-BACKFILL_MAX_HOPS]
            return None
        if (buf and seg is hop.pcm and self._run_open
                and hop.idx - buf[-1][0] <= RUN_GAP_HOPS + 1):
            n = len(buf)
            self.stats["backfill"] += n
            if not getattr(self, "_bf_logged", False) or n >= 5:
                self._bf_logged = True
                logger.info(f"[{self.call_id}] ⏪ barge-in start restored: {n * self._hop_s:.1f}s "
                            f"spoken over the bot is sent to STT with the rest of the sentence")
            seg = np.concatenate([p for _, p in buf] + [hop.pcm])
        buf.clear()
        return seg

    def _take_barge_start(self, hop: _Hop) -> Optional[List[Tuple[int, np.ndarray]]]:
        """[BARGE START 27-Oct] The caller interrupts the bot: while the bot talks each
        slice must match the voice print, and the first 0.3–1 s of an interruption
        (mixed with the bot's echo) often does not — it was held in the back-fill
        buffer, but that buffer was only sent when a LATER slice passed the voice
        print WHILE THE BOT WAS STILL TALKING. When the bot stopped first (the usual
        case: it stops for the interruption), the rest of the sentence went the
        bot-silent way and the held start was thrown away — "No no, I don't want
        it" reached STT as "I don't want it" (tests: 7 % of interruptions, 21 %
        when the caller interrupts softly).
        Now: if the caller's voice goes on right after the bot stopped (no gap), the
        held start is sent in front of it, and judged with the rest of the turn.
        Held slices are never kept for clearly-other voices (cleared in
        _backfill), and nothing is sent if there is a gap, so a bystander or the
        bot's own echo that ended before the caller spoke is not sent."""
        buf = getattr(self, "_bf", None)
        if not buf:
            return None
        if getattr(self, "_run_foreign", False):
            buf.clear()
            return None
        if not hop.speech:
            # (energy test only: Silero keeps saying "voice" for a few slices after
            # any speech ends, which made the bot's echo look like it went on)
            if hop.idx - buf[-1][0] > RUN_GAP_HOPS + 1:
                buf.clear()                  # gap: the held audio ended on its own
            return None
        if hop.idx - buf[-1][0] > BARGE_START_GAP_HOPS + 1:
            buf.clear()
            return None
        pre = list(buf[-BARGE_START_MAX_HOPS:])
        ref = self._caller_level()
        if ref and max(_rms(p) for _, p in pre) < BARGE_START_MIN_LEVEL * ref:
            buf.clear()                      # too quiet for the caller: the bot's echo
            return None
        if len(pre) >= BARGE_START_CHECK_HOPS:
            # one voice-print check on the whole held start (0.3–1 s, ~30 ms): another
            # person who talked over the bot and goes on after it is not sent early
            try:
                sim, _ = self._similarity(np.concatenate([p for _, p in pre]))
            except Exception:
                sim = None
            if sim is not None and sim < BARGE_START_MIN_SIM:
                buf.clear()
                self.stats["barge_start_skipped"] += 1
                return None
        buf.clear()
        self.stats["barge_start"] += len(pre)
        logger.info(f"[{self.call_id}] ⏪ interruption start restored: {len(pre) * self._hop_s:.1f}s "
                    f"spoken over the bot is sent to STT with the rest of the sentence")
        return pre

    def _check_relock(self) -> None:
        n = len(self._answer_hist)
        if n * self._hop_s < RELOCK_SPEECH_S:
            return
        passed = sum(1 for ok, _ in self._answer_hist if ok)
        if passed / n > RELOCK_PASS_MAX:
            return
        rejected = [pcm for ok, pcm in self._answer_hist if not ok]
        self._answer_hist.clear()

        # The customer is answering the bot and we're blocking them. First
        # question: is this still THEIR voice, just sounding different right now?
        sim, emb = self._similarity(np.concatenate(rejected[-40:]))
        if sim is not None and sim >= WIDEN_MIN_SIM:
            self._bank_add(emb)
            self.stats["widened"] += 1
            self._run_open = True       # let the rest of this sentence through
            logger.warning(f"[{self.call_id}] 🔧 Answer was being blocked but matches the "
                           f"customer (sim={sim:.2f}) — voice profile widened "
                           f"(bank={len(self._bank)}), rest of the answer passes")
            return

        if sim is not None and sim < FOREIGN_SIM:
            self._foreign_answers += 1
            if self._foreign_answers < FOREIGN_ANSWERS_TO_RELOCK:
                self.stats["foreign_blocked"] += 1
                logger.warning(f"[{self.call_id}] 🚫 A different voice answered (sim={sim:.2f}) "
                               f"— kept blocked ({self._foreign_answers}/"
                               f"{FOREIGN_ANSWERS_TO_RELOCK} before assuming the phone changed hands)")
                return
        self._foreign_answers = 0

        self._relocks += 1
        if self._relocks > RELOCK_MAX:
            self.state = LockState.FAILED_OPEN
            logger.error(f"[{self.call_id}] ❌ Caller answers still rejected after "
                         f"{RELOCK_MAX} re-locks — audio passes unfiltered so the call isn't deaf")
            return
        logger.error(f"[{self.call_id}] 🔁 WRONG LOCK: the voice answering the bot does not "
                     f"match (sim={sim if sim is not None else float('nan'):.2f}, "
                     f"{passed}/{n} hops passed) — re-identifying the customer "
                     f"(relock {self._relocks}/{RELOCK_MAX})")
        self.state = LockState.ENROLLING
        self._profile = None
        self._bank = []
        self._tse_cache = None
        self._rivals = []
        self._attempts = 0
        self._best = None
        self._utts = [rejected]
        self._utt_aids = [self._answer_id]
        self._enroll_speech_s = len(rejected) * self._hop_s
        self._last_enroll_idx = self._next_idx
        self._prev_open = True
        self._maybe_build()

    def _learn_from_answer(self, hist: List[Tuple[bool, np.ndarray]]) -> None:
        """A finished answer that clearly got through is the customer's voice on
        this line right now — add it to the profile bank."""
        if self.state is not LockState.LOCKED or not hist:
            return
        ok = [pcm for good, pcm in hist if good]
        if len(ok) / len(hist) >= 0.5:
            self._foreign_answers = 0        # the customer answered normally
        if (len(ok) / len(hist) < BANK_ADD_PASS_RATIO
                or len(ok) * self._hop_s < BANK_ADD_MIN_S):
            return
        sim, emb = self._similarity(np.concatenate(ok[-40:]))
        if emb is not None and sim is not None and sim >= max(self._thr, BANK_ADD_TURN_SIM):
            self._bank_add(emb)
            logger.info(f"[{self.call_id}] ➕ answer added to voice profile "
                        f"(sim={sim:.2f}, bank={len(self._bank)})")

    def _bank_agreement(self) -> np.ndarray:
        B = np.vstack(self._bank)
        S = B @ B.T
        n = len(self._bank)
        return (S.sum(axis=1) - np.diag(S)) / max(1, n - 1)

    def _bank_add(self, emb: np.ndarray) -> None:
        self._bank.append(emb.astype(np.float32))
        if len(self._bank) >= BANK_CLEAN_MIN:
            agree = self._bank_agreement()
            worst = int(np.argmin(agree))
            others = np.delete(agree, worst)
            if agree[worst] < BANK_OUTLIER_SIM or agree[worst] < float(np.median(others)) - BANK_OUTLIER_MARGIN:
                self._bank.pop(worst)
                self.stats["bank_cleaned"] += 1
                logger.warning(f"[{self.call_id}] 🧽 dropped a profile entry that doesn't match the "
                               f"customer's other answers (agreement {agree[worst]:.2f} vs "
                               f"{float(np.median(others)):.2f}{', the enrollment print' if worst == 0 else ''})")
        if len(self._bank) > BANK_MAX:
            self._bank.pop(int(np.argmin(self._bank_agreement())))   # least typical goes
        self._profile = _norm(np.mean(np.vstack(self._bank), axis=0))

    # ── [v10 QUIET VOICE] see QUIET_VOICE ─────────────────────────────────────
    def _qv_arm(self) -> None:
        if getattr(self, "_qv_level", None) or getattr(self, "_qv_off", False):
            return
        ar = getattr(self, "_aid_rms", None) or {}
        lv = ar.get(self._answer_id) or ar.get(self._answer_id - 1) or []
        if len(lv) < QUIET_VOICE_MIN_HOPS:
            logger.info(f"[{self.call_id}] 🔉 quiet-voice mute not armed: the anchor answer is too "
                        f"short ({len(lv)} slices)")
            return
        self._qv_level = float(np.percentile(lv, 80))
        self._qv_held = []
        self._qv_run_peak = 0.0
        self._qv_last_voice = -10 ** 9
        logger.info(f"[{self.call_id}] 🔉 {'' if QUIET_VOICE == 'on' else '[shadow] '}caller level from "
                    f"the language answer: {self._qv_level:.0f} — before the lock, voices below "
                    f"{QUIET_VOICE_RATIO:.0%} of it ({QUIET_VOICE_RATIO * self._qv_level:.0f}) "
                    f"{'are kept from STT' if QUIET_VOICE == 'on' else 'would be kept from STT'}")

    def _qv_disarm(self, why: str) -> None:
        self._qv_level = None
        self._qv_off = True
        self._qv_vad_mute = False
        logger.warning(f"[{self.call_id}] 🔉 quiet-voice mute OFF for this call: {why}")

    def _qv_release(self, hop: _Hop) -> Optional[np.ndarray]:
        """STT output for this slice, or None = let the normal pre-lock rules decide."""
        lvl = self._qv_level
        thr = QUIET_VOICE_RATIO * lvl
        voiced = bool(hop.voice or hop.speech)
        gap = 2                                   # a stretch ends after 0.2 s without voice
        if not voiced:
            if hop.idx - self._qv_last_voice > gap and (self._qv_held or self._qv_run_peak):
                self._qv_end_run()
            if QUIET_VOICE == "on" and self._qv_held:
                return self._shape(hop.pcm, None)  # still inside a held stretch
            self._qv_vad_mute = False
            return None
        if hop.idx - self._qv_last_voice > gap:
            self._qv_end_run()
        self._qv_last_voice = hop.idx
        if not self._qv_run_peak:
            self._qv_run_start_bot = bool(hop.bot)
            self._qv_run_since = (hop.idx - self._bot_end_idx) * self._hop_s
        self._qv_run_peak = max(self._qv_run_peak, float(hop.rms))
        if hop.rms >= thr:
            self._qv_run_nloud = getattr(self, "_qv_run_nloud", 0) + 1
        if (getattr(self, "_qv_run_loud", False) or getattr(self, "_qv_run_nloud", 0) >= QUIET_VOICE_LOUD_HOPS
                or hop.rms >= QUIET_VOICE_PEAK * lvl):
            # as loud as the caller: this stretch goes to STT whole (held part first)
            self._qv_run_loud = True
            self._qv_vad_mute = False
            held, self._qv_held = self._qv_held, []
            if held and QUIET_VOICE == "on":
                self.stats["qv_backfilled"] += len(held)
                return self._shape(hop.pcm, np.concatenate([p for _, p in held] + [hop.pcm]))
            return None
        # quiet so far
        self.stats["qv_quiet"] += 1
        if QUIET_VOICE != "on":
            return None
        self._qv_held.append((hop.idx, hop.pcm))
        max_hold = max(1, int(QUIET_VOICE_HOLD_S / self._hop_s))
        if len(self._qv_held) > max_hold:
            self._qv_held.pop(0)                  # held too long: the oldest slice is dropped
        self._qv_vad_mute = True
        return self._shape(hop.pcm, None)

    def _qv_end_run(self) -> None:
        """A stretch of voice ended: count it, and check whether the quiet voice is
        the one answering the bot (then the caller is the soft one)."""
        peak = self._qv_run_peak
        if peak:
            quiet = not getattr(self, "_qv_run_loud", False)
            if quiet:
                self.stats["qv_muted_runs"] += 1
                n = len(self._qv_held)
                now = time.monotonic()
                if now - getattr(self, "_qv_logged", 0.0) > 10.0:
                    self._qv_logged = now
                    logger.info(f"[{self.call_id}] 🔉 {'' if QUIET_VOICE == 'on' else '[shadow] '}a quiet "
                                f"voice ({peak / self._qv_level:.0%} of the caller) "
                                f"{'kept from STT' if QUIET_VOICE == 'on' else 'would be kept from STT'} "
                                f"before the lock ({n * self._hop_s:.1f}s)")
            # answers the bot: first voice right after a bot line, nothing loud in that gap
            aid = self._answer_id
            if (not self._qv_run_start_bot and self._qv_run_since is not None
                    and self._qv_run_since <= 2.0 and getattr(self, "_qv_ans_aid", None) != aid):
                self._qv_ans_aid = aid
                self._qv_quiet_answers = (getattr(self, "_qv_quiet_answers", 0) + 1) if quiet else 0
                if self._qv_quiet_answers >= QUIET_VOICE_DISARM:
                    self._qv_held = []
                    self._qv_disarm(f"the quiet voice answered the bot {self._qv_quiet_answers} times "
                                    f"in a row — the caller may be the soft voice")
        self._qv_held = [] if getattr(self, "_qv_level", None) else []
        self._qv_run_peak = 0.0
        self._qv_run_nloud = 0
        self._qv_run_loud = False
        self._qv_vad_mute = False

    def _shape(self, raw: np.ndarray, seg: Optional[np.ndarray]) -> np.ndarray:
        """Apply the gate with short fades so edges never click."""
        f = min(self._fade, len(raw))
        if seg is None:
            out = np.zeros(len(raw), dtype=np.int16)
            if self._prev_open:   # fade the tail out instead of a hard cut
                ramp = np.linspace(1.0, 0.0, f, dtype=np.float32)
                out[:f] = (raw[:f].astype(np.float32) * ramp).astype(np.int16)
            self._prev_open = False
            return out
        out = np.asarray(seg, dtype=np.int16).copy()
        if not self._prev_open:
            ramp = np.linspace(0.0, 1.0, f, dtype=np.float32)
            out[:f] = (out[:f].astype(np.float32) * ramp).astype(np.int16)
        self._prev_open = True
        return out

    # ── LOCKED ────────────────────────────────────────────────────────────
    def _is_candidate(self, hop: _Hop) -> bool:
        if hop.speech:
            return True
        # quiet consonant just before / after a speech hop: judge it too, so word
        # onsets and tails aren't chopped off.
        if hop.rms < max(ABS_SPEECH_RMS * 0.5, 1.1 * self._bg):
            return False
        for n in (hop.idx - 1, hop.idx + 1):
            nb = self._get(n)
            if nb is not None and nb.speech:
                return True
        return False

    def _similarity(self, pcm: np.ndarray) -> Tuple[Optional[float], Optional[np.ndarray]]:
        if pcm is None or len(pcm) == 0:
            return None, None
        emb = self._embed(pcm, self.sample_rate)
        if emb is None or self._profile is None:
            return None, None
        sim = float(np.dot(emb, self._profile))
        # While the profile is young, the best single entry may be used (helps the
        # caller when they sound different). Once it has learned from several
        # answers, ONLY the averaged profile counts: "best single entry" let anyone
        # resembling a part-contaminated enrollment print through
        # (V9251606030000040818) — in tests the gap between caller and bystander
        # widened from 0.16 to 0.56 with no loss for the caller.
        if self._bank and len(self._bank) < MATURE_BANK:
            sim = max(sim, max(float(np.dot(emb, b)) for b in self._bank))
        return sim, emb

    def _locked_decision(self, hop: _Hop) -> Optional[np.ndarray]:
        if not self._is_candidate(hop):
            self.stats["silence"] += 1
            return None

        if hop.idx - self._last_cand_idx > RUN_GAP_HOPS:     # a new sentence
            self._run_open = False
            self._run_start_idx = hop.idx
            self._switch_streak = 0
            self._run_foreign = False
            self._last_eval = None
        self._last_cand_idx = hop.idx

        # same sentence, decided very recently → reuse that decision (the voice
        # print is the expensive part, and 100 ms barely changes it)
        le = self._last_eval
        if le is not None and 0 < hop.idx - le[0] < LOCKED_EVAL_EVERY_HOPS:
            self.stats["reused"] += 1
            return hop.pcm if le[1] else None
        seg = self._locked_decision_eval(hop)
        self._last_eval = ((hop.idx, seg is hop.pcm)
                           if (seg is None or seg is hop.pcm) else None)
        return seg

    def _locked_decision_eval(self, hop: _Hop) -> Optional[np.ndarray]:

        # judged on the sentence so far (steady), not on this 100 ms alone
        sim, _ = self._similarity(self._voice_span(hop.idx, LONG_BACK_HOPS))
        if sim is None:
            self.stats["silence"] += 1
            return None
        self._last_sim = sim
        self._sims.append(sim)

        # someone else cutting in mid-sentence: the short window notices it
        if self._run_open:
            short, _ = self._similarity(self._voice_span(hop.idx, WINDOW_BACK_HOPS))
            if short is not None and short < HARD_REJECT_COSINE:
                self._switch_streak += 1
            else:
                self._switch_streak = 0
            if self._switch_streak >= SWITCH_HOPS:
                self._run_open = False
                self._run_start_idx = hop.idx        # new voice → new sentence
                self._switch_streak = 0
                self._run_foreign = True
                self.stats["switch"] += 1
                self.stats["other"] += 1
                return None

        if sim >= self._thr_clean:                    # clearly the customer
            self.stats["pass"] += 1
            self._run_open = True
            return hop.pcm

        if sim >= self._thr:                          # the customer, maybe with something under it
            # passed RAW — the separation model changes words on a phone line
            self.stats["soft_pass"] += 1
            self._run_open = True
            return hop.pcm

        if self._run_open and sim >= KEEP_OPEN_SIM:   # same sentence, weaker patch
            self.stats["hold_open"] += 1
            return hop.pcm

        self._run_open = False
        if sim < HARD_REJECT_COSINE:                  # clearly somebody else
            self.stats["other"] += 1
            return None

        if ANSWER_LENIENT and hop.answer and not self._run_foreign:
            # the customer answering the bot, on a weak-scoring stretch: keep the words
            self.stats["answer_pass"] += 1
            return hop.pcm

        seg = self._tse(hop)                          # overlap / unsure → extract customer
        if seg is not None:
            return seg
        self.stats["uncertain"] += 1
        return hop.pcm if UNCERTAIN_POLICY == "pass" else None

    def _tse(self, hop: _Hop) -> Optional[np.ndarray]:
        if self._extractor is None or not self._extractor_ok or self._tse_ref is None:
            return None
        c = self._tse_cache
        if c is None or not (c[0] <= hop.idx <= c[1]):
            newest = self._next_idx - 1
            start = max(self._ring[0].idx, newest - TSE_WINDOW_HOPS + 1)
            mix = self._span(start, newest)
            y = None
            try:
                t0 = time.monotonic()
                y = self._extractor.extract(mix, self._tse_ref)
                self.stats["tse_ms"] = int((time.monotonic() - t0) * 1000)
            except Exception as e:
                logger.warning(f"[{self.call_id}] TSE error: {e}")
            # target_extractor returns the INPUT object when it gives up —
            # that is the mixture, i.e. exactly what must not pass.
            if y is None or y is mix or len(y) < len(mix):
                y = None
            else:
                y = np.asarray(y[:len(mix)], dtype=np.float32)
                target = TSE_OUTPUT_LEVEL * _rms(mix)
                cur = _rms(y)
                if cur > 1e-6:
                    y = y * (target / cur)
                y = np.clip(y, -32768, 32767).astype(np.int16)
            self._tse_cache = (start, newest, y)
            c = self._tse_cache

        start, end, y = c
        if y is None:
            self.stats["tse_fail"] += 1
            return None
        off = (hop.idx - start) * self.hop_len
        seg = y[off:off + self.hop_len]
        if len(seg) != self.hop_len:
            self.stats["tse_fail"] += 1
            return None

        lo = max(start, hop.idx - WINDOW_BACK_HOPS)
        hi = min(end, hop.idx + LOOKAHEAD_HOPS)
        check = y[(lo - start) * self.hop_len:(hi - start + 1) * self.hop_len]
        sim, _ = self._similarity(check)
        if sim is None or sim < self._thr - TSE_ACCEPT_DROP:
            self.stats["tse_fail"] += 1
            return None
        self.stats["tse_ok"] += 1
        return seg

    def _adapt(self, emb: Optional[np.ndarray], sim: float) -> None:
        if not PROFILE_ADAPT or emb is None or sim < self._thr_clean + 0.05:
            return
        cand = _norm((1.0 - PROFILE_ADAPT_ALPHA) * self._profile + PROFILE_ADAPT_ALPHA * emb)
        if float(np.dot(cand, self._anchor)) >= PROFILE_ANCHOR_MIN:
            self._profile = cand

    # ── ENROLLING ─────────────────────────────────────────────────────────
    def _enroll_observe(self, hop: _Hop) -> None:
        # First enrollment: only the voice that ANSWERS the bot. After a re-lock
        # that rule can deadlock — V9251438240000040543 re-locked, then the people
        # around the caller kept interrupting the bot so it never finished a line,
        # no speech ever counted as an "answer", and the lock stayed open for the
        # rest of the call. So a RE-enrollment takes any speech heard while the bot
        # is quiet (SepFormer still picks the near-mic voice if several are mixed).
        if not self._enroll_open:
            return
        if getattr(self, "_mg_on", False):
            return                      # [MACHINE] never learn a recorded voice
        if not hop.answer:
            if not (self._relocks > 0 and hop.speech and not self._bot_speaking):
                return
        if TV_NEAR_ENROLL and self._tv_near_active() and not self._tv_near_hop(hop):
            return                      # [TV NEAR] the TV, not the caller at the phone
        if (self._utts and hop.idx - self._last_enroll_idx <= ENROLL_UTT_GAP_HOPS
                and (not self._utt_aids or self._utt_aids[-1] == self._answer_id)):
            self._utts[-1].append(hop.pcm)
        else:
            self._utts.append([hop.pcm])
            self._utt_aids.append(self._answer_id)
        self._last_enroll_idx = hop.idx
        self._enroll_speech_s += self._hop_s
        while self._enroll_speech_s > ENROLL_BUFFER_MAX_S and len(self._utts) > 1:
            dropped = self._utts.pop(0)
            if self._utt_aids:
                self._utt_aids.pop(0)
            self._enroll_speech_s -= len(dropped) * self._hop_s
        self._maybe_build()

    # ── [DIARIZE 29-Oct] who is the caller among several voices ────────────────
    def _diar_flush(self) -> None:
        cur = getattr(self, "_dz_cur", None)
        self._dz_cur = []
        if not cur or len(cur) < DIARIZE_MIN_HOPS:
            return
        pool = getattr(self, "_dz_pool", None)
        if pool is None:
            pool = self._dz_pool = collections.deque(maxlen=max(10, DIARIZE_POOL_MAX))
        h0 = cur[0]
        since = None if h0.bot else (h0.idx - self._bot_end_idx) * self._hop_s
        # [v10 SEED] the first answer after the greeting, if it started soon enough
        if (not h0.bot and getattr(self, "_seed_aid", None) is None
                and not getattr(self, "_seed_closed", False)):
            self._seed_closed = True             # only the FIRST answer can be the seed
            # TV / crowd flags do not block it: the seed never locks on its own, and a
            # TV voice does not lead the scores (it talks over the bot, sounds far)
            if since is not None and since <= DIARIZE_SEED_WINDOW_S:
                self._seed_aid = self._answer_id
                self._seed_idx = h0.idx
        pool.append({
            "idx": h0.idx, "pcm": np.concatenate([h.pcm for h in cur]), "bot": bool(h0.bot),
            "aid": None if h0.bot else self._answer_id, "since": since,
            "rms": float(np.median([h.rms for h in cur])), "emb": None,
        })

    def _diar_observe(self, hop: _Hop) -> None:
        """Collect ~1 s pieces of voice (no voice print here — that is done in the
        enrollment thread, never on the audio path)."""
        if not self._enroll_open or getattr(self, "_mg_on", False):
            return
        cur = getattr(self, "_dz_cur", None)
        if cur is None:
            cur = self._dz_cur = []
        if not hop.voice:
            self._diar_flush()
            return
        if cur and (bool(hop.bot) != bool(cur[0].bot) or hop.idx != cur[-1].idx + 1):
            self._diar_flush()
            cur = self._dz_cur
        cur.append(hop)
        if len(cur) >= DIARIZE_CHUNK_HOPS:
            self._diar_flush()

    def _diarize(self) -> Optional[Dict]:
        """Group the pieces into voices and score each (see DIARIZE). Runs in the
        enrollment thread. None = too little heard to say anything."""
        pool = list(getattr(self, "_dz_pool", None) or [])
        if len(pool) < DIARIZE_MIN_CHUNKS:
            return None
        for c in pool:
            if c["emb"] is None:
                c["emb"] = self._embed(c["pcm"], self.sample_rate)
        items = [c for c in pool if c["emb"] is not None]
        if len(items) < DIARIZE_MIN_CHUNKS:
            return None
        # 1. group the pieces into voices. Two 1 s prints of the SAME person on a phone
        #    line agree only ~0.37 (0.20-0.50), so piece-by-piece joining split every
        #    caller into many tiny groups. Average-linkage grouping compares whole groups
        #    (their average agreement), then each piece is moved to its closest voice.
        E = np.vstack([c["emb"] for c in items])
        labels = None
        try:
            from scipy.cluster.hierarchy import linkage, fcluster
            if len(items) >= 2:
                Z = linkage(E, method="average", metric="cosine")
                labels = fcluster(Z, t=1.0 - DIARIZE_CLUSTER_SIM, criterion="distance")
            else:
                labels = np.ones(1, dtype=int)
        except Exception:
            labels = None
        if labels is None:                     # no scipy: simple joining (less exact)
            labels, cens = [], []
            for e in E:
                sims = [float(np.dot(e, c)) for c in cens]
                if sims and max(sims) >= DIARIZE_CLUSTER_SIM:
                    labels.append(int(np.argmax(sims)) + 1)
                else:
                    cens.append(e.copy()); labels.append(len(cens))
            labels = np.asarray(labels)
        groups: List[Dict] = []
        for lab in sorted(set(int(x) for x in labels)):
            its = [c for c, l in zip(items, labels) if int(l) == lab]
            groups.append({"items": its, "cen": _norm(np.mean([c["emb"] for c in its], axis=0))})
        for _ in range(2):                      # move each piece to its closest voice
            big = [g for g in groups if len(g["items"]) >= DIARIZE_MIN_CHUNKS] or groups
            for g in big:
                g["new"] = []
            for c in items:
                best = max(big, key=lambda g: float(np.dot(c["emb"], g["cen"])))
                best["new"].append(c)
            groups = [{"items": g["new"], "cen": _norm(np.mean([c["emb"] for c in g["new"]], axis=0))}
                      for g in big if g["new"]]
        # 2. merge groups that are really one voice
        merged = True
        while merged and len(groups) > 1:
            merged = False
            for i in range(len(groups)):
                for j in range(i + 1, len(groups)):
                    if float(np.dot(groups[i]["cen"], groups[j]["cen"])) >= DIARIZE_MERGE_SIM:
                        groups[i]["items"] += groups[j]["items"]
                        groups[i]["cen"] = _norm(np.mean([x["emb"] for x in groups[i]["items"]], axis=0))
                        groups.pop(j)
                        merged = True
                        break
                if merged:
                    break
        voices = [g for g in groups if len(g["items"]) >= DIARIZE_MIN_CHUNKS]
        if not voices:
            return None
        # 3. score what only the caller does
        all_aids = {c["aid"] for c in items if c["aid"] is not None}
        top_lvl = max(float(np.median([c["rms"] for c in g["items"]])) for g in voices) or 1.0
        # [v10 NEAR-FIELD] per piece, against the line's own noise floor
        nf_on = NEARFIELD != "off"
        if nf_on:
            floor_db = self._line_floor_db()
            for c in items:
                if "nf" not in c:
                    r = _nearfield(c["pcm"], self.sample_rate, floor_db)
                    c["nf"] = None if r is None else r["nf"]
            if DIARIZE_SEPARATE != "off":
                self._diar_separate(items, voices, floor_db)
        if NEARFIELD == "on":
            w = [DIARIZE_W_COV, DIARIZE_W_QUIET, DIARIZE_W_EARLY, DIARIZE_W_NEAR, DIARIZE_W_LEVEL]
        else:
            w = [0.45, 0.25, 0.15, 0.0, 0.15]
        tot = sum(max(0.0, x) for x in w) or 1.0
        w = [max(0.0, x) / tot for x in w]
        for g in voices:
            its = g["items"]
            gap = [c for c in its if not c["bot"]]
            aids = {c["aid"] for c in gap if c["aid"] is not None}
            g["cov"] = len(aids) / max(1, len(all_aids))
            g["nans"] = len(aids)
            g["quiet"] = 1.0 - sum(1 for c in its if c["bot"]) / len(its)
            g["early"] = (sum(1 for c in gap if c["since"] is not None and c["since"] <= 2.5)
                          / max(1, len(gap)))
            g["level"] = float(np.median([c["rms"] for c in its])) / top_lvl
            if nf_on:
                # answer-gap pieces only: over the bot a bystander talks ALONE (clean gaps),
                # while in the answer gaps everyone overlaps — compare like with like
                nfs = [c["nf"] for c in gap if c.get("nf") is not None]
                if len(nfs) < 2:
                    nfs = [c["nf"] for c in its if c.get("nf") is not None]
                nfs += list(g.get("nf_sep", []))
                g["near"] = float(np.median(nfs)) if nfs else None
            near = g.get("near")
            g["score"] = (w[0] * g["cov"] + w[1] * g["quiet"] + w[2] * g["early"]
                          + w[3] * (near if near is not None else 0.5) + w[4] * g["level"])
            # [ANCHOR] share of the anchor answers' loud speech that is this voice
            anc = getattr(self, "_anchor_aids", None) or set()
            if anc:
                mine = sum(c["rms"] for c in its if not c["bot"] and c["aid"] in anc)
                allc = sum(c["rms"] for c in items if not c["bot"] and c["aid"] in anc) or 1.0
                g["anchor"] = mine / allc
                if DIARIZE_ANCHOR == "on":
                    g["score"] += DIARIZE_ANCHOR_BONUS * g["anchor"]
            side = getattr(self, "_side_aids", None) or set()
            if side:
                mine = sum(c["rms"] for c in its if not c["bot"] and c["aid"] in side)
                allc = sum(c["rms"] for c in items if not c["bot"] and c["aid"] in side) or 1.0
                g["side"] = mine / allc
                if DIARIZE_ANCHOR == "on":
                    g["score"] -= DIARIZE_ANCHOR_BONUS * g["side"]
            g["secs"] = len(its) * DIARIZE_CHUNK_HOPS * self._hop_s
        voices.sort(key=lambda g: -g["score"])
        crowd = len(voices) >= 2
        if crowd and self._real_crowd(voices):
            self._crowd_reason = f"{len(voices)} voices answer the bot"
        margin = voices[0]["score"] - voices[1]["score"] if crowd else 1.0
        choice = voices[0] if (margin >= DIARIZE_MARGIN and voices[0]["cov"] > 0
                               and voices[0]["secs"] >= DIARIZE_MIN_SECS) else None
        # [ANCHOR] the voice that gave the caller's clear answers
        if choice is None and crowd and DIARIZE_ANCHOR == "on":
            best_a = max(voices, key=lambda g: g.get("anchor", 0.0))
            if (best_a.get("anchor", 0.0) >= DIARIZE_ANCHOR_SHARE
                    and best_a["secs"] >= DIARIZE_STREAK_SECS):
                choice = best_a
                best_a["anchored"] = True
        # the same voice keeps leading → it is the caller (see DIARIZE_STREAK)
        lead = voices[0]
        prev = getattr(self, "_dz_lead", None)
        same = prev is not None and float(np.dot(prev, lead["cen"])) >= DIARIZE_MERGE_SIM
        if crowd and margin >= DIARIZE_STREAK_MARGIN and lead["cov"] >= 0.75:
            self._dz_streak = (getattr(self, "_dz_streak", 0) + 1) if same else 1
        else:
            self._dz_streak = 0
        self._dz_lead = lead["cen"].copy()
        if (choice is None and crowd and self._dz_streak >= DIARIZE_STREAK
                and lead["secs"] >= DIARIZE_STREAK_SECS):
            choice = lead
            lead["streak"] = self._dz_streak
        # 4. contrast with what was heard over the bot (the caller was listening then):
        #    answer-gap pieces unlike every over-bot piece are the caller's
        bgp = [c for c in items if c["bot"]]
        cand_info = ""
        if crowd and choice is None and len(bgp) >= DIARIZE_MIN_BG:
            # only a TIE-BREAKER: used when the scores above cannot pick the caller
            B = np.vstack([c["emb"] for c in bgp])
            gap = [c for c in items if not c["bot"] and c["aid"] is not None]
            for c in gap:
                sims = np.sort(B @ c["emb"])[::-1]
                c["bg"] = float(np.mean(sims[:3]))
            cand = [c for c in gap if c["bg"] < DIARIZE_BG_SIM]
            if len(cand) >= DIARIZE_MIN_CHUNKS:
                C = np.vstack([c["emb"] for c in cand])
                try:
                    from scipy.cluster.hierarchy import linkage, fcluster
                    lab = fcluster(linkage(C, method="average", metric="cosine"),
                                   t=1.0 - DIARIZE_CLUSTER_SIM, criterion="distance")
                except Exception:
                    lab = np.ones(len(cand), dtype=int)
                best = None
                for l in set(int(x) for x in lab):
                    its = [c for c, x in zip(cand, lab) if int(x) == l]
                    cov = len({c["aid"] for c in its}) / max(1, len(all_aids))
                    if len(its) >= DIARIZE_MIN_CHUNKS and (best is None or (cov, len(its)) > (best[1], len(best[0]))):
                        best = (its, cov)
                if (best is not None and best[1] >= 0.5
                        and len(best[0]) * DIARIZE_CHUNK_HOPS * self._hop_s >= DIARIZE_MIN_SECS
                        and best[1] >= voices[0]["cov"] - 0.2):
                    its = best[0]
                    grp = {"items": its, "cen": _norm(np.mean([c["emb"] for c in its], axis=0)),
                           "cov": best[1], "quiet": 1.0, "early":
                           sum(1 for c in its if c["since"] is not None and c["since"] <= 2.5) / len(its),
                           "level": float(np.median([c["rms"] for c in its])) / top_lvl,
                           "secs": len(its) * DIARIZE_CHUNK_HOPS * self._hop_s, "contrast": True}
                    if nf_on:
                        nfs = [c["nf"] for c in its if c.get("nf") is not None]
                        grp["near"] = float(np.median(nfs)) if nfs else None
                    grp["score"] = (w[0] * grp["cov"] + w[1] + w[2] * grp["early"]
                                    + w[3] * (grp["near"] if grp.get("near") is not None else 0.5)
                                    + w[4] * grp["level"])
                    choice = grp
                    voices = [grp] + voices
                    margin = max(margin, DIARIZE_MARGIN)
                cand_info = f"{len(cand)}/{len(gap)} answer pieces unlike the over-bot voices"
        # 5. [v10 SEED] the first "hello" is a soft seed: its voice is taken with a
        #    smaller margin once the scores agree it is the leader
        notes = []
        seed = self._seed_emb(items) if DIARIZE_SEED != "off" else None
        if seed is not None:
            sims = [float(np.dot(seed, g["cen"])) for g in voices]
            k = int(np.argmax(sims))
            if sims[k] >= DIARIZE_SEED_SIM:
                sv = voices[k]
                sv["seed"] = True
                ok = (crowd and choice is None and sv is voices[0] and margin >= DIARIZE_SEED_MARGIN
                      and sv.get("nans", 0) >= DIARIZE_SEED_ANSWERS and sv["secs"] >= DIARIZE_SEED_SECS)
                if ok and DIARIZE_SEED == "on":
                    choice = sv
                    sv["seeded"] = True
                elif ok:
                    notes.append(f"[shadow] seed would pick {'ABCDEFGH'[k]}")
                if choice is not None and choice is not sv and crowd:
                    notes.append(f"seed voice {'ABCDEFGH'[k]} beaten on the scores")
        # 6. [v10 NEAR-FIELD veto] in doubt, wait: another voice sounds clearly closer
        if choice is not None and crowd and NEARFIELD == "on" and choice.get("near") is not None:
            closer = [g for g in voices if g is not choice and g.get("near") is not None
                      and g["near"] - choice["near"] >= NF_VETO and g["secs"] >= DIARIZE_MIN_SECS / 2
                      and g["cov"] >= 0.5 and g["quiet"] >= 0.6]   # it behaves like a caller too
            if closer:
                notes.append(f"NOT locking: another voice sounds closer to the phone "
                             f"(near {closer[0]['near']:.2f} vs {choice['near']:.2f})")
                choice = None
        if notes:
            cand_info = " | ".join([x for x in [cand_info] + notes if x])
        return {"voices": voices, "crowd": crowd, "margin": margin, "choice": choice, "info": cand_info}

    def _near_clean(self, v: Dict):
        """[v10 NEAR-FIELD CLEAN] (pieces at the phone, pieces across the room) of one
        voice's answer pieces when BOTH distances are heard, else None."""
        pcs = [c for c in v["items"] if not c["bot"] and c.get("nf") is not None]
        hi = [c for c in pcs if c["nf"] >= NF_HI]
        lo = [c for c in pcs if c["nf"] < NF_LO]
        # a caller alone on speakerphone has a stray piece or two that scores "near":
        # the phone-side talker must be a real share of the pieces (NF_HI_SHARE)
        if len(lo) >= NF_FAR_MIN and hi and len(hi) >= NF_HI_SHARE * len(pcs):
            return hi, lo
        return None

    def _line_floor_db(self) -> float:
        """[v10] the line's noise floor (dB of int16 rms): the quiet 10 % of the last minute."""
        with self._mutex:
            lv = [r for r, _ in self._line_hist]
        if len(lv) < 20:
            return 10.0 * np.log10(16.0 + 1.0)
        return float(10.0 * np.log10(float(np.percentile(lv, 10)) ** 2 + 1.0))

    def _seed_emb(self, items: List[Dict]) -> Optional[np.ndarray]:
        """[v10 SEED] voice print of the first ~1 s of the first answer (plus its next
        piece when that one agrees: same voice)."""
        aid = getattr(self, "_seed_aid", None)
        if aid is None:
            return None
        ps = sorted((c for c in items if not c["bot"] and c["aid"] == aid and c["emb"] is not None),
                    key=lambda c: c["idx"])
        if not ps or ps[0]["idx"] != getattr(self, "_seed_idx", ps[0]["idx"]):
            return None                          # the first piece left the pool
        es = [ps[0]["emb"]]
        if len(ps) >= 2 and float(np.dot(ps[0]["emb"], ps[1]["emb"])) >= DIARIZE_SEED_SELF_SIM:
            es.append(ps[1]["emb"])
        return _norm(np.mean(es, axis=0))

    def _diar_separate(self, items: List[Dict], voices: List[Dict], floor_db: float) -> None:
        """[v10 SEPARATE] split pieces that sound like two voices at once (see there)."""
        sep = self._separator
        if sep is None or len(voices) < 2:
            return
        try:
            if not sep.available():
                return
        except Exception:
            return
        done = getattr(self, "_sep_done", 0)
        cens = [g["cen"] for g in voices]
        for c in items:
            if done >= DIARIZE_SEP_MAX:
                break
            if c.get("sep_checked"):
                continue
            c["sep_checked"] = True
            s = sorted((float(np.dot(c["emb"], ce)) for ce in cens), reverse=True)
            if len(s) < 2 or s[0] - s[1] > DIARIZE_SEP_GAP or s[1] < 0.15:
                continue
            done += 1
            try:
                parts = [np.asarray(p) for p in sep.separate(c["pcm"])]
            except Exception as e:
                logger.info(f"[{self.call_id}] ✂️ separation failed: {e}")
                continue
            desc = []
            for p in parts:
                pe = self._embed(p.astype(np.int16) if p.dtype != np.int16 else p, self.sample_rate)
                r = _nearfield(p, self.sample_rate, floor_db)
                if pe is None or r is None:
                    continue
                k = int(np.argmax([float(np.dot(pe, ce)) for ce in cens]))
                desc.append(f"{'ABCDEFGH'[k]} near {r['nf']:.2f}")
                if DIARIZE_SEPARATE == "on":
                    voices[k].setdefault("nf_sep", []).append(r["nf"])
            mode = "" if DIARIZE_SEPARATE == "on" else "[shadow] "
            logger.info(f"[{self.call_id}] ✂️ {mode}separated a two-voice piece → "
                        + (", ".join(desc) or "nothing usable"))
        self._sep_done = done

    def _diar_log(self, dz: Dict, note: str = "") -> None:
        names = "ABCDEFGH"
        parts = []
        for i, g in enumerate(dz["voices"][:5]):
            tag = ((" ← caller" if g is dz["choice"] else "") + (" (contrast)" if g.get("contrast") else "")
                   + (f" (led {g['streak']} checks in a row)" if g.get("streak") and g is dz["choice"] else "")
                   + (" (gave the caller's answers)" if g.get("anchored") and g is dz["choice"] else "")
                   + (" (first hello + scores agree)" if g.get("seeded") and g is dz["choice"] else "")
                   + (" seed" if g.get("seed") else "")
                   + (f" anchor {100 * g['anchor']:.0f}%" if "anchor" in g else "")
                   + (f" side {100 * g['side']:.0f}%" if "side" in g else ""))
            near = (f"near {g['near']:.2f} " if g.get("near") is not None
                    else ("near ? " if NEARFIELD != "off" else ""))
            parts.append(f"{names[i]}: {g['secs']:.0f}s answers {100 * g['cov']:.0f}% "
                         f"over-bot {100 * (1 - g['quiet']):.0f}% early {100 * g['early']:.0f}% "
                         f"{near}level {g['level']:.2f} score {g['score']:.2f}{tag}")
        mode = "" if DIARIZE == "on" else "[shadow] "
        if dz.get("info"):
            note = (note + " | " if note else "") + dz["info"]
        logger.info(f"[{self.call_id}] 👥 {mode}DIARIZE {len(dz['voices'])} voice(s), margin "
                    f"{dz['margin']:.2f}{' — no clear caller yet' if dz['crowd'] and dz['choice'] is None else ''}"
                    f" | " + " | ".join(parts) + (f" | {note}" if note else ""))

    def _loud_utts(self) -> Tuple[List[List[np.ndarray]], float]:
        """The enrollment answers with their quiet slices left out (ENROLL_LOUD),
        and how many seconds are left. An answer of whole turns (after a re-lock)
        is kept as it is."""
        hop = self.hop_len
        levels = [_rms(h) for u in self._utts for h in u if len(h) == hop]
        if not ENROLL_LOUD or len(levels) < 5:
            return self._utts, self._enroll_speech_s
        floor = ENROLL_LOUD_RATIO * float(np.percentile(levels, ENROLL_LOUD_PERCENTILE))
        out: List[List[np.ndarray]] = []
        n = 0
        for u in self._utts:
            keep = [h for h in u if len(h) != hop or _rms(h) >= floor]
            n += sum(len(h) for h in keep)
            out.append(keep)
        return out, n / self.sample_rate

    def machine_info(self) -> dict:
        """[MACHINE HANGUP 05-Nov] what the machine guard knows, for the agent.
        flagged      a voice talked through the whole greeting (voicemail / operator / robot,
                     but ALSO a person talking non-stop, a TV, echo — never hang up on this alone)
        on           the guard still silences that voice
        released_by  None | "person" (a person answered in a gap / a different voice came:
                     NEVER hang up) | "timer" (let go after MACHINE_MAX_S / HARD_MAX_S)
        lines_through bot lines that voice talked through (1 = the greeting)
        audio_s      seconds of the machine's voiced audio kept (machine_audio())
        locked       the lock already locked on a caller (NEVER hang up)"""
        flagged = bool(self.stats.get("machine", 0))
        ma = getattr(self, "_mg_audio", None) or []
        return {
            "flagged": flagged,
            "on": bool(getattr(self, "_mg_on", False)),
            "released_by": getattr(self, "_mg_released_by", None),
            "lines_through": int(getattr(self, "_mg_lines_through", 0)) if flagged else 0,
            "ratio": round(float(getattr(self, "_mg_ratio", 0.0)), 2),
            "audio_s": round(len(ma) * self._hop_s, 1),
            "locked": self.state is LockState.LOCKED,
        }

    def machine_audio(self) -> Optional[np.ndarray]:
        """[MACHINE HANGUP 05-Nov] the machine's voiced audio (int16, sample_rate), or None."""
        ma = list(getattr(self, "_mg_audio", None) or [])
        if not ma:
            return None
        return np.concatenate([np.asarray(p, np.int16) for p in ma])

    def tv_on_line(self) -> Optional[str]:
        """For the agent: before the lock, a voice is talking non-stop on the line
        (TV / radio) — its words must not choose the call's language. None = no."""
        try:
            if self.state is not LockState.ENROLLING:
                return None
            return self._tv_on_line()
        except Exception:
            return None

    def _tv_prints(self) -> List[np.ndarray]:
        """[TV VAD] voice prints known NOT to be the customer: the voice heard
        talking over the bot before the lock (BGM guard) and learned other voices."""
        out = []
        cached = getattr(self, "_bgm_prof_at", None)
        if cached is not None and cached[1] is not None:
            out.append(cached[1])
        out.extend(getattr(self, "_rivals", []) or [])
        return out

    def _tv_vad_strong(self) -> bool:
        """The lock knows the caller well: proven, >= 2 learned turns, and the
        caller's scores were high. Latched: a TV coming on later lowers the scores
        of the mixed turns — that must not switch the protection off."""
        if self.state is not LockState.LOCKED or not self._proven or len(self._bank) < 2:
            return False
        if getattr(self, "_tvv_strong", False):
            return True
        recent = list(self._sims)[-10:]
        if len(recent) >= 3 and float(np.median(recent)) >= TV_VAD_STRONG_SIM:
            self._tvv_strong = True
        return getattr(self, "_tvv_strong", False)

    def _tv_vad_track(self, hop) -> None:
        """[TV VAD] decide, per 100 ms slice heard with the bot silent, whether
        the VAD may hear silence (TV only, the caller not talking)."""
        hang = max(1, int(round(TV_VAD_HANG_S / self._hop_s)))
        if self._bot_speaking or hop.bot:
            self._tvv_last_cust = hop.idx            # bot turn: reset, never mute
            self._tvv_mute = False
            return
        mute = False
        why = ""
        if self.state is LockState.ENROLLING:
            if self._tv_near_active():
                if self._tv_near_hop(hop):
                    self._tvv_last_cust = hop.idx
                elif hop.idx - getattr(self, "_tvv_last_cust", -10 ** 9) > hang:
                    mute, why = True, "before the lock, quieter than the caller's voice (TV Near)"
            elif hop.voice:
                # TV NEAR off right now (e.g. the TV as loud as the caller): every voice
                # may be the caller's — so when it switches on again the caller's
                # current sentence is not muted from a stale "last caller" mark
                self._tvv_last_cust = hop.idx
        elif self.state is LockState.LOCKED:
            strong = self._tv_vad_strong()          # evaluated every slice: latched early
            prints = self._tv_prints()
            if prints and strong:
                typical = float(np.median(self._cust_rms)) if len(self._cust_rms) >= 2 else None
                if typical and hop.voice and hop.rms >= TV_VAD_CUST_LEVEL * typical:
                    self._tvv_last_cust = hop.idx          # as loud as the caller = the caller
                if hop.idx % max(1, TV_VAD_EVERY_HOPS) == 0:
                    hops = [self._get(i) for i in range(hop.idx - TV_VAD_WIN_HOPS + 1, hop.idx + 1)]
                    pcm = [h.pcm for h in hops if h is not None and not h.bot]
                    if len(pcm) >= TV_VAD_WIN_HOPS // 2 and hop.voice:
                        emb = self._embed(np.concatenate(pcm), self.sample_rate)
                        if emb is not None and self._profile is not None:
                            sc = float(np.dot(emb, self._profile))
                            st = max(float(np.dot(emb, p)) for p in prints)
                            self._tvv_last = (sc, st)
                            if (sc >= TV_VAD_CUST_SIM or st < TV_VAD_TV_SIM
                                    or st - sc < TV_VAD_MARGIN):
                                self._tvv_last_cust = hop.idx      # in doubt = customer
                            else:
                                self._tvv_tv_idx = hop.idx
                    elif not hop.voice:
                        pass                                       # silence: VAD hears silence anyway
                if (hop.idx - getattr(self, "_tvv_last_cust", -10 ** 9) > hang
                        and hop.idx - getattr(self, "_tvv_tv_idx", -10 ** 9) <= TV_VAD_EVERY_HOPS + 1):
                    sc, st = getattr(self, "_tvv_last", (0.0, 0.0))
                    mute, why = True, f"after the lock, TV voice {st:.2f} vs customer {sc:.2f}"
        was = getattr(self, "_tvv_mute", False)
        self._tvv_mute = mute
        if mute:
            self.stats["tv_vad_mute_hops"] += 1
            if not was:
                now = time.monotonic()
                if now - getattr(self, "_tvv_log_ts", 0.0) > 5.0:
                    self._tvv_log_ts = now
                    tag = "" if TV_VAD == "on" else "[shadow] "
                    logger.info(f"[{self.call_id}] 📺 {tag}TV only — the VAD "
                                f"{'hears' if TV_VAD == 'on' else 'would hear'} silence now ({why})")

    def _tv_level(self) -> float:
        lv = getattr(self, "_tv_lvls", None)
        # the LOUD part of the TV's speech (80th percentile), like _caller_level()
        return float(np.percentile(lv, 80)) if lv and len(lv) >= TV_NEAR_MIN_HOPS else 0.0

    def _machine_track(self, hop) -> None:
        """[MACHINE] see MACHINE_GUARD. Runs on every slice before the lock."""
        lines = getattr(self, "_mg_lines", 0)
        skip = int(round(MACHINE_SKIP_S / self._hop_s))
        st = getattr(self, "_bgm_bot_start", None)
        if self._bot_speaking and st is not None and hop.idx - st >= skip:
            self._mg_line_bot = getattr(self, "_mg_line_bot", 0) + 1
            if hop.voice:
                self._mg_line_speech = getattr(self, "_mg_line_speech", 0) + (1 if hop.speech else 0)
                self._mg_line_voice = getattr(self, "_mg_line_voice", 0) + 1
                if lines == 1 and not getattr(self, "_mg_on", False):
                    pcm = getattr(self, "_mg_pcm", None)
                    if pcm is None:
                        pcm = self._mg_pcm = []
                    if len(pcm) < 40:
                        pcm.append(hop.pcm)
        early = False
        if lines == 1 and self._bot_speaking and not getattr(self, "_mg_decided", False):
            nb, nv = getattr(self, "_mg_line_bot", 0), getattr(self, "_mg_line_voice", 0)
            early = nb * self._hop_s >= MACHINE_MIN_BOT_S and nv / nb >= MACHINE_RATIO
        if early or getattr(self, "_mg_line_end", False):
            if not early:
                self._mg_line_end = False
            nb, nv = getattr(self, "_mg_line_bot", 0), getattr(self, "_mg_line_voice", 0)
            ratio = nv / nb if nb else 0.0
            if lines == 1 and not getattr(self, "_mg_decided", False):
                self._mg_decided = True
                machine = nb * self._hop_s >= MACHINE_MIN_BOT_S and ratio >= MACHINE_RATIO
                greet, self._mg_greet = (getattr(self, "_mg_greet", None) or []), []
                if not machine:
                    self._mg_flush = greet or None      # a person: send what was kept
                if machine:
                    self._mg_on = True
                    self._mg_on_idx = hop.idx
                    self._mg_first_idx = hop.idx
                    pcm = getattr(self, "_mg_pcm", None) or []
                    self._mg_print = self._embed(np.concatenate(pcm), self.sample_rate) if len(pcm) >= 10 else None
                    self._utts, self._utt_aids = [], []
                    self._enroll_speech_s = 0.0
                    self.stats["machine"] += 1
                    # [MACHINE HANGUP 05-Nov] keep the machine's own audio (greeting part +
                    # what follows, up to MACHINE_AUDIO_MAX_S) so the agent can read its words
                    self._mg_audio = [p for p in greet][-int(MACHINE_AUDIO_MAX_S / self._hop_s):]
                    self._mg_ratio = ratio
                    self._mg_lines_through = 1
                    logger.warning(f"[{self.call_id}] 🤖 a voice talked through the whole greeting "
                                   f"({100 * ratio:.0f}% of it) — voicemail / operator message / robot: "
                                   f"STT and VAD get silence, it is not learned")
            elif getattr(self, "_mg_on", False) and nb * self._hop_s >= 1.0:
                # a person listens while the bot talks, then answers in the gap
                self._mg_quiet_line = ratio <= MACHINE_QUIET_LINE
                self._mg_gap_start = hop.idx
                if ratio >= MACHINE_RATIO:
                    self._mg_on_idx = hop.idx       # talked through this bot line too: still a machine
                    if lines >= 2:                  # a later bot line (the greeting is already 1)
                        self._mg_lines_through = getattr(self, "_mg_lines_through", 1) + 1
        if not getattr(self, "_mg_on", False):
            return
        why = None
        if (hop.idx - getattr(self, "_mg_first_idx", self._mg_on_idx)) * self._hop_s >= MACHINE_HARD_MAX_S:
            why = f"{MACHINE_HARD_MAX_S:.0f}s since it switched on (a person may be talking beside the caller)"
        elif (hop.idx - self._mg_on_idx) * self._hop_s >= MACHINE_MAX_S:
            why = f"{MACHINE_MAX_S:.0f}s passed"
        elif (not self._bot_speaking and hop.voice and getattr(self, "_mg_quiet_line", False)
                and hop.idx - getattr(self, "_mg_gap_start", -10 ** 9) <= int(3.0 / self._hop_s)):
            why = "the voice was quiet while the bot spoke and now answers it"
            self._mg_released_by = "person"
        elif (not self._bot_speaking and hop.voice and self._mg_print is not None
                and hop.idx % 5 == 0):
            win = [self._get(i) for i in range(hop.idx - 9, hop.idx + 1)]
            pcm = [h.pcm for h in win if h is not None and h.voice and not h.bot]
            if len(pcm) >= 7:
                emb = self._embed(np.concatenate(pcm), self.sample_rate)
                if emb is not None and float(np.dot(emb, self._mg_print)) < MACHINE_OTHER_SIM:
                    why = f"a different voice (match {float(np.dot(emb, self._mg_print)):.2f})"
                    self._mg_released_by = "person"
        if why:
            if not getattr(self, "_mg_released_by", None):
                self._mg_released_by = "timer"
            self._mg_on = False
            self._mg_quiet_line = False
            self._mg_release_pre = list(getattr(self, "_mg_held", None) or [])
            self._mg_held = []
            logger.warning(f"[{self.call_id}] 🤖 machine guard released — {why}")

    def _tv_near_base(self) -> bool:
        """[TV NEAR] TV on, its level known, not switched off, before the lock."""
        return bool(TV_NEAR and getattr(self, "_tv_held", False)
                    and not getattr(self, "_tv_near_off", False)
                    and self.state is LockState.ENROLLING and self._tv_level() > 0)

    def _tv_near_active(self) -> bool:
        """[TV NEAR] _tv_near_base() and the TV clearly quieter than the caller
        (TV_NEAR_MAX_RATIO). The "caller quieter than the TV → off for the call"
        count keeps using _tv_near_base(), so a ratio that flips back and forth
        cannot keep that safety from ever firing."""
        if not self._tv_near_base():
            return False
        ref = self._caller_level()
        return not (ref and self._tv_level() > TV_NEAR_MAX_RATIO * ref)

    def _tv_near_hop(self, hop) -> bool:
        return bool(hop.voice and hop.rms >= TV_NEAR_X * self._tv_level())

    def _tv_on_line(self) -> Optional[str]:
        """[TV HOLD] Why a voice that never stops is on the line now, or None."""
        h = getattr(self, "_tv_hist", None)
        if not TV_HOLD or not h:
            return None
        # the bot lines in the window, each judged on its own (a quiet greeting
        # must not hide a TV that started after it): the latest long enough one
        runs, cur = [], []
        for k, v in h:
            if k == 1:
                cur.append(v)
            elif cur:
                runs.append(cur)
                cur = []
        if cur:
            runs.append(cur)
        runs = [r for r in runs if len(r) * self._hop_s >= TV_HOLD_MIN_BOT_S]
        gp = [v for k, v in h if k == 2]
        # [TV HOLD 19-Oct b] once the TV was found, it stays found while the gaps are
        # still full of voice: a TV that keeps cutting the bot off leaves no long
        # bot line to judge, and …59083 locked in that moment.
        if getattr(self, "_tv_held", False):
            last = gp[-int(TV_HOLD_RELEASE_S / self._hop_s):]
            if len(last) * self._hop_s >= TV_HOLD_RELEASE_S * 0.5:
                fr = sum(last) / len(last)
                if fr >= TV_HOLD_RELEASE_GAPS:
                    return f"still voice {fr:.0%} of the time the bot is silent"
                self._tv_held = False
                logger.info(f"[{self.call_id}] 📺 the non-stop voice is gone "
                            f"(voice {fr:.0%} of the last gaps) — learning the caller's voice again")
            else:
                return "waiting for the line to be heard without the bot"
        if len(gp) * self._hop_s < TV_HOLD_MIN_GAP_S:
            return None
        if runs:
            ob = runs[-1]
        else:
            # only short bot lines (cut off): judge them together
            ob = [v for k, v in h if k == 1]
            if len(ob) * self._hop_s < TV_HOLD_MIN_BOT_S:
                return None
        fo, fg = sum(ob) / len(ob), sum(gp) / len(gp)
        if fo >= TV_HOLD_OVER_BOT and fg >= TV_HOLD_GAPS:
            self._tv_held = True
            self._tv_seen_any = True
            return f"voice {fo:.0%} of the time the bot spoke and {fg:.0%} of the time it was silent"
        return None

    def _maybe_build(self) -> None:
        if self._building or self.state is not LockState.ENROLLING:
            return
        why_tv = self._tv_on_line()
        if why_tv:
            now = time.monotonic()
            if now - getattr(self, "_tv_hold_logged", 0.0) > 10.0:
                self._tv_hold_logged = now
                self.stats["tv_hold"] += 1
                logger.warning(f"[{self.call_id}] 📺 a voice talks non-stop on the line ({why_tv}) "
                               f"— TV / radio / video: not learning the caller's voice yet")
            # what was collected before the TV was found is mixed with it: start again
            if not getattr(self, "_tv_cleared", False):
                self._tv_cleared = True
                self._utts, self._utt_aids = [], []
                self._enroll_speech_s = 0.0
                self._barge_hops = []
            if not (TV_NEAR_ENROLL and self._tv_near_active()):
                # TV level not known yet / filter off: everything heard is mixed with it
                self._utts, self._utt_aids = [], []
                self._enroll_speech_s = 0.0
                self._barge_hops = []
                return
            # [TV NEAR] the collected answers are the louder-than-TV voice only:
            # build from them (the TV voice print is cut out by the BGM guard too)
            if now - getattr(self, "_tv_near_logged", 0.0) > 10.0:
                self._tv_near_logged = now
                logger.info(f"[{self.call_id}] 📺 learning the caller from the voice louder than the "
                            f"TV (TV level {self._tv_level():.0f}, x{TV_NEAR_X:g})")
        else:
            self._tv_cleared = False
        need = max(ENROLL_MIN_SECONDS + self._attempts * ENROLL_RETRY_EXTRA_S, self._wait_until_s)
        if self._enroll_speech_s < need:
            return
        loud_utts, loud_s = self._loud_utts()
        # _wait_until_s is measured on everything heard; the loud part must reach
        # the plain minimum
        if loud_s < ENROLL_MIN_SECONDS + self._attempts * ENROLL_RETRY_EXTRA_S:
            return
        if (ENROLL_MIN_WORDS > 0 and self._relocks == 0 and self._enroll_words_seen
                and self._enroll_words < ENROLL_MIN_WORDS):
            if not self._words_wait_logged:
                self._words_wait_logged = True
                logger.info(f"[{self.call_id}] enrollment: {loud_s:.1f}s of sound but only "
                            f"{self._enroll_words} word(s) heard — waiting for "
                            f"{ENROLL_MIN_WORDS} before trusting it as the caller's voice")
            return
        aids = [a for lu, a in zip(loud_utts, self._utt_aids) if lu]
        if (ENROLL_TWO_ANSWERS and self._relocks == 0 and len(set(aids)) < 2
                and loud_s < ENROLL_SINGLE_ANSWER_S):
            if not self._two_answer_logged:
                self._two_answer_logged = True
                logger.info(f"[{self.call_id}] enrollment: {loud_s:.1f}s heard, all "
                            f"in ONE answer — waiting for a second answer to confirm the voice")
            return
        # aids were taken from the full answers; keep each with its loud part
        pairs = [(np.concatenate(lu), a)
                 for u, lu, a in zip(self._utts, loud_utts, self._utt_aids) if u and lu]
        if len(self._utt_aids) != len(self._utts):
            pairs = [(np.concatenate(lu), i) for i, lu in enumerate(loud_utts) if lu]
        utts = [x for x, _ in pairs]
        aids = [a for _, a in pairs]
        if not utts:
            return
        self._building = True
        threading.Thread(target=self._build_worker, args=(utts, aids),
                         name=f"voicelock-enroll-{self.call_id}", daemon=True).start()

    def _build_worker(self, utts: List[np.ndarray], aids: Optional[List[int]] = None) -> None:
        res = None
        self._need_more = False
        dz = None
        use_dz = False
        try:
            if self._extractor is not None:
                self._extractor_ok = bool(self._extractor.available())
            if DIARIZE != "off" and self._relocks == 0:
                try:
                    dz = self._diarize()
                except Exception as e:
                    logger.error(f"[{self.call_id}] diarize failed (old rule used): {e}")
                    dz = None
            # [v10 NEAR-FIELD CLEAN] the voice grouping can merge the caller with a loud
            # bystander into ONE "voice" (short answers, phone-line prints). Its pieces then
            # come from two distances: some at the phone, some across the room. When both
            # are heard, learn ONLY the pieces at the phone; too few of them yet → wait
            # (old rule after DIARIZE_MAX_WAIT_S). One distance only (a caller alone, also
            # on speakerphone) → the old rule as before.
            if (NEARFIELD == "shadow" and DIARIZE == "on" and dz is not None and not dz["crowd"]
                    and dz["voices"]):
                cl = self._near_clean(dz["voices"][0])
                if cl is not None and not getattr(self, "_nf_shadow_logged", False):
                    self._nf_shadow_logged = True
                    logger.info(f"[{self.call_id}] 👥 [shadow] one voice group but two distances "
                                f"heard: {len(cl[0])} piece(s) at the phone, {len(cl[1])} from across "
                                f"the room — NEARFIELD=on would learn only the ones at the phone")
            if (NEARFIELD == "on" and DIARIZE == "on" and dz is not None and not dz["crowd"]
                    and dz["voices"]):
                cl = self._near_clean(dz["voices"][0])
                if cl is not None:
                    hi, lo = cl
                    if len(hi) >= DIARIZE_MIN_CHUNKS:
                        logger.info(f"[{self.call_id}] 👥 one voice group but two distances heard: "
                                    f"learning only the {len(hi)} pieces at the phone (near ≥ "
                                    f"{NF_HI:.2f}), leaving out {len(lo)} from across the room")
                        utts, aids, use_dz = [c["pcm"] for c in hi], None, True
                    elif self._enroll_speech_s < DIARIZE_MAX_WAIT_S:
                        _now = time.monotonic()
                        if _now - getattr(self, "_nf_wait_logged", 0.0) > 5.0:
                            self._nf_wait_logged = _now
                            logger.info(f"[{self.call_id}] 👥 voices from across the room and only "
                                        f"{len(hi)} piece(s) at the phone — waiting for more answers")
                        self._need_more = True
                        utts = []
                    dz = None if not use_dz else dz
            if DIARIZE == "on" and dz is not None and dz["crowd"]:
                if dz["choice"] is not None:
                    # several voices and one clearly behaves like the caller: learn ONLY it
                    picked = [c["pcm"] for c in dz["choice"]["items"] if not c["bot"]]
                    cl = self._near_clean(dz["choice"]) if NEARFIELD == "on" else None
                    if cl is not None and len(cl[0]) >= DIARIZE_MIN_CHUNKS:
                        picked = [c["pcm"] for c in cl[0]]     # [v10] only its pieces at the phone
                    if len(picked) >= DIARIZE_MIN_CHUNKS:
                        utts, aids, use_dz = picked, None, True
                elif self._enroll_speech_s < DIARIZE_MAX_WAIT_S:
                    self._diar_log(dz, "waiting for more answers")
                    self._need_more = True
                    utts = []
                else:
                    self._diar_log(dz, f"no clear caller after {DIARIZE_MAX_WAIT_S:.0f}s — old rule")
            if BGM_GUARD and utts and not use_dz:
                utts, aids = self._bgm_filter(utts, aids)
            if aids is not None and utts:
                utts = self._agreeing_answers(utts, aids)
            res = self._build_profile(utts) if utts else None
            if dz is not None and (use_dz or (DIARIZE == "shadow" and res is not None)):
                note = ""
                if res is not None:
                    sims = [float(np.dot(res["profile"], g["cen"])) for g in dz["voices"]]
                    k = int(np.argmax(sims))
                    same = dz["choice"] is None or dz["voices"][k] is dz["choice"]
                    note = (f"the lock learned voice {'ABCDEFGH'[k]} (sim {sims[k]:.2f})"
                            + ("" if same else " — NOT the voice DIARIZE picks"))
                self._diar_log(dz, note)
        except Exception as e:
            logger.error(f"[{self.call_id}] enrollment build failed: {e}")
        with self._mutex:
            self._building = False
            if res is None and self._need_more:
                # not a failed attempt — just not enough speech yet; try again
                # after one more second of answers, not on every new hop
                self._wait_until_s = self._enroll_speech_s + 1.0
                return
            self._attempts += 1
            if res is not None and (self._best is None or res["p5"] > self._best["p5"]):
                self._best = res
            last = self._attempts >= ENROLL_MAX_ATTEMPTS
            if res is not None and res["p5"] >= MIN_CALLER_P5:
                self._lock_on(res)
            elif last and self._best is not None and self._best["p5"] >= MIN_CALLER_P5_LAST_TRY:
                self._lock_on(self._best)
            elif last and self._restore_prev_lock():
                pass
            elif last:
                self.state = LockState.FAILED_OPEN
                self._utts = []
                self._utt_aids = []
                logger.error(f"[{self.call_id}] ❌ Could not isolate one customer voice after "
                             f"{self._attempts} attempts (best p5="
                             f"{self._best['p5'] if self._best else 'n/a'}) — audio passes unfiltered")
            else:
                logger.warning(f"[{self.call_id}] ⚠️ Enrollment attempt {self._attempts} not clean "
                               f"(p5={res['p5'] if res else 'n/a'}) — collecting more speech")

    def _bgm_filter(self, utts: List[np.ndarray], aids: Optional[List[int]]):
        """[fix 28] Drop the answers spoken by a voice that kept talking over the bot."""
        if getattr(self, "_bgm_off", False):
            return utts, aids
        sp = getattr(self, "_bgm_speech_hops", 0)
        bh = getattr(self, "_bgm_bot_hops", 0)
        buf = getattr(self, "_bgm_buf", None)
        if not buf or sp * self._hop_s < BGM_MIN_S or sp < BGM_MIN_FRACTION * max(1, bh):
            return utts, aids
        cached = getattr(self, "_bgm_prof_at", None)
        if cached is None or cached[0] != sp:
            embs, _ = self._embed_pieces([np.concatenate(list(buf))])
            prof = _norm(np.median(np.vstack(embs), axis=0)) if len(embs) >= 4 else None
            self._bgm_prof_at = (sp, prof)
        prof = self._bgm_prof_at[1]
        if prof is None:
            return utts, aids
        min_len = int(0.8 * self.sample_rate)
        piece = int(1.0 * self.sample_rate)
        keep, dropped, cut_s = [], [], 0.0
        utts = list(utts)
        for i, u in enumerate(utts):
            if len(u) < min_len:
                keep.append(i)                      # too short to tell ("హా", "Hello")
                continue
            # judged second by second: the caller's answer and the video often
            # run into each other without a pause
            parts = [u[j:j + piece] for j in range(0, len(u), piece)]
            if len(parts) > 1 and len(parts[-1]) < piece // 2:
                parts[-2] = np.concatenate([parts[-2], parts[-1]])
                parts.pop()
            good = []
            for part in parts:
                e = self._embed(part, self.sample_rate)
                if e is not None and float(np.dot(e, prof)) >= BGM_MATCH_SIM:
                    cut_s += len(part) / self.sample_rate
                else:
                    good.append(part)
            if len(good) == len(parts):
                keep.append(i)
            elif good and sum(len(g) for g in good) >= min_len // 2:
                utts[i] = np.concatenate(good)
                keep.append(i)
            else:
                dropped.append(i)
        if not dropped and cut_s == 0.0:
            return utts, aids
        now = time.monotonic()
        if not any(len(utts[i]) >= min_len for i in keep):
            first = getattr(self, "_bgm_wait_since", None)
            if first is None:
                self._bgm_wait_since = first = now
            if now - first > BGM_GIVE_UP_S:
                self._bgm_off = True
                logger.warning(f"[{self.call_id}] 📺 only the voice that talks over the bot was heard "
                               f"for {BGM_GIVE_UP_S:.0f}s — background guard off for this call")
                return utts, aids
        else:
            self._bgm_wait_since = None
        if getattr(self, "_bgm_logged", 0) < 3:
            self._bgm_logged = getattr(self, "_bgm_logged", 0) + 1
            logger.warning(f"[{self.call_id}] 📺 a voice kept talking while the bot was speaking "
                           f"({sp * self._hop_s:.1f}s, {100 * sp // max(1, bh)}% of the time) — "
                           f"TV / video, not the caller: {cut_s + sum(len(utts[i]) for i in dropped) / self.sample_rate:.1f}s "
                           f"of it left out of the voice profile")
        # forget those answers, so the caller's short answers are not pushed out of the buffer
        sig = {(len(utts[i]), utts[i][:64].tobytes()) for i in dropped}
        with self._mutex:
            nu, na = [], []
            for hops, a in zip(self._utts, self._utt_aids):
                if hops and (sum(len(h) for h in hops), hops[0][:64].tobytes()) in sig:
                    self._enroll_speech_s = max(0.0, self._enroll_speech_s - len(hops) * self._hop_s)
                    continue
                nu.append(hops)
                na.append(a)
            self._utts, self._utt_aids = nu, na
        utts2 = [utts[i] for i in keep]
        aids2 = [aids[i] for i in keep] if aids is not None and len(aids) == len(utts) else None
        if not utts2:
            self._need_more = True
        return utts2, aids2

    def _embed_pieces(self, pieces: List[np.ndarray]):
        step = max(1, self._win_len // 3)
        embs, wins = [], []
        for p in pieces:
            for w in _windows(p, self._win_len, step):
                e = self._embed(w, self.sample_rate)
                if e is not None:
                    embs.append(e)
                    wins.append(w)
        return embs, wins

    def _mean_sim(self, x: np.ndarray, prof: np.ndarray) -> float:
        embs, _ = self._embed_pieces([x])
        return float(np.mean([np.dot(e, prof) for e in embs])) if embs else -1.0

    def _agreeing_answers(self, utts: List[np.ndarray], aids: List[int]) -> List[np.ndarray]:
        """Keep only the answers that sound like the same person. Answers shorter
        than ANSWER_CHECK_MIN_S are kept unjudged. If two long answers disagree and
        there is no third to break the tie, wait for one (returns [] + need_more)."""
        groups: Dict[int, List[np.ndarray]] = {}
        for u, a in zip(utts, aids):
            groups.setdefault(a, []).append(u)
        if len(groups) < 2:
            return utts
        embs: Dict[int, np.ndarray] = {}
        for a, us in groups.items():
            x = np.concatenate(us)
            if len(x) >= ANSWER_CHECK_MIN_S * self.sample_rate:
                e = self._embed(x[-int(6 * self.sample_rate):], self.sample_rate)
                if e is not None:
                    embs[a] = e
        if len(embs) < 2:
            return utts
        keys = list(embs)
        # [29-Oct …63522] group the answers by who said them; if one group is clearly
        # LOUDER (the voice at the phone), keep that one even when another group has
        # more answers (two quiet people beside the caller agreed 0.41 and won 2:1)
        comp = {a: a for a in keys}
        def _root(a):
            while comp[a] != a:
                a = comp[a]
            return a
        for i, a in enumerate(keys):
            for b in keys[i + 1:]:
                if float(np.dot(embs[a], embs[b])) >= ANSWER_AGREE_SIM:
                    comp[_root(a)] = _root(b)
        comps: Dict[int, List[int]] = {}
        for a in keys:
            comps.setdefault(_root(a), []).append(a)
        anc = getattr(self, "_anchor_aids", None) or set()
        if len(comps) >= 2 and anc and DIARIZE_ANCHOR == "on":
            hits = {r: sum(1 for a in m if a in anc) for r, m in comps.items()}
            top_r = max(hits, key=hits.get)
            if hits[top_r] > 0 and sorted(hits.values())[-2:] != [hits[top_r]] * 2:
                keep_aids = set(comps[top_r])
                self._crowd_reason = f"answers come from {len(comps)} voices"
                logger.warning(f"[{self.call_id}] ⚓ answers come from {len(comps)} voices — keeping the "
                               f"one that gave the caller's answers ({hits[top_r]} anchor answer(s))")
                return [u for u, a in zip(utts, aids) if a in keep_aids or a not in embs]
        if len(comps) >= 2:
            self._crowd_reason = f"answers come from {len(comps)} voices"
            def _lvl(a):
                x = np.concatenate(groups[a])
                hl = self.hop_len
                fr = [_rms(x[i:i + hl]) for i in range(0, len(x) - hl + 1, hl)]
                return float(np.percentile(fr, 80)) if fr else 0.0
            lv = {a: _lvl(a) for a in keys}
            cl = {r: float(np.median([lv[a] for a in m])) for r, m in comps.items()}
            top = max(cl, key=cl.get)
            others = [v for r, v in cl.items() if r != top]
            if others and cl[top] >= ANSWER_LOUD_X * max(others):
                keep_aids = set(comps[top])
                logger.warning(f"[{self.call_id}] 📢 answers come from {len(comps)} voices — keeping the "
                               f"one at the phone ({cl[top] / max(1.0, max(others)):.1f}x louder, "
                               f"{len(keep_aids)} answer(s)); the quieter voice(s) left out of the profile")
                return [u for u, a in zip(utts, aids) if a in keep_aids or a not in embs]
        agree = {a: [] for a in keys}
        for i, a in enumerate(keys):
            for b in keys[i + 1:]:
                s = float(np.dot(embs[a], embs[b]))
                agree[a].append(s)
                agree[b].append(s)
        best = {a: max(v) for a, v in agree.items()}
        odd = [a for a in keys if best[a] < ANSWER_AGREE_SIM]
        if not odd:
            logger.info(f"[{self.call_id}] ✅ {len(keys)} answers sound like the same person "
                        f"(agreement {min(best.values()):.2f}–{max(best.values()):.2f})")
            return utts
        if len(odd) == len(keys):
            if len(keys) == 2 and self._enroll_speech_s < ENROLL_BUFFER_MAX_S - 1.0:
                logger.warning(f"[{self.call_id}] 👥 the two answers sound like DIFFERENT people "
                               f"(agreement {best[keys[0]]:.2f}) — waiting for a third answer")
                self._need_more = True
                return []
            return utts       # no two agree: let SepFormer sort it out
        logger.warning(f"[{self.call_id}] 👥 {len(odd)} answer(s) don't match the others "
                       f"(agreement {', '.join(f'{best[a]:.2f}' for a in odd)}) — left out of "
                       f"the voice profile")
        return [u for u, a in zip(utts, aids) if a not in odd]

    def _build_profile(self, utts: List[np.ndarray]) -> Optional[Dict]:
        # Short answers ("తెలుగు", "హా") are each shorter than one window, so window
        # the JOINED speech — otherwise a 3 s enrollment yields only ~3 windows.
        embs, wins = self._embed_pieces([np.concatenate(utts)])
        if len(embs) < ENROLL_MIN_WINDOWS:
            logger.info(f"[{self.call_id}] enrollment: only {len(embs)} windows, need "
                        f"{ENROLL_MIN_WINDOWS} — waiting for more speech")
            self._need_more = True
            return None
        E = np.vstack(embs)
        prof = _norm(np.median(E, axis=0))
        sims = E @ prof
        multi = float(np.mean(sims < MULTI_SPEAKER_SIM)) > MULTI_SPEAKER_FRACTION
        separated = False

        if multi and self._separator is not None and self._separator.available():
            logger.warning(f"[{self.call_id}] 👥 More than one voice in enrollment audio "
                           f"({np.mean(sims < MULTI_SPEAKER_SIM):.0%} of windows off-profile) "
                           f"— separating with SepFormer")
            max_len = int(SEPARATOR_PIECE_S * self.sample_rate)
            alts: List[List[np.ndarray]] = []
            for u in utts:
                for p in _split(u, max_len):
                    if len(p) < self._win_len // 2:
                        continue
                    streams = [np.asarray(s[:len(p)], dtype=np.int16)
                               for s in self._separator.separate(p)]
                    streams = [s for s in streams if len(s) == len(p)]
                    alts.append(streams or [p])
            # 1st pass: the near-mic (loudest) source is the one answering the bot
            pieces = [max(a, key=_rms) for a in alts]
            embs, wins = self._embed_pieces(pieces)
            if len(embs) < ENROLL_MIN_WINDOWS:
                # 3 windows locked V0011101050000043817 onto the wrong voice —
                # too few to trust. Wait for more answers instead.
                logger.info(f"[{self.call_id}] enrollment: only {len(embs)} separated windows, "
                            f"need {ENROLL_MIN_WINDOWS} — waiting for more speech")
                self._need_more = True
                return None
            prof = _norm(np.median(np.vstack(embs), axis=0))
            # 2nd pass: per utterance, the source that matches that voice best
            pieces = [max(a, key=lambda s: self._mean_sim(s, prof)) for a in alts]
            embs, wins = self._embed_pieces(pieces)
            if len(embs) < ENROLL_MIN_WINDOWS:
                self._need_more = True
                return None
            E = np.vstack(embs)
            prof = _norm(np.median(E, axis=0))
            separated = True

        keep = np.ones(len(E), dtype=bool)
        for _ in range(ENROLL_OUTLIER_ITERATIONS):
            s = E @ prof
            cutoff = max(float(np.percentile(s, ENROLL_OUTLIER_PERCENTILE)),
                         float(s.mean() - s.std()))
            k = s >= cutoff
            if k.sum() < 3:
                break
            keep = k
            prof = _norm(np.median(E[keep], axis=0))

        kept_sims = E[keep] @ prof
        p5 = float(np.percentile(kept_sims, 5))

        order = np.argsort(-(E @ prof))
        ref, total = [], 0
        for j in order:
            if not keep[j]:
                continue
            ref.append(wins[j])
            total += len(wins[j])
            if total >= TSE_REF_SECONDS * self.sample_rate:
                break
        return {"profile": prof, "p5": p5, "ref": np.concatenate(ref),
                "separated": separated, "windows": int(keep.sum())}

    def _lock_on(self, res: Dict) -> None:
        self._tvv_strong = False                  # [TV VAD] a new profile must prove itself again
        p5 = res["p5"]
        self._profile = res["profile"].copy()
        self._anchor = res["profile"].copy()
        self._bank = [res["profile"].copy()]
        self._run_open = False
        self._switch_streak = 0
        self._thr = float(np.clip((p5 + STRANGER_BAND_MAX) / 2.0,
                                  max(HARD_REJECT_COSINE + 0.05, THRESHOLD_MIN), THRESHOLD_MAX))
        self._thr_clean = min(self._thr + OVERLAP_MARGIN, 0.95)
        self._tse_ref = res["ref"]
        self._tse_cache = None
        self._cust_f0 = collections.deque(maxlen=20)
        f0 = _pitch_hz(res["ref"], self.sample_rate)
        if f0 is not None:
            self._cust_f0.append(f0)
        self._utts = []
        self._utt_aids = []
        self._loud_foreign = []
        self._weak_turns = []
        self._prev_lock = None
        self.state = LockState.LOCKED
        self._turns_since_lock = 0
        self._verified_since_lock = 0
        self._proven = False
        self._probation_turns: List[np.ndarray] = []
        self._wait_until_s = 0.0
        logger.warning(
            f"[{self.call_id}] 🔒 CUSTOMER VOICE LOCKED | p5={p5:.3f} thr={self._thr:.2f} "
            f"clean={self._thr_clean:.2f} windows={res['windows']} "
            f"separated={res['separated']} tse={'on' if self._extractor_ok else 'off'} "
            f"— from here only this voice reaches STT"
        )

