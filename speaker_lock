#  SIGNAL HELPERS
# ════════════════════════════════════════════════════════════════════════════
def _rms(x: np.ndarray) -> float:
    if x is None or len(x) == 0:
        return 0.0
    return float(np.sqrt(np.mean(x.astype(np.float32) ** 2)))


def _sfm(x: np.ndarray) -> float:
    if len(x) == 0:
        return 1.0
    mag = np.abs(np.fft.rfft(x.astype(np.float32) / 32768.0, n=max(256, len(x)))) + 1e-10
    return float(np.clip(np.exp(np.mean(np.log(mag))) / np.mean(mag), 0.0, 1.0))


def _pitch_hz(x: np.ndarray, sr: int) -> Optional[float]:
    """Median pitch (F0) of the voiced parts of x, by autocorrelation (70-400 Hz).
    None if fewer than 3 voiced 40 ms frames. Cheap: ~1 ms per second of audio."""
    if x is None or len(x) < int(0.12 * sr):
        return None
    x = x.astype(np.float32)
    frame, step = int(0.04 * sr), int(0.01 * sr)
    lo, hi = int(sr / 400), int(sr / 70)
    if frame <= hi + 2:
        return None
    level = float(np.sqrt(np.mean(x ** 2))) + 1e-6
    f0s = []
    for s in range(0, len(x) - frame + 1, step):
        f = x[s:s + frame]
        f = f - f.mean()
        e = float(np.dot(f, f))
        if e < (0.3 * level) ** 2 * frame:
            continue
        ac = np.correlate(f, f, mode="full")[frame - 1:]
        seg = ac[lo:hi + 1]
        k = int(np.argmax(seg))
        if seg[k] / (ac[0] + 1e-9) < 0.45:
            continue
        lag = lo + k
        # prefer the shortest lag that is nearly as strong (avoid octave-down errors)
        for div in (3, 2):
            l2 = int(round(lag / div))
            if l2 >= lo and ac[l2] >= 0.85 * ac[lag]:
                lag = l2
                break
        f0s.append(sr / lag)
    if len(f0s) < 3:
        return None
    return float(np.median(f0s))


def _norm(v: np.ndarray) -> np.ndarray:
    n = float(np.linalg.norm(v))
    return (v / n).astype(np.float32) if n > 1e-9 else v.astype(np.float32)


def _windows(x: np.ndarray, win: int, step: int) -> List[np.ndarray]:
    if len(x) < win // 2:
        return []
    if len(x) <= win:
        return [x]
    return [x[s:s + win] for s in range(0, len(x) - win + 1, step)]


def _split(x: np.ndarray, max_len: int) -> List[np.ndarray]:
    return [x[s:s + max_len] for s in range(0, len(x), max_len)]


def _env_db(pcm: np.ndarray, sr: int, frame_s: float = 0.005) -> Optional[np.ndarray]:
    x = np.asarray(pcm, dtype=np.float64)
    fl = max(1, int(frame_s * sr))
    n = len(x) // fl
    if n < 60:                                   # < 0.3 s
        return None
    return 10.0 * np.log10(np.mean(x[:n * fl].reshape(n, fl) ** 2, axis=1) + 1.0)


def _nearfield(pcm: np.ndarray, sr: int, floor_db: float) -> Optional[Dict[str, float]]:
    """[v10 NEAR-FIELD] level-free 'at the phone' score of one piece (see NEARFIELD).
    Returns {"nf": 0..1, "decay": dB/s or -1, "gap": dB above the line floor}."""
    e = _env_db(pcm, sr)
    if e is None:
        return None
    n = len(e)
    pk = float(np.percentile(e, 95))
    if pk - floor_db < 20.0:                     # too close to the line noise to judge
        return None
    gap = float(np.percentile(e, 10)) - floor_db
    g = 1.0 - float(np.clip((gap - NF_GAP_LO) / max(1e-6, NF_GAP_HI - NF_GAP_LO), 0.0, 1.0))
    rates: List[float] = []
    lim = int(0.3 / 0.005)
    t = 1
    while t < n - 2:
        if e[t] >= pk - 12.0 and e[t] >= e[t - 1] and e[t] >= e[t + 1]:
            top, j6, j18 = e[t], None, None
            for j in range(t + 1, min(n, t + lim)):
                if e[j] > top + 1.0:             # a new syllable starts: not a fade
                    break
                if j6 is None and e[j] <= top - 6.0:
                    j6 = j
                if e[j] <= top - 18.0:
                    j18 = j
                    break
            if j6 is not None and j18 is not None:
                rates.append(12.0 / (max(1, j18 - j6) * 0.005))
                t = j18
                continue
        t += 1
    if len(rates) < 2:
        return {"nf": g, "decay": -1.0, "gap": gap}
    decay = float(np.median(rates))
    d = float(np.clip((decay - NF_DECAY_LO) / max(1e-6, NF_DECAY_HI - NF_DECAY_LO), 0.0, 1.0))
    return {"nf": 0.5 * d + 0.5 * g, "decay": decay, "gap": gap}


