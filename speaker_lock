class _VoiceDetector:
    """Silero VAD, streaming, one instance per call. prob(hop) = highest voice
    probability of the 32 ms chunks completed inside that 100 ms slice."""

    def __init__(self, sample_rate: int):
        import torch
        from silero_vad import load_silero_vad
        if sample_rate not in (8000, 16000):
            raise ValueError(f"Silero VAD needs 8 or 16 kHz, not {sample_rate}")
        self._torch = torch
        self._model = load_silero_vad()
        self._sr = sample_rate
        self._chunk = 256 if sample_rate == 8000 else 512
        self._buf = np.zeros(0, dtype=np.float32)

    def prob(self, pcm: np.ndarray) -> float:
        self._buf = np.concatenate([self._buf, pcm.astype(np.float32) / 32768.0])
        best = 0.0
        with self._torch.no_grad():
            while len(self._buf) >= self._chunk:
                x = self._torch.from_numpy(self._buf[:self._chunk].copy())
                self._buf = self._buf[self._chunk:]
                best = max(best, float(self._model(x, self._sr)))
        return best


def _make_voice_detector(sample_rate: int):
    if not PRELOCK_NOISE or PRELOCK_VOICE != "silero":
        return None
    try:
        return _VoiceDetector(sample_rate)
    except Exception as e:
        logger.warning(f"Silero VAD unavailable ({e}) — the pre-lock noise gate uses the simple "
                       f"speech test, which lets most real traffic noise through "
                       f"(pip install silero-vad)")
        return None


_DF_LOCK = threading.Lock()
_DF_MODEL = None          # (model, df_state template params) once loaded
_DF_FAILED = False


def _df_compat() -> None:
    """deepfilternet 0.5.x imports torchaudio.backend.common, which newer
    torchaudio removed. Only a type name is used from it, so a stand-in is enough."""
    import sys
    import types
    try:
        import torchaudio.backend.common  # noqa: F401
    except Exception:
        m1 = types.ModuleType("torchaudio.backend")
        m2 = types.ModuleType("torchaudio.backend.common")

        class AudioMetaData:  # noqa: D401 - placeholder type
            pass
        m2.AudioMetaData = AudioMetaData
        m1.common = m2
        sys.modules.setdefault("torchaudio.backend", m1)
        sys.modules.setdefault("torchaudio.backend.common", m2)


def _load_df():
    """DeepFilterNet3, once per process. None if unavailable."""
    global _DF_MODEL, _DF_FAILED
    if _DF_MODEL is not None or _DF_FAILED:
        return _DF_MODEL
    with _DF_LOCK:
        if _DF_MODEL is not None or _DF_FAILED:
            return _DF_MODEL
        try:
            _df_compat()
            import torch
            from df.enhance import enhance, init_df
            from df.model import ModelParams
            from libdf import DF
            model, _state, _ = init_df(STT_DENOISE_MODEL or None, log_level="ERROR",
                                       log_file=None)
            model.eval()
            p = ModelParams()

            def new_state():
                return DF(sr=p.sr, fft_size=p.fft_size, hop_size=p.hop_size,
                          nb_bands=p.nb_erb, min_nb_erb_freqs=p.min_nb_freqs)
            _DF_MODEL = (model, new_state, enhance, torch)
            logger.info(f"🧽 STT denoise ready: DeepFilterNet3 sr={p.sr} "
                        f"device={next(model.parameters()).device}")
        except Exception as e:
            _DF_FAILED = True
            logger.warning(f"STT denoise unavailable ({e}) — STT gets the raw audio "
                           f"(pip install --no-deps deepfilternet deepfilterlib loguru appdirs)")
        return _DF_MODEL


class _SttDenoiser:
    """Streaming DeepFilterNet3 for the STT path, one per call.
    feed(int16 @ sr) -> int16 @ sr, same length, STT_DENOISE_DELAY_MS late."""

    def __init__(self, sample_rate: int):
        loaded = _load_df()
        if loaded is None:
            raise RuntimeError("DeepFilterNet not available")
        self._model, new_state, self._enhance, self._torch = loaded
        self._state = new_state()
        self._sr = sample_rate
        self._up = 48000 // sample_rate
        if self._up * sample_rate != 48000:
            raise ValueError(f"STT denoise needs 8/16/24/48 kHz, not {sample_rate}")
        self._ctx = int(STT_DENOISE_CTX_S * 48000)
        self._d48 = max(0, int(STT_DENOISE_DELAY_MS * 48))
        self._buf = np.zeros(0, dtype=np.float32)
        self._atten = STT_DENOISE_DB if STT_DENOISE_DB > 0 else None
        self.ms = 0.0
        from scipy.signal import resample_poly
        self._rs = resample_poly

    def feed(self, pcm: np.ndarray, apply: bool = True) -> np.ndarray:
        n = len(pcm)
        if n == 0:
            return pcm
        x = self._rs(pcm.astype(np.float32) / 32768.0, self._up, 1).astype(np.float32)
        self._buf = np.concatenate([self._buf, x])[-(self._ctx + len(x) + self._d48):]
        dn = int(self._d48 / self._up)
        self._raw_q = np.concatenate([getattr(self, "_raw_q", np.zeros(dn, dtype=np.int16)),
                                      np.asarray(pcm, dtype=np.int16)])
        raw_out, self._raw_q = self._raw_q[:n], self._raw_q[n:]
        if not apply:
            return raw_out                              # quiet line: raw, same delay
        if not np.any(self._buf[-(len(x) + self._d48):]):
            return np.zeros(n, dtype=np.int16)          # muted / silent: nothing to clean
        t0 = time.monotonic()
        self._state.reset()
        with _DF_LOCK, self._torch.no_grad():
            y = self._enhance(self._model, self._state,
                              self._torch.from_numpy(self._buf[None, :].copy()),
                              pad=True, atten_lim_db=self._atten)[0].numpy()
        end = len(y) - self._d48
        seg = y[max(0, end - len(x)):max(0, end)]
        if len(seg) < len(x):
            seg = np.concatenate([np.zeros(len(x) - len(seg), dtype=np.float32), seg])
        o = self._rs(seg, 1, self._up)
        o = np.clip(o * 32768.0, -32768, 32767).astype(np.int16)
        if len(o) != n:
            o = np.resize(o, n)
        self.ms += (time.monotonic() - t0) * 1000.0
        return o


def preload_models(sample_rate: int = 8000) -> None:
    """Call from the worker prewarm so the first call doesn't pay model load time."""
    _load_ecapa()
    if STT_DENOISE:
        _load_df()
    for maker in (_make_separator, _make_extractor):
        obj = maker(sample_rate)
        if obj is not None:
            try:
                obj.available()
            except Exception as e:
                logger.warning(f"preload failed for {type(obj).__name__}: {e}")


