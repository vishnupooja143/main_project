DIARIZE_BG_SIM      = _f("DIARIZE_BG_SIM", 0.32)
DIARIZE_MIN_BG      = _i("DIARIZE_MIN_BG", 3)          # over-bot pieces needed to use that

# ── [v10 30-Oct] NEAR-FIELD: who is holding the phone ────────────────────────
# The caller's mouth is 2–5 cm from the mic; the people around them are 0.5–3 m
# away, so their voice reaches the phone through the room: every syllable ends in a
# reverb tail and the room fills the short gaps between syllables. Loudness does NOT
# tell them apart (a bystander who shouts is louder than the caller), so the score
# uses only level-free measures, per ~1 s piece (enrollment thread only):
#   * decay: how fast a syllable fades from -6 dB to -18 dB below its peak (dB/s).
#     Dry voice at the phone ~150-170 dB/s, across a room ~90-130 dB/s.
#   * gap fill: how far above the LINE's own noise floor the quiet 10 % of the piece
#     stays. At the phone the gaps fall to the line noise (~0-3 dB above it); across
#     a room the reverb keeps them 15-30 dB above it. Line noise itself does not
#     count (it is the floor), so a noisy line does not make the caller look far.
# High-band "brightness" is NOT used (shouting makes a far voice brighter) and bass
# proximity is too weak at 8 kHz. Score 0 (far) .. 1 (at the phone), per voice the
# median of its pieces. Logged as "near 0.84" for each voice in the DIARIZE line.
#   on:     DIARIZE scores with W_NEAR and without loudness (weights below), learns only
#           the pieces at the phone (NEAR-FIELD CLEAN) and waits on NF_VETO
#   shadow (default): computed and logged; the lock behaves exactly like speaker_lock9.
#           Synthetic tests were mixed (see 30-Oct notes) — real calls decide.
#   off:    not computed
NEARFIELD           = _s("NEARFIELD", "off")
NF_DECAY_LO         = _f("NF_DECAY_LO", 90.0)      # dB/s that scores 0 (reverberant)
NF_DECAY_HI         = _f("NF_DECAY_HI", 170.0)     # dB/s that scores 1 (dry)
NF_GAP_LO           = _f("NF_GAP_LO", 3.0)         # dB above the line floor that scores 1
NF_GAP_HI           = _f("NF_GAP_HI", 20.0)        # dB above the line floor that scores 0
# A voice chosen by behaviour is NOT locked while another voice that ALSO behaves like a
# caller (answers half the bot lines, mostly quiet over the bot) sounds clearly closer to
# the phone (near score higher by NF_VETO): in doubt, wait.
NF_VETO             = _f("NF_VETO", 0.30)
# NEAR-FIELD CLEAN: when a voice's pieces come from two distances (NF_FAR_MIN pieces
# below NF_LO and some at/above NF_HI), only the pieces at/above NF_HI are learned.
NF_HI               = _f("NF_HI", 0.55)
NF_LO               = _f("NF_LO", 0.30)
NF_FAR_MIN          = _i("NF_FAR_MIN", 2)
NF_HI_SHARE         = _f("NF_HI_SHARE", 0.25)
# DIARIZE weights with NEARFIELD=on (re-scaled to add up to 1). Loudness is 0: it
# rewarded the loud bystander. With NEARFIELD shadow/off the old weights are used
